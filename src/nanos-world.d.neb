--- A color composed of components (R, G, B, A) with floating point precision.
@overrideCtor("$class($args)")
declare class Color
    constructor(R: number?, G: number?, B: number?, A: number?)
    --- Red color percentage (0-1)
    R: number
    --- Green color percentage (0-1)
    G: number
    --- Blue color percentage (0-1)
    B: number
    --- Alpha transparency percentage (0-1)
    A: number
    static WHITE: any
    static BLACK: any
    static TRANSPARENT: any
    static RED: any
    static GREEN: any
    static BLUE: any
    static YELLOW: any
    static CYAN: any
    static MAGENTA: any
    static ORANGE: any
    static CHARTREUSE: any
    static AQUAMARINE: any
    static AZURE: any
    static VIOLET: any
    static ROSE: any
    --- Gets the Hexadecimal representation of this Color
    --- @param appends_transparency boolean Appends transparency part
    --- @return string Hexadecimal representation of this Color
    function ToHex(appends_transparency: boolean?): string
    --- Returns a random color from Color Palette
    --- @param includes_black boolean Includes blacks in the scope
    --- @return Color Random color from Color Palette
    static function RandomPalette(includes_black: boolean?): Color
    --- Returns a random color from all color scope
    --- @return Color Random color from all color scope
    static function Random(): Color
    --- Returns the color from 0-255 range values
    --- @param r number Red
    --- @param g number Green
    --- @param b number Blue
    --- @param a number Alpha
    --- @return Color Final Color
    static function FromRGBA(r: number?, g: number?, b: number?, a: number?): Color
    --- Returns a color from the CYMK format
    --- @param c number Cyan
    --- @param y number Yellow
    --- @param m number Magenta
    --- @param k number Black
    --- @param a number Alpha
    --- @return Color Final Color
    static function FromCYMK(c: number?, y: number?, m: number?, k: number?, a: number?): Color
    --- Returns a color from the HSL format
    --- @param h number Hue
    --- @param s number Saturation
    --- @param l number Lightness
    --- @return Color Final Color
    static function FromHSL(h: number?, s: number?, l: number?): Color
    --- Returns a color from the HSV format
    --- @param h number Hue
    --- @param s number Saturation
    --- @param v number Value
    --- @return Color Final Color
    static function FromHSV(h: number?, s: number?, v: number?): Color
    --- Returns a color from the Hexadecimal format
    --- @param hex string Hexadecimal
    --- @return Color Final Color
    static function FromHEX(hex: string): Color
    --- Adds two Colors or a number into each component
    operator + (rhs: Color | number): Color
    --- Subtracts two Colors or a number from each component
    operator - (rhs: Color | number): Color
    --- Multiplies two Colors or a number into each component
    operator * (rhs: Color | number): Color
    --- Divides two Colors or a number from each component
    operator / (rhs: Color | number): Color
    --- Checks if two Colors have the same values
    operator == (rhs: Color): boolean
end

--- A 4x4 transformation Matrix built from a rotation and an origin, which can be used for geometric and positional calculations. This is mainly used internally.
@overrideCtor("$class($args)")
declare class Matrix
    constructor(rotation: Rotator, origin: Vector)
    --- Rotates the Vector by this Matrix rotation (the origin is not applied)
    --- @param vector Vector The Vector to be transformed
    --- @return Vector The new vector
    function TransformVector(vector: Vector): Vector
    --- Returns a new matrix transposed (Wikipedia)
    --- @return Matrix The transposed matrix
    function GetTransposed(): Matrix
end

--- Floating point Quaternion that can represent a rotation about an axis in 3-D space
@overrideCtor("$class($args)")
declare class Quat
    constructor(X: number?, Y: number?, Z: number?, W: number?)
    --- The quaternion's X-component
    X: number
    --- The quaternion's Y-component
    Y: number
    --- The quaternion's Z-component
    Z: number
    --- The quaternion's W-component
    W: number
    --- In place normalize this Quaternion
    --- @param tolerance number Minimum squared size to consider it non-zero
    function Normalize(tolerance: number?): nil
    --- Get the Rotator representation of this Quaternion
    --- @return Rotator Rotator representation of this Quaternion
    function Rotator(): Rotator
    --- Returns the inverse of this Quaternion
    --- @return Quat Inverse of this Quaternion
    function Inverse(): Quat
    --- Rotates a vector by this Quaternion
    --- @param vector Vector Vector to rotate
    --- @return Vector Rotated vector
    function RotateVector(vector: Vector): Vector
    --- Unrotates a vector by this Quaternion
    --- @param vector Vector Vector to unrotate
    --- @return Vector Unrotated vector
    function UnrotateVector(vector: Vector): Vector
    --- Get the forward direction vector from this Quaternion
    --- @return Vector Forward vector
    function GetForwardVector(): Vector
    --- Get the right direction vector from this Quaternion
    --- @return Vector Right vector
    function GetRightVector(): Vector
    --- Get the up direction vector from this Quaternion
    --- @return Vector Up vector
    function GetUpVector(): Vector
    operator + (rhs: Quat | number): Quat
    operator - (rhs: Quat | number): Quat
    operator * (rhs: Quat | number): Quat
end

--- A container for rotation information (Pitch, Yaw, Roll). All rotation values are stored in degrees.
@overrideCtor("$class($args)")
declare class Rotator
    constructor(pitch: number?, yaw: number?, roll: number?)
    --- Rotation around the right axis (around Y axis), Looking up and down (0=Straight Ahead, +Up, -Down)
    Pitch: number
    --- Rotation around the up axis (around Z axis), Running in circles 0=East, +North, -South.
    Yaw: number
    --- Rotation around the forward axis (around X axis), Tilting your head, 0=Straight, +Clockwise, -CCW.
    Roll: number
    --- Checks against another Rotator for equality, within a tolerance
    --- @param other Rotator The Rotator to compare to
    --- @param tolerance number Max difference allowed per axis, in degrees
    --- @return boolean Whether the Rotators are equal
    function Equals(other: Rotator, tolerance: number?): boolean
    --- Get the forward (X) unit direction vector from this component, in world space.
    --- @return Vector the forward direction
    function GetForwardVector(): Vector
    --- Get the right (Y) unit direction vector from this component, in world space.
    --- @return Vector the right direction
    function GetRightVector(): Vector
    --- Get the up (Z) unit direction vector from this component, in world space.
    --- @return Vector the up direction
    function GetUpVector(): Vector
    --- Rotate a vector rotated by this rotator.
    --- @param vector Vector the vector to rotate by the Rotator
    --- @return Vector the rotated vector
    function RotateVector(vector: Vector): Vector
    --- In-place normalize, removes all winding and creates the “shortest route” rotation.
    function Normalize(): nil
    --- Returns the vector rotated by the inverse of this rotator.
    --- @param vector Vector The vector to rotate by the inverse of the Rotator
    --- @return Vector the unrotated vector
    function UnrotateVector(vector: Vector): Vector
    --- Get Rotation as a quaternion.
    --- @return Quat the rotation as a quaternion
    function Quaternion(): Quat
    --- Returns a new Rotator normalized.
    --- @return Rotator the normalized Rotator
    function GetNormalized(): Rotator
    --- Checks whether rotator is near to zero within a specified tolerance
    --- @param tolerance number Tolerance to check
    --- @return boolean whether the rotator is nearly zero
    function IsNearlyZero(tolerance: number?): boolean
    --- Checks whether all components of the rotator are exactly zero
    --- @return boolean whether the rotator is exactly zero
    function IsZero(): boolean
    --- Generates a random rotation, with optional random roll
    --- @param roll boolean Whether to use a random roll in the rotator, otherwise uses 0 for roll
    --- @param min number Minimum value
    --- @param max number Maximum value
    --- @return Rotator the random rotation
    static function Random(roll: boolean?, min: number?, max: number?): Rotator
    operator + (rhs: Rotator | number): Rotator
    operator - (rhs: Rotator | number): Rotator
    operator * (rhs: Rotator | number): Rotator
end

--- A Vector composed of components (X, Y, Z) with floating point precision. Used mainly for entity position.
@overrideCtor("$class($args)")
declare class Vector
    constructor(X: number?, Y: number?, Z: number?)
    --- X Coordinate
    X: number
    --- Y Coordinate
    Y: number
    --- Z Coordinate
    Z: number
    --- Check against another vector for equality, within specified error limits
    --- @param other Vector The vector to compare to
    --- @param tolerance number The error limits
    --- @return boolean Are the vectors equal or not
    function Equals(other: Vector, tolerance: number?): boolean
    --- Distance between two points
    --- @param other Vector The vector to get the distance to
    --- @return number The distance between the vectors
    function Distance(other: Vector): number
    --- Squared distance between two points
    --- @param other Vector The vector to get the squared distance to
    --- @return number The squared distance between the vectors
    function DistanceSquared(other: Vector): number
    --- Calculates normalized version of vector without checking for zero length
    --- @return Vector The unsafe normal
    function GetUnsafeNormal(): Vector
    --- Gets a normalized copy of the vector, checking it is safe to do so based on the length
    --- @param tolerance number Minimum squared size to consider it non-zero
    --- @return Vector The safe normal
    function GetSafeNormal(tolerance: number?): Vector
    --- Efficiently checks whether vector is near to another vector within a specified radius
    --- @param other Vector The vector to compare to
    --- @param radius number The radius to check
    --- @return boolean If the vector is near to the other vector
    function IsNear(other: Vector, radius: number): boolean
    --- Checks whether vector is near to zero within a specified tolerance
    --- @param tolerance number The error limits
    --- @return boolean If the bool is near to zero
    function IsNearlyZero(tolerance: number?): boolean
    --- Checks whether all components of the vector are exactly zero
    --- @return boolean If all components of the vector are exactly zero
    function IsZero(): boolean
    --- Normalize this vector in-place if it is larger than a given tolerance. Leaves it unchanged if not
    --- @param tolerance number Minimum squared size to consider it non-zero
    --- @return boolean If the vector has been modified
    function Normalize(tolerance: number?): boolean
    --- Get the length (magnitude) of this vector
    --- @return number The length of the vector
    function Size(): number
    --- Get the squared length of this vector
    --- @return number The squared length of the vector
    function SizeSquared(): number
    --- Return the Rotator orientation corresponding to the direction in which the vector points
    --- @return Rotator The orientation of the vector
    function ToOrientationRotator(): Rotator
    --- Return the Quaternion orientation corresponding to the direction in which the vector points
    --- @return Quat The orientation of the vector
    function ToOrientationQuat(): Quat
    --- Dot product of two vectors
    --- @param other Vector The vector to dot with
    --- @return number the dot product
    function Dot(other: Vector): number
    --- Cross product of two vectors
    --- @param other Vector The vector to cross with
    --- @return Vector the cross product vector
    function Cross(other: Vector): Vector
    operator + (rhs: Vector | number): Vector
    operator - (rhs: Vector | number): Vector
    operator * (rhs: Vector | number): Vector
    operator / (rhs: Vector | number): Vector
    operator ^ (rhs: Vector | number): Vector
    --- Checks if two Vectors have the same values
    operator == (rhs: Vector): boolean
    --- Negates all components of this Vector
    operator - (): Vector
end

--- A Vector2D composed of components (X, Y) with floating point precision. Used mainly for HUD and Drawing on screen.
@overrideCtor("$class($args)")
declare class Vector2D
    constructor(X: number?, Y: number?)
    --- X Coordinate
    X: number
    --- Y Coordinate
    Y: number
    --- Distance between two points
    --- @param other Vector2D The vector to get the distance to
    --- @return number The distance between the vectors
    function Distance(other: Vector2D): number
    --- Squared distance between two points
    --- @param other Vector2D The vector to get the squared distance to
    --- @return number The squared distance between the vectors
    function DistanceSquared(other: Vector2D): number
    --- Efficiently checks whether vector is near to another vector within a specified radius
    --- @param other Vector2D The vector to compare to
    --- @param radius number The radius to check
    --- @return boolean If the vector is near to the other vector
    function IsNear(other: Vector2D, radius: number): boolean
    --- Get the length (magnitude) of this vector
    --- @return number The length of the vector
    function Size(): number
    --- Get the squared length of this vector
    --- @return number The squared length of the vector
    function SizeSquared(): number
    --- Dot product of two vectors
    --- @param other Vector2D The vector to dot with
    --- @return number the dot product
    function Dot(other: Vector2D): number
    --- Cross product of two vectors
    --- @param other Vector2D The vector to cross with
    --- @return number the cross product
    function Cross(other: Vector2D): number
    --- Linearly interpolates between this vector and another vector
    --- @param other Vector2D The vector to interpolate to
    --- @param alpha number The interpolation alpha, where 0 returns this vector and 1 returns the other vector
    --- @return Vector2D the interpolated vector
    function Lerp(other: Vector2D, alpha: number): Vector2D
    operator + (rhs: Vector2D | number): Vector2D
    operator - (rhs: Vector2D | number): Vector2D
    operator * (rhs: Vector2D | number): Vector2D
    operator / (rhs: Vector2D | number): Vector2D
    --- Checks if two Vector2Ds have the same values
    operator == (rhs: Vector2D): boolean
    --- Negates all components of this Vector2D
    operator - (): Vector2D
end

-- ========================================================================
-- Classes
-- ========================================================================

declare interface EntityBase
    --- Finish the spawning process and send the entity to clients if it was spawned with a deferred `spawn_mode`
    @side(shared)
    method FinishSpawn(): nil
    --- Overrides when this Entity finishes spawning, from the Constructor of an Inherited Class
    --- @param spawn_mode SpawnMode Only `SpawnMode.AfterConstructor` and `SpawnMode.Manual` are accepted
    @side(shared)
    method SetSpawnMode(spawn_mode: SpawnMode): nil
    --- Gets if this Entity finished spawning
    --- @return boolean If the Entity finished spawning
    @side(shared)
    method IsSpawned(): boolean
    --- Gets the universal network ID of this Entity (same on both client and server)
    --- @return number Universal network ID of this Entity
    @side(shared)
    method GetID(): number
    --- Returns true if this Entity is being destroyed
    --- @return boolean Whether this Entity is being destroyed
    @side(shared)
    method IsBeingDestroyed(): boolean
    --- Gets if the local context has authority over this Entity (true if spawned by the client, false if spawned by the server)
    --- @return boolean true if spawned by the client, false if spawned by the server
    @side(client)
    method HasAuthority(): boolean
    --- Gets the class of this entity
    --- @return any Class of this entity
    @side(shared)
    method GetClass(): any
    --- Recursively checks if this entity is inherited from a Class
    --- @param class_ any The Class
    --- @return boolean Whether this entity is of that class or inherits from it
    @side(shared)
    method IsA(class_: any): boolean
    --- Subscribes to an Event on this specific entity
    --- @param event_name string Name of the event to subscribe to
    --- @param callback any Function to call when the event is triggered
    --- @return any Callback that was passed (useful for unsubscribing later if your callback is an anonymous function)
    @side(shared)
    method Subscribe(event_name: string, callback: any): any
    --- Subscribes to a custom event called from server on this specific entity
    --- @param event_name string Name of the event to subscribe to
    --- @param callback any Function to call when the event is triggered
    --- @return any Callback that was passed (useful for unsubscribing later if your callback is an anonymous function)
    @side(shared)
    method SubscribeRemote(event_name: string, callback: any): any
    --- Unsubscribes all callbacks from this Event in this Entity within this Package, or only the callback passed
    --- @param event_name string Name of the event to unsubscribe from
    --- @param callback any Optional callback to unsubscribe
    @side(shared)
    method Unsubscribe(event_name: string, callback: any?): nil
    --- Sets a Value in this Entity
    --- @param key string The key
    --- @param value any The value, can be any serializable type (not functions)
    --- @param sync_on_clients boolean Server side parameter, if enabled will sync this value with all clients
    @side(shared)
    method SetValue(key: string, value: any, sync_on_clients: boolean?): nil
    --- Gets a Value stored on this Entity at the given key
    --- @param key string The key
    --- @param fallback any Fallback value if key doesn't exist
    --- @return any Value at key or fallback if key doesn't exist
    @side(shared)
    method GetValue(key: string, fallback: any): any
    --- Gets a list of all values keys
    --- @return string[] a list with all values keys
    @side(server)
    method GetAllValuesKeys(): string[]
    --- Destroys this Entity
    method Destroy(): nil
    --- Returns true if this Entity is valid (i.e. wasn't destroyed and points to a valid Entity)
    --- @return boolean Whether this Entity is valid
    @side(shared)
    method IsValid(): boolean
    --- Calls a custom remote event directly on this entity to a specific Player
    --- @param event_name string The Event Name to trigger the event
    --- @param player Player The remote player to send this event
    --- @param reliability Reliability The network reliability rule
    --- @param ... any Arguments to pass to the event
    @side(server)
    method CallRemoteEvent(event_name: string, player: Player, reliability: Reliability?, ...: any): nil
    --- Calls a custom remote event directly on this entity to a list of Players
    --- @param event_name string The Event Name to trigger the event
    --- @param players Player[] The remote players to send this event
    --- @param reliability Reliability The network reliability rule
    --- @param ... any Arguments to pass to the event
    @side(server)
    method CallRemotePlayersEvent(event_name: string, players: Player[], reliability: Reliability?, ...: any): nil
    --- Calls a custom remote event directly on this entity
    --- @param event_name string The Event Name to trigger the event
    --- @param reliability Reliability The network reliability rule
    --- @param ... any Arguments to pass to the event
    @side(client)
    method CallRemoteEvent(event_name: string, reliability: Reliability?, ...: any): nil
    --- Calls a custom remote event directly on this entity to all Players
    --- @param event_name string The Event Name to trigger the event
    --- @param reliability Reliability The network reliability rule
    --- @param ... any Arguments to pass to the event
    @side(server)
    method BroadcastRemoteEvent(event_name: string, reliability: Reliability?, ...: any): nil
    --- Calls a custom remote event directly on this entity to all Players in a radius
    --- @param event_name string The Event Name to trigger the event
    --- @param radius number The radius to send this event
    --- @param reliability Reliability The network reliability rule
    --- @param ... any Arguments to pass to the event
    @side(server)
    method BroadcastRemoteInRadiusEvent(event_name: string, radius: number, reliability: Reliability?, ...: any): nil
end

--- Entity is the base for all Classes, and all those entities share the same Methods and Events described in this page.
declare class Entity implements EntityBase
    --- Returns a table containing all Entities of the class this is called on
    --- @return Entity[] Copy of table containing all Entities
    @side(shared)
    static function GetAll(): Entity[]
    --- Returns a specific Entity of this class at an index
    --- @param index number The index of the Entity
    --- @return Entity Entity at index
    @side(shared)
    static function GetByIndex(index: number): Entity
    --- Returns how many Entities of this class exist
    --- @return number Number of Entities of this class
    @side(shared)
    static function GetCount(): number
    --- Returns an iterator with all Entities of this class to be used with `pairs()`
    --- @return any Iterator with all Entities of this class
    @side(shared)
    static function GetPairs(): any
    --- Inherits this class with the Inheriting System
    --- @param name string The name of the new Class
    --- @param custom_values any An optional table with custom values to be set in the inherited class table
    --- @return any The new Class table
    @side(shared)
    static function Inherit(name: string, custom_values: any?): any
    --- Gets a list of all directly inherited classes from this Class created with the Inheriting System
    --- @param recursively boolean Returns all inherited children
    --- @return any[] All children Classes
    @side(shared)
    static function GetInheritedClasses(recursively: boolean?): any[]
    --- Gets the parent class if this Class was created with the Inheriting System
    --- @return any? The parent class
    @side(shared)
    static function GetParentClass(): any?
    --- Gets if this Class is child of another class if this Class was created with the Inheriting System
    --- @param class_ any The other class to check
    --- @return boolean Whether this Class is child of another class if this Class was created with the Inheriting System
    @side(shared)
    static function IsChildOf(class_: any): boolean
    --- Subscribes to an Event for all entities of this Class
    --- @param event_name string Name of the event to subscribe to
    --- @param callback any Function to call when the event is triggered
    --- @return any Callback that was passed (useful for unsubscribing later if your callback is an anonymous function)
    @side(shared)
    static function Subscribe(event_name: string, callback: any): any
    --- Subscribes to a custom event called from server
    --- @param event_name string Name of the event to subscribe to
    --- @param callback any Function to call when the event is triggered
    --- @return any Callback that was passed (useful for unsubscribing later if your callback is an anonymous function)
    @side(shared)
    static function SubscribeRemote(event_name: string, callback: any): any
    --- Unsubscribes all callbacks from this Event in this Class within this Package, or only the callback passed
    --- @param event_name string Name of the event to unsubscribe from
    --- @param callback any Optional callback to unsubscribe
    @side(shared)
    static function Unsubscribe(event_name: string, callback: any?): nil
end

--- An Actor is an object which can be spawned and destroyed through Lua.
--- Actors support 3D transformations such as translation (location), rotation, and scale.
--- 
--- An Actor is the base for several entities, and all those entities share the same Methods and Events described in this page.
declare interface Actor extends EntityBase
    --- Returns the mass of this Actor
    --- @return number Mass of this Actor
    @side(client)
    method GetMass(): number
    --- Returns the angular velocity of this Actor
    --- @return number Angular velocity of this Actor
    @side(client)
    method GetAngularVelocity(): number
    --- Add an impulse to this Actor. Good for one time instant burst
    --- @param impulse Vector Magnitude and direction of impulse to apply
    --- @param velocity_change boolean Whether to ignore mass
    method AddImpulse(impulse: Vector, velocity_change: boolean?): nil
    --- Add an angular impulse to this Actor. Good for one time instant burst
    --- @param angular_impulse Vector Magnitude and direction of impulse to apply. Direction is axis of rotation. In Radians
    --- @param velocity_change boolean Whether to ignore mass
    method AddAngularImpulse(angular_impulse: Vector, velocity_change: boolean?): nil
    --- Attaches this Actor to any other Actor, optionally at a specific bone
    --- @param other Actor Other actor to attach
    --- @param attachment_rule AttachmentRule How to attach
    --- @param bone_name string Which bone to attach to. If empty it will be attached to the Actor, otherwise to the Mesh at the bone/socket
    --- @param lifespan_when_detached number Seconds before destroying this Actor when detached, setting it to 0 will automatically destroy this actor when detached, setting it to 10 will destroy this after 10 seconds when detached
    --- @param use_absolute_rotation boolean Whether to force attached object to use absolute rotation (will not follow parent)
    --- @return boolean if it was attached successfully
    method AttachTo(other: Actor, attachment_rule: AttachmentRule?, bone_name: string?, lifespan_when_detached: number?, use_absolute_rotation: boolean?): boolean
    --- Detaches this Actor from AttachedTo Actor
    method Detach(): nil
    --- Sets this Actor's collision type
    --- @param collision_type CollisionType The new collision type
    method SetCollision(collision_type: CollisionType): nil
    --- Sets this Actor's Dimension. Actors only see and interact with entities in the same Dimension
    --- @param dimension number The new Dimension
    @side(server)
    method SetDimension(dimension: number): nil
    --- Sets this Actor's distance optimization multiplier
    --- @param multiplier number The new distance optimization multiplier
    @side(server)
    method SetDistanceOptimizationMultiplier(multiplier: number): nil
    --- Adds a permanent force to this Actor, set to Vector(0, 0, 0) to cancel
    --- @param force Vector The force to apply every frame
    --- @param is_local boolean Whether to apply the force in local space
    method SetForce(force: Vector, is_local: boolean?): nil
    --- Adds a permanent angular force to this Actor, set to Vector(0, 0, 0) to cancel
    --- @param angular_force Vector The angular force to apply every frame
    method SetAngularForce(angular_force: Vector): nil
    --- Sets whether gravity is enabled on this Actor
    --- @param gravity_enabled boolean Whether gravity is enabled on this Actor
    method SetGravityEnabled(gravity_enabled: boolean): nil
    --- Sets whether the actor is visible or not
    --- @param is_visible boolean Whether the actor is visible or not
    @side(shared)
    method SetVisibility(is_visible: boolean): nil
    --- Gets a Socket Transform in world space given a bone or socket name
    --- @param socket_name string Name of the socket
    --- @param attachable_id string The attachable ID (set with `AddSkeletalMeshAttached` or `AddStaticMeshAttached`) to read the Socket from. Pass empty to read from the main mesh
    --- @return any Socket Transform in world space given a bone or socket name
    @side(client)
    method GetSocketTransform(socket_name: string, attachable_id: string?): any
    --- Sets whether the highlight is enabled on this Actor, and which highlight index to use
    --- @param is_enabled boolean Whether the highlight is enabled
    --- @param index number Index to use (should be `0`, `1` or `2`)
    @side(client)
    method SetHighlightEnabled(is_enabled: boolean, index: number?): nil
    --- Sets whether the outline is enabled on this Actor, and which outline index to use
    --- @param is_enabled boolean Whether the outline is enabled
    --- @param index number Index to use (should be `0`, `1` or `2`)
    @side(client)
    method SetOutlineEnabled(is_enabled: boolean, index: number?): nil
    --- Sets the time (in seconds) before this Actor is destroyed. After this time has passed, the actor will be automatically destroyed.
    --- @param seconds number Seconds before being destroyed
    method SetLifeSpan(seconds: number): nil
    --- Gets the time (in seconds) left before this Actor is destroyed
    --- @return number Seconds before being destroyed
    method GetLifeSpan(): number
    --- Sets this Actor's location in the game world
    --- @param location Vector The new location in the game world
    method SetLocation(location: Vector): nil
    --- Sets this Actor's rotation in the game world
    --- @param rotation Rotator The new rotation in the game world
    method SetRotation(rotation: Rotator): nil
    --- Sets this Actor's relative location in local space (only if this actor is attached)
    --- @param relative_location Vector The new relative location in local space
    method SetRelativeLocation(relative_location: Vector): nil
    --- Sets this Actor's relative rotation in local space (only if this actor is attached)
    --- @param relative_rotation Rotator The new relative rotation in local space
    method SetRelativeRotation(relative_rotation: Rotator): nil
    --- Sets this Actor's scale
    --- @param scale Vector The new scale
    method SetScale(scale: Vector): nil
    --- Sets this Actor's render cull distance
    --- @param max_distance number The new render cull distance
    @side(shared)
    method SetRenderCullDistance(max_distance: number): nil
    --- Sets this Actor's to cast shadows or not
    --- @param cast_shadow boolean The new to cast shadows or not
    @side(shared)
    method SetCastShadow(cast_shadow: boolean): nil
    --- Sets the Player to have network authority over this Actor
    --- @param player Player New player which will assume the Network Authority of this Actor
    @side(server)
    method SetNetworkAuthority(player: Player?): nil
    --- Sets if this Actor will auto distribute the network authority between players
    --- @param auto_distribute boolean If this Actor will be auto network distributed
    @side(server)
    method SetNetworkAuthorityAutoDistributed(auto_distribute: boolean): nil
    --- Smoothly moves this actor to a location over a certain time
    --- @param location Vector The target location
    --- @param time number Time to interpolate from current location to target location
    --- @param exp number Exponent used to smooth interpolation. Use `0` for linear movement
    method TranslateTo(location: Vector, time: number, exp: number?): nil
    --- Smoothly rotates this actor to an angle over a certain time
    --- @param rotation Rotator The target rotation
    --- @param time number Time to interpolate from current location to target location
    --- @param exp number Exponent used to smooth interpolation. Use `0` for linear movement
    method RotateTo(rotation: Rotator, time: number, exp: number?): nil
    --- Returns true if this Actor is visible
    --- @return boolean Whether this Actor is visible
    @side(shared)
    method IsVisible(): boolean
    --- Returns true if gravity is enabled on this Actor
    --- @return boolean Whether gravity is enabled on this Actor
    @side(shared)
    method IsGravityEnabled(): boolean
    --- Returns true if this Actor is in water
    --- @return boolean Whether this Actor is in water
    @side(shared)
    method IsInWater(): boolean
    --- Returns true if this Actor is currently network distributed
    --- @return boolean Whether this Actor is currently network distributed
    @side(shared)
    method IsNetworkDistributed(): boolean
    --- Gets all Actors attached to this Actor
    --- @param recursively boolean Also returns the Actors attached to the attached Actors
    --- @return Actor[] All Actors attached to this Actor
    @side(shared)
    method GetAttachedEntities(recursively: boolean?): Actor[]
    --- Gets the Actor this Actor is attached to
    --- @return Actor? Actor this Actor is attached to
    @side(shared)
    method GetAttachedTo(): Actor?
    --- Gets the bone or socket name this Actor is attached to
    --- @return string The bone or socket name, or an empty string if not attached to a bone
    @side(shared)
    method GetAttachedToSocket(): string
    --- Gets this Actor's bounds, useful to know its size in the world
    --- @return any This Actor's bounds
    @side(client)
    method GetBounds(): any
    --- Gets this Actor's collision type
    --- @return CollisionType This Actor's collision type
    @side(shared)
    method GetCollision(): CollisionType
    --- Gets this Actor's location in the game world
    --- @return Vector This Actor's location in the game world
    @side(shared)
    method GetLocation(): Vector
    --- Gets this Actor's Relative Location if it's attached
    --- @return Vector This Actor's Relative Location if it's attached
    @side(shared)
    method GetRelativeLocation(): Vector
    --- Gets this Actor's Network Authority Player
    --- @return Player? This Actor's Network Authority Player
    @side(server)
    method GetNetworkAuthority(): Player?
    --- Gets this Actor's angle in the game world
    --- @return Rotator This Actor's angle in the game world
    @side(shared)
    method GetRotation(): Rotator
    --- Gets this Actor's Relative Rotation if it's attached
    --- @return Rotator This Actor's Relative Rotation if it's attached
    @side(shared)
    method GetRelativeRotation(): Rotator
    --- Gets this Actor's force (set by `SetForce()`)
    --- @return Vector This Actor's force
    @side(shared)
    method GetForce(): Vector
    --- Gets this Actor's angular force (set by `SetAngularForce()`)
    --- @return Vector This Actor's angular force
    @side(shared)
    method GetAngularForce(): Vector
    --- Gets this Actor's dimension
    --- @return number This Actor's dimension
    @side(shared)
    method GetDimension(): number
    --- Returns true if the local Player is currently the Network Authority of this Actor
    --- @return boolean Whether the local Player is currently the Network Authority of this Actor
    @side(client)
    method HasNetworkAuthority(): boolean
    --- Gets this Actor's scale
    --- @return Vector This Actor's scale
    @side(shared)
    method GetScale(): Vector
    --- Gets this Actor's current velocity
    --- @return Vector This Actor's current velocity
    @side(shared)
    method GetVelocity(): Vector
    --- Adds an Unreal Actor Tag to this Actor
    --- @param tag string The tag to add
    @side(client)
    method AddActorTag(tag: string): nil
    --- Removes an Unreal Actor Tag from this Actor
    --- @param tag string The tag to remove
    @side(client)
    method RemoveActorTag(tag: string): nil
    --- Gets all Unreal Actor Tags on this Actor
    --- @return string[] All Unreal Actor Tags on this Actor
    @side(client)
    method GetActorTags(): string[]
    --- Gets if this Actor was recently rendered on screen
    --- @return boolean Whether this Actor was recently rendered on screen
    @side(client)
    method WasRecentlyRendered(): boolean
    --- Gets the distance of this Actor from the Camera
    --- @return number Distance of this Actor from the Camera
    @side(client)
    method GetDistanceFromCamera(): number
    --- Gets the percentage of this Actor size in the screen
    --- @return number Percentage of this Actor size in the screen
    @side(client)
    method GetScreenPercentage(): number
end

--- Pickables are special Actors which can be grabbed, held and used by Characters.
declare interface Pickable extends EntityBase, Actor, Paintable
    --- Attaches a Skeletal Mesh as master pose to this entity
    --- @param id string Used further for removing or applying material settings on it
    --- @param skeletal_mesh_path string Path to SkeletalMesh asset to attach
    --- @param socket string Bone socket to attach to
    --- @param relative_location Vector Relative location
    --- @param relative_rotation Rotator Relative rotation
    --- @param use_parent_bounds boolean If true, this component uses its parents bounds when attached. This can be a significant optimization with many components attached together
    --- @param use_base_leader_pose_component boolean If true, this component will use the base leader pose component for copying its animation
    --- @param animation_path string Path to Animation asset to play on the Skeletal Mesh attached
    --- @param attachable_id string Optionally attaches this to another attached skeletal mesh (instead of attaching to the root component)
    @side(shared)
    method AddSkeletalMeshAttached(id: string, skeletal_mesh_path: string, socket: string?, relative_location: Vector?, relative_rotation: Rotator?, use_parent_bounds: boolean?, use_base_leader_pose_component: boolean?, animation_path: string?, attachable_id: string?): nil
    --- Attaches a Static Mesh to this entity
    --- @param id string Unique ID to assign to the StaticMesh
    --- @param static_mesh_path string Path to StaticMesh asset to attach
    --- @param socket string Bone socket to attach to
    --- @param relative_location Vector Relative location
    --- @param relative_rotation Rotator Relative rotation
    --- @param use_parent_bounds boolean If true, this component uses its parents bounds when attached. This can be a significant optimization with many components attached together
    --- @param attachable_id string Optionally attaches this to another attached static mesh (instead of attaching to the root component)
    @side(shared)
    method AddStaticMeshAttached(id: string, static_mesh_path: string, socket: string?, relative_location: Vector?, relative_rotation: Rotator?, use_parent_bounds: boolean?, attachable_id: string?): nil
    --- Gets all Static Meshes attached to this entity
    --- @return string[] the key as the Attached ID, and the value as the Asset Path
    @side(shared)
    method GetAllStaticMeshAttached(): string[]
    --- Gets all Skeletal Meshes attached to this entity
    --- @return string[] the key as the Attached ID, and the value as the Asset Path
    @side(shared)
    method GetAllSkeletalMeshAttached(): string[]
    --- Removes, if it exists, a SkeletalMesh from this Pickable given its custom ID
    --- @param id string Unique ID of the SkeletalMesh to remove
    @side(shared)
    method RemoveSkeletalMeshAttached(id: string): nil
    --- Sets a Static Mesh Attached location and rotation
    --- @param id string Unique ID of the StaticMesh set with AddStaticMeshAttached
    --- @param relative_location Vector New relative location
    --- @param relative_rotation Rotator New relative rotation
    @side(shared)
    method SetStaticMeshAttachedTransform(id: string, relative_location: Vector, relative_rotation: Rotator): nil
    --- Removes, if it exists, a StaticMesh from this Pickable given its custom ID
    --- @param id string Unique ID of the StaticMesh to remove
    @side(shared)
    method RemoveStaticMeshAttached(id: string): nil
    --- Removes all StaticMeshes attached
    @side(shared)
    method RemoveAllStaticMeshesAttached(): nil
    --- Removes all SkeletalMeshes attached
    @side(shared)
    method RemoveAllSkeletalMeshesAttached(): nil
    --- Pulls the usage of this Pickable (will start firing if this is a weapon)
    --- @param release_use_after number Time in seconds to automatically release the usage (-1 will not release, 0 will release one tick after)
    @side(server)
    method PullUse(release_use_after: number?): nil
    --- Releases the usage of this Pickable (will stop firing if this is a weapon)
    @side(server)
    method ReleaseUse(): nil
    --- Sets the Attachment Settings for this Pickable (how it attaches to the Character when Picking up)
    --- @param relative_location Vector Location relative to the Socket
    --- @param relative_rotation Rotator Rotation relative to the Socket
    --- @param socket string Character Socket to attach to when picked up
    @side(server)
    method SetAttachmentSettings(relative_location: Vector, relative_rotation: Rotator?, socket: string?): nil
    --- Sets the crosshair material for this Pickable
    --- @param material_asset string Asset path to the crosshair material
    @side(server)
    method SetCrosshairMaterial(material_asset: string): nil
    --- Sets if this Pickable can be picked up from ground by the player
    --- @param is_pickable boolean Whether this Pickable can be picked up from ground by the player
    @side(server)
    method SetPickable(is_pickable: boolean): nil
    --- Sets if this Pickable can be used by the player when held
    --- @param can_use boolean Whether this Pickable can be used by the player when held
    @side(server)
    method SetCanUse(can_use: boolean): nil
    --- Gets the name of the asset this Pickable uses
    --- @return string Name of the asset this Pickable uses
    @side(shared)
    method GetMesh(): string
    --- Gets the Character, if it exists, that's holding this Pickable
    --- @return Character? Character, if it exists, that's holding this Pickable
    @side(shared)
    method GetHandler(): Character?
    --- Gets the Handling Mode of this Pickable
    --- @return HandlingMode Handling Mode of this Pickable
    @side(shared)
    method GetHandlingMode(): HandlingMode
    --- Sets the Buoyancy Pontoons used by the Water simulation
    --- @param pontoons any Array with the Pontoons, or nil to restore the automatically calculated ones
    method SetBuoyancyPontoons(pontoons: any?): nil
    --- Sets how this entity behaves on Water
    --- @param enabled boolean Whether Buoyancy forces are applied at all
    --- @param buoyancy_coefficient number How much it floats, the higher the more
    --- @param buoyancy_damp number First order damping on the vertical velocity, reduces bobbing
    --- @param max_buoyant_force number Clamp on the upwards force, stops light objects being launched out of the water
    method SetBuoyancySettings(enabled: boolean?, buoyancy_coefficient: number?, buoyancy_damp: number?, max_buoyant_force: number?): nil
end

--- Base class for all Paintable entities. This class provides customization for materials, exposing common functions to allow you to set custom material parameters, including loading textures from disk.
declare interface Paintable extends EntityBase, Actor
    --- Sets the material at the specified index of this Actor
    --- @param material_path string The new Material to apply. Note: depending on the entity you are applying, the material needs to be configured to be "Used with Skeletal Mesh" or "Used with Particles", etc. in the material settings, otherwise it may not be applied correctly
    --- @param index number The material index to apply (`-1` means all indices)
    --- @param attachable_id string The attachable ID (set with `AddSkeletalMeshAttached` or `AddStaticMeshAttached`) to apply the material. Pass empty to set on main mesh only
    @side(shared)
    method SetMaterial(material_path: string, index: number?, attachable_id: string?): nil
    --- Sets the material at the specified index of this Actor to a Canvas object
    --- @param canvas Canvas The Canvas object to use as a material
    --- @param index number The material index to apply (`-1` means all indices)
    @side(client)
    method SetMaterialFromCanvas(canvas: Canvas, index: number?): nil
    --- Sets the material at the specified index of this Actor to a SceneCapture object
    --- @param scene_capture SceneCapture The SceneCapture object to use as a material
    --- @param index number The material index to apply (`-1` means all indices)
    @side(client)
    method SetMaterialFromSceneCapture(scene_capture: SceneCapture, index: number?): nil
    --- Sets the material at the specified index of this Actor to a WebUI object
    --- @param webui WebUI The WebUI object to use as a material
    --- @param index number The material index to apply (`-1` means all indices)
    @side(client)
    method SetMaterialFromWebUI(webui: WebUI, index: number?): nil
    --- Resets the material from the specified index to the original one
    --- @param index number The material index to apply (`-1` means all indices)
    --- @param attachable_id string The attachable ID (set with `AddSkeletalMeshAttached` or `AddStaticMeshAttached`) to reset the material. Pass empty to reset on main mesh only
    @side(shared)
    method ResetMaterial(index: number?, attachable_id: string?): nil
    --- Sets a Color parameter in this Actor's material
    --- @param parameter_name string The name of the material parameter
    --- @param color Color The value to set
    --- @param index number The material index to apply (`-1` means all indices)
    --- @param attachable_id string The attachable ID (set with `AddSkeletalMeshAttached` or `AddStaticMeshAttached`) to apply the material parameter. Pass empty to set on main mesh only
    @side(shared)
    method SetMaterialColorParameter(parameter_name: string, color: Color, index: number?, attachable_id: string?): nil
    --- Sets a Scalar parameter in this Actor's material
    --- @param parameter_name string The name of the material parameter
    --- @param scalar number The value to set
    --- @param index number The material index to apply (`-1` means all indices)
    --- @param attachable_id string The attachable ID (set with `AddSkeletalMeshAttached` or `AddStaticMeshAttached`) to apply the material parameter. Pass empty to set on main mesh only
    @side(shared)
    method SetMaterialScalarParameter(parameter_name: string, scalar: number, index: number?, attachable_id: string?): nil
    --- Sets a texture parameter in this Actor's material to an image
    --- @param parameter_name string The name of the material parameter
    --- @param texture_path string The path to texture, a url or a base64
    --- @param index number The material index to apply (`-1` means all indices)
    --- @param attachable_id string The attachable ID (set with `AddSkeletalMeshAttached` or `AddStaticMeshAttached`) to apply the material parameter. Pass empty to set on main mesh only
    @side(shared)
    method SetMaterialTextureParameter(parameter_name: string, texture_path: string, index: number?, attachable_id: string?): nil
    --- Sets a Vector parameter in this Actor's material
    --- @param parameter_name string The name of the material parameter
    --- @param vector Vector The value to set
    --- @param index number The material index to apply (`-1` means all indices)
    --- @param attachable_id string The attachable ID (set with `AddSkeletalMeshAttached` or `AddStaticMeshAttached`) to apply the material parameter. Pass empty to set on main mesh only
    @side(shared)
    method SetMaterialVectorParameter(parameter_name: string, vector: Vector, index: number?, attachable_id: string?): nil
    --- Gets a Color parameter from this Actor's material
    --- @param parameter_name string The name of the material parameter
    --- @param index number The material index to get
    --- @param attachable_id string The attachable ID (set with `AddSkeletalMeshAttached` or `AddStaticMeshAttached`) to get the material parameter. Pass empty to get from main mesh only
    --- @return Color or nil if parameter was not found
    @side(shared)
    method GetMaterialColorParameter(parameter_name: string, index: number?, attachable_id: string?): Color
    --- Gets a Vector parameter from this Actor's material
    --- @param parameter_name string The name of the material parameter
    --- @param index number The material index to get
    --- @param attachable_id string The attachable ID (set with `AddSkeletalMeshAttached` or `AddStaticMeshAttached`) to get the material parameter. Pass empty to get from main mesh only
    --- @return Vector or nil if parameter was not found
    @side(shared)
    method GetMaterialVectorParameter(parameter_name: string, index: number?, attachable_id: string?): Vector
    --- Gets a Texture parameter from this Actor's material
    --- @param parameter_name string The name of the material parameter
    --- @param index number The material index to get
    --- @param attachable_id string The attachable ID (set with `AddSkeletalMeshAttached` or `AddStaticMeshAttached`) to get the material parameter. Pass empty to get from main mesh only
    --- @return string or nil if parameter was not found
    @side(shared)
    method GetMaterialTextureParameter(parameter_name: string, index: number?, attachable_id: string?): string
    --- Gets a Scalar parameter from this Actor's material
    --- @param parameter_name string The name of the material parameter
    --- @param index number The material index to get
    --- @param attachable_id string The attachable ID (set with `AddSkeletalMeshAttached` or `AddStaticMeshAttached`) to get the material parameter. Pass empty to get from main mesh only
    --- @return number or nil if parameter was not found
    @side(shared)
    method GetMaterialScalarParameter(parameter_name: string, index: number?, attachable_id: string?): number
    --- Overrides this Actor's Physical Material with a new one
    --- @param physical_material_path string The Physical Material to override
    @side(shared)
    method SetPhysicalMaterial(physical_material_path: string): nil
end

--- Base class for all Damageable entities. It provides Health and Damage related methods and events.
declare interface Damageable extends EntityBase, Actor
    --- Do damage to this entity
    --- @param damage number Amount of damage
    --- @param bone_name string Name of the bone or socket
    --- @param damage_type DamageType Type of the damage, used for effects and in the damage events
    --- @param from_direction Vector Direction the damage came from
    --- @param instigator Player The player which caused the damage
    --- @param causer any The object which caused the damage
    --- @return number the damage applied
    @side(server)
    method ApplyDamage(damage: number, bone_name: string?, damage_type: DamageType?, from_direction: Vector?, instigator: Player?, causer: any?): number
    --- Gets the current health
    --- @return number Current health
    @side(shared)
    method GetHealth(): number
    --- Gets the Max Health
    --- @return number Max Health
    @side(shared)
    method GetMaxHealth(): number
    --- Returns if the entity is dead
    --- @return boolean Whether the entity is dead
    @side(shared)
    method IsDead(): boolean
    --- Respawns the Entity, filling its Health and moving it to its Initial Location
    --- @param location Vector If not passed will use the initial location passed when the Entity spawned
    --- @param rotation Rotator Rotation to respawn with
    @side(server)
    method Respawn(location: Vector?, rotation: Rotator?): nil
    --- Sets the Health of this Entity
    --- @param new_health number The new Health of this Entity
    @side(server)
    method SetHealth(new_health: number): nil
    --- Sets the MaxHealth of this Entity
    --- @param max_health number The new MaxHealth of this Entity
    @side(server)
    method SetMaxHealth(max_health: number): nil
    --- Changes how much damage this entity takes on specific bones
    --- @param bone_name string Name of the bone or socket
    --- @param multiplier number Damage multiplier for that bone, 1 is the default
    @side(server)
    method SetDamageMultiplier(bone_name: string, multiplier: number): nil
    --- Gets the Damage Multiplier of a bone
    --- @param bone_name string Name of the bone or socket
    --- @return number the damage multiplier of the bone
    @side(shared)
    method GetDamageMultiplier(bone_name: string): number
end

--- Base class for all Vehicle entities.
declare interface Vehicle extends EntityBase, Actor, Paintable, Damageable
    --- Attaches a Skeletal Mesh as master pose to this entity
    --- @param id string Used further for removing or applying material settings on it
    --- @param skeletal_mesh_path string Path to SkeletalMesh asset to attach
    --- @param socket string Bone socket to attach to
    --- @param relative_location Vector Relative location
    --- @param relative_rotation Rotator Relative rotation
    --- @param use_parent_bounds boolean If true, this component uses its parents bounds when attached. This can be a significant optimization with many components attached together
    --- @param use_base_leader_pose_component boolean If true, this component will use the base leader pose component for copying its animation
    --- @param animation_path string Path to Animation asset to play on the Skeletal Mesh attached
    --- @param attachable_id string Optionally attaches this to another attached skeletal mesh (instead of attaching to the root component)
    @side(shared)
    method AddSkeletalMeshAttached(id: string, skeletal_mesh_path: string, socket: string?, relative_location: Vector?, relative_rotation: Rotator?, use_parent_bounds: boolean?, use_base_leader_pose_component: boolean?, animation_path: string?, attachable_id: string?): nil
    --- Attaches a Static Mesh to this entity
    --- @param id string Unique ID to assign to the StaticMesh
    --- @param static_mesh_path string Path to StaticMesh asset to attach
    --- @param socket string Bone socket to attach to
    --- @param relative_location Vector Relative location
    --- @param relative_rotation Rotator Relative rotation
    --- @param use_parent_bounds boolean If true, this component uses its parents bounds when attached. This can be a significant optimization with many components attached together
    --- @param attachable_id string Optionally attaches this to another attached static mesh (instead of attaching to the root component)
    @side(shared)
    method AddStaticMeshAttached(id: string, static_mesh_path: string, socket: string?, relative_location: Vector?, relative_rotation: Rotator?, use_parent_bounds: boolean?, attachable_id: string?): nil
    --- Gets all Static Meshes attached to this entity
    --- @return string[] the key as the Attached ID, and the value as the Asset Path
    @side(shared)
    method GetAllStaticMeshAttached(): string[]
    --- Gets all Skeletal Meshes attached to this entity
    --- @return string[] the key as the Attached ID, and the value as the Asset Path
    @side(shared)
    method GetAllSkeletalMeshAttached(): string[]
    --- Removes, if it exists, a SkeletalMesh from this Vehicle given its custom ID
    --- @param id string Unique ID of the SkeletalMesh to remove
    @side(shared)
    method RemoveSkeletalMeshAttached(id: string): nil
    --- Sets a Static Mesh Attached location and rotation
    --- @param id string Unique ID of the StaticMesh set with AddStaticMeshAttached
    --- @param relative_location Vector New relative location
    --- @param relative_rotation Rotator New relative rotation
    @side(shared)
    method SetStaticMeshAttachedTransform(id: string, relative_location: Vector, relative_rotation: Rotator): nil
    --- Removes, if it exists, a StaticMesh from this Vehicle given its custom ID
    --- @param id string Unique ID of the StaticMesh to remove
    @side(shared)
    method RemoveStaticMeshAttached(id: string): nil
    --- Removes all StaticMeshes attached
    @side(shared)
    method RemoveAllStaticMeshesAttached(): nil
    --- Removes all SkeletalMeshes attached
    @side(shared)
    method RemoveAllSkeletalMeshesAttached(): nil
    --- Hides a bone of this Vehicle
    --- @param bone_name string Bone to hide
    @side(shared)
    method HideBone(bone_name: string): nil
    --- UnHide a bone of this Vehicle
    --- @param bone_name string Bone to unhide
    @side(shared)
    method UnHideBone(bone_name: string): nil
    --- Gets if a bone is hidden
    --- @param bone_name string Bone to check
    --- @return boolean if the bone is hidden
    @side(shared)
    method IsBoneHidden(bone_name: string): boolean
    --- Adds a Door to the Vehicle
    --- @param seat_index number Index of the seat, 0 is the driver
    --- @param offset_location Vector Location of the door trigger relative to the vehicle
    --- @param seat_location Vector Location of the seat relative to the vehicle
    --- @param seat_rotation Rotator Rotation of the seat relative to the vehicle
    --- @param trigger_radius number Radius of the trigger used to enter through this door
    --- @param leave_lateral_offset number It's where the Character will be ejected when leaving it (e.g. -150 for left door or 150 for right door)
    @side(server)
    method SetDoor(seat_index: number, offset_location: Vector, seat_location: Vector, seat_rotation: Rotator, trigger_radius: number, leave_lateral_offset: number): nil
    --- Plays an Animation on this Vehicle
    --- @param animation_path string The Animation asset to play
    --- @param slot_name string The Animation Slot to play it on
    --- @param loop_indefinitely boolean This parameter is only used if the Vehicle has an Animation Blueprint
    --- @param blend_in_time number This parameter is only used if the Vehicle has an Animation Blueprint
    --- @param blend_out_time number This parameter is only used if the Vehicle has an Animation Blueprint
    --- @param play_rate number This parameter is only used if the Vehicle has an Animation Blueprint
    --- @param stop_all_montages boolean Stops all running Montages from the same Group. This parameter is only used if the Vehicle has an Animation Blueprint
    @side(shared)
    method PlayAnimation(animation_path: string, slot_name: string?, loop_indefinitely: boolean?, blend_in_time: number?, blend_out_time: number?, play_rate: number?, stop_all_montages: boolean?): nil
    --- Stops an Animation Montage on this Vehicle
    --- @param animation_asset string Leave empty to stop all Montages
    @side(shared)
    method StopAnimation(animation_asset: string?): nil
    --- Gets the Asset name
    --- @return string asset path
    @side(shared)
    method GetMesh(): string
    --- Gets all configured Doors
    --- @return any All configured Doors
    @side(shared)
    method GetDoors(): any
    --- Gets a passenger from a seat
    --- @param seat number Index of the seat, 0 is the driver
    --- @return Character or nil if no passenger in seat
    @side(shared)
    method GetPassenger(seat: number): Character
    --- Gets all passengers
    --- @return Character[] All passengers
    @side(shared)
    method GetPassengers(): Character[]
    --- Configures the Explosion Settings when health reaches zero
    --- @param engine_relative_location Vector Relative location of the Engine. Used to apply particles and effects.
    --- @param materials_index_burnt_override any List of material indexes to override to burnt when exploded. Leave it empty for all indexes.
    --- @param materials_index_burnt_invisible any List of material indexes to override to invisible when exploded. Leave it empty for all indexes.
    @side(server)
    method SetExplosionSettings(engine_relative_location: Vector, materials_index_burnt_override: any, materials_index_burnt_invisible: any): nil
    --- Checks if the engine is started
    --- @return boolean Whether the engine is started
    @side(shared)
    method IsEngineStarted(): boolean
    --- Sets how far the camera stays from this Vehicle while driving it
    --- @param arm_length number The distance in centimeters, or 0 to use the Player's own value
    method SetCameraArmLength(arm_length: number): nil
    --- Sets the Vehicle Camera Offset
    --- @param offset Vector The new Vehicle Camera Offset
    @side(shared)
    method SetCameraOffset(offset: Vector): nil
    --- Sets an Animation Blueprint Property/Variable value directly
    --- @param property_name string Name of the Animation Blueprint variable
    --- @param value any The value to set
    @side(client)
    method SetAnimationBlueprintPropertyValue(property_name: string, value: any): nil
    --- Gets an Animation Blueprint Property/Variable value directly
    --- @param property_name string Name of the Animation Blueprint variable
    --- @return any the property value
    @side(client)
    method GetAnimationBlueprintPropertyValue(property_name: string): any
    --- Calls an Animation Blueprint Event or Function
    --- @param event_name string Event or Function name
    --- @param ... any Sequence of arguments to pass to the event
    --- @return any the function return values
    @side(shared)
    method CallAnimationBlueprintEvent(event_name: string, ...: any): any
    --- Assigns and Binds an Animation Blueprint Event Dispatcher
    --- @param dispatcher_name string Event Dispatcher name
    --- @param callback any Callback function to call
    --- @return any the callback itself
    @side(client)
    method BindAnimationBlueprintEventDispatcher(dispatcher_name: string, callback: any): any
    --- Unbinds an Animation Blueprint Event Dispatcher
    --- @param dispatcher_name string Event Dispatcher name
    --- @param callback any Optional callback to unbind
    @side(client)
    method UnbindAnimationBlueprintEventDispatcher(dispatcher_name: string, callback: any?): nil
    --- Sets the Buoyancy Pontoons used by the Water simulation
    --- @param pontoons any Array with the Pontoons, or nil to restore the automatically calculated ones
    method SetBuoyancyPontoons(pontoons: any?): nil
    --- Sets how this entity behaves on Water
    --- @param enabled boolean Whether Buoyancy forces are applied at all
    --- @param buoyancy_coefficient number How much it floats, the higher the more
    --- @param buoyancy_damp number First order damping on the vertical velocity, reduces bobbing
    --- @param max_buoyant_force number Clamp on the upwards force, stops light objects being launched out of the water
    method SetBuoyancySettings(enabled: boolean?, buoyancy_coefficient: number?, buoyancy_damp: number?, max_buoyant_force: number?): nil
end

--- Base class for all Pawn entities (Character and CharacterSimple).
declare interface Pawn extends EntityBase, Actor, Paintable, Damageable
    --- Attaches a Skeletal Mesh as master pose to this entity
    --- @param id string Used further for removing or applying material settings on it
    --- @param skeletal_mesh_path string Path to SkeletalMesh asset to attach
    --- @param socket string Bone socket to attach to. Pass empty string to attach to the root component (i.e. Capsule). Pass 'root' to attach to the root bone of the main skeletal mesh component
    --- @param relative_location Vector Relative location
    --- @param relative_rotation Rotator Relative rotation
    --- @param use_parent_bounds boolean If true, this component uses its parents bounds when attached. This can be a significant optimization with many components attached together
    --- @param use_base_leader_pose_component boolean If true, this component will use the base leader pose component for copying its animation
    --- @param animation_path string Path to Animation asset to play on the Skeletal Mesh attached
    --- @param attachable_id string Optionally attaches this to another attached skeletal mesh (instead of attaching to the root component)
    @side(shared)
    method AddSkeletalMeshAttached(id: string, skeletal_mesh_path: string, socket: string?, relative_location: Vector?, relative_rotation: Rotator?, use_parent_bounds: boolean?, use_base_leader_pose_component: boolean?, animation_path: string?, attachable_id: string?): nil
    --- Attaches a Static Mesh to this entity
    --- @param id string Unique ID to assign to the StaticMesh
    --- @param static_mesh_path string Path to StaticMesh asset to attach
    --- @param socket string Bone socket to attach to
    --- @param relative_location Vector Relative location
    --- @param relative_rotation Rotator Relative rotation
    --- @param use_parent_bounds boolean If true, this component uses its parents bounds when attached. This can be a significant optimization with many components attached together
    --- @param attachable_id string Optionally attaches this to another attached static mesh (instead of attaching to the root component)
    @side(shared)
    method AddStaticMeshAttached(id: string, static_mesh_path: string, socket: string?, relative_location: Vector?, relative_rotation: Rotator?, use_parent_bounds: boolean?, attachable_id: string?): nil
    --- Gets all Static Meshes attached to this entity
    --- @return string[] the key as the Attached ID, and the value as the Asset Path
    @side(shared)
    method GetAllStaticMeshAttached(): string[]
    --- Gets all Skeletal Meshes attached to this entity
    --- @return string[] the key as the Attached ID, and the value as the Asset Path
    @side(shared)
    method GetAllSkeletalMeshAttached(): string[]
    --- Removes, if it exists, a SkeletalMesh from this entity given its custom ID
    --- @param id string Unique ID of the SkeletalMesh to remove
    @side(shared)
    method RemoveSkeletalMeshAttached(id: string): nil
    --- Sets a Static Mesh Attached location and rotation
    --- @param id string Unique ID of the StaticMesh set with AddStaticMeshAttached
    --- @param relative_location Vector New relative location
    --- @param relative_rotation Rotator New relative rotation
    @side(shared)
    method SetStaticMeshAttachedTransform(id: string, relative_location: Vector, relative_rotation: Rotator): nil
    --- Removes, if it exists, a StaticMesh from this entity given its custom ID
    --- @param id string Unique ID of the StaticMesh to remove
    @side(shared)
    method RemoveStaticMeshAttached(id: string): nil
    --- Removes all StaticMeshes attached
    @side(shared)
    method RemoveAllStaticMeshesAttached(): nil
    --- Removes all SkeletalMeshes attached
    @side(shared)
    method RemoveAllSkeletalMeshesAttached(): nil
    --- Stops an Animation Montage on this character
    --- @param animation_asset string The Animation asset to stop
    @side(shared)
    method StopAnimation(animation_asset: string): nil
    --- Gets the base Mesh Asset
    --- @return string Base Mesh Asset
    @side(shared)
    method GetMesh(): string
    --- Enables or disables the Flying Mode, which removes gravity and allows moving in all directions
    --- @param flying_mode boolean Whether the Flying Mode is enabled
    @side(server)
    method SetFlyingMode(flying_mode: boolean): nil
    --- Gets if it's in Flying mode
    --- @return boolean Whether it's in Flying mode
    @side(shared)
    method GetFlyingMode(): boolean
    --- Gets the Moving To location
    --- @return Vector the moving to location or Vector(0, 0, 0) if not moving
    @side(shared)
    method GetMovingTo(): Vector
    --- AI: Configures the RVO (Reciprocal Velocity Obstacles) Avoidance system used by the AIs when moving
    --- @param enabled boolean Whether to enable the RVO Avoidance
    --- @param avoidance_consideration_radius number The radius of the circle used to determine the avoidance distance
    method SetAIAvoidanceSettings(enabled: boolean, avoidance_consideration_radius: number?): nil
    --- AI: Makes this Pawn walk to the Location
    --- @param location Vector The destination
    --- @param acceptance_radius number Distance from the destination considered as arrived
    method MoveTo(location: Vector, acceptance_radius: number?): nil
    --- AI: Makes this Pawn follow another actor
    --- @param actor Actor Actor to follow
    --- @param acceptance_radius number Radius to consider success
    --- @param stop_on_succeed boolean Whether to stop when reaching the target
    --- @param stop_on_fail boolean Whether to stop when failed to reach the target
    --- @param update_rate number How often to recalculate the AI path
    method Follow(actor: Actor, acceptance_radius: number?, stop_on_succeed: boolean?, stop_on_fail: boolean?, update_rate: number?): nil
    --- AI: Stops the movement, optionally zeroing the velocity as well
    --- @param stops_velocity boolean Also stops the Pawn's current velocity
    method StopMovement(stops_velocity: boolean?): nil
    --- Gets the possessing Player
    --- @return Player? Possessing Player
    @side(shared)
    method GetPlayer(): Player?
    --- Gets the Control Rotation, which is where this Pawn is looking or aiming
    --- @return Rotator Control Rotation
    @side(shared)
    method GetControlRotation(): Rotator
    --- Sets the Control Rotation, which is where this Pawn is looking or aiming
    --- @param control_rotation Rotator The new Control Rotation
    method SetControlRotation(control_rotation: Rotator): nil
    --- Sets if the character will react to damage by applying small dynamic ragdoll effect to local bones damaged
    --- @param is_enabled boolean Whether the character will react to damage by applying small dynamic ragdoll effect to local bones damaged
    @side(server)
    method SetHitReactionEnabled(is_enabled: boolean): nil
    --- Sets if the character will enter ragdoll mode when it dies. You can set it to false to apply custom Death animations
    --- @param is_enabled boolean Whether the character will enter ragdoll mode when it dies. You can set it to false to apply custom Death animations
    @side(server)
    method SetRagdollOnDeathEnabled(is_enabled: boolean): nil
    --- Hides a bone of this Pawn
    --- @param bone_name string Bone to hide
    @side(shared)
    method HideBone(bone_name: string?): nil
    --- Unhides a bone of this Pawn
    --- @param bone_name string Bone to unhide
    @side(shared)
    method UnHideBone(bone_name: string): nil
    --- Gets if a bone is hidden
    --- @param bone_name string Bone to check
    --- @return boolean if the bone is hidden
    @side(shared)
    method IsBoneHidden(bone_name: string): boolean
    --- Triggers this Pawn to jump
    method Jump(): nil
    --- Sets the velocity of the jump
    --- @param jump_z_velocity number Default is 420
    method SetJumpZVelocity(jump_z_velocity: number): nil
    --- Gets the initial vertical velocity when jumping, which defines the jump height
    --- @return number Jump Z Velocity
    @side(shared)
    method GetJumpZVelocity(): number
    --- Sets this Pawn's Capsule size
    --- @param radius number Pass 0 to auto calculate the radius based on the mesh bounds
    --- @param half_height number Pass 0 to auto calculate the half height based on the mesh bounds
    --- @param crouched_half_height number Pass 0 to auto calculate the crouched half height based on the mesh bounds
    method SetCapsuleSize(radius: number?, half_height: number?, crouched_half_height: number?): nil
    --- Gets the Capsule Size
    --- @return any Capsule Size
    @side(shared)
    method GetCapsuleSize(): any
    --- Configures the mesh attachment settings and visibility
    --- @param relative_location Vector Location of the mesh relative to the capsule
    --- @param relative_rotation Rotator Rotation of the mesh relative to the capsule
    --- @param is_visible boolean Whether the mesh is visible (useful for using retargeters using child meshes)
    method SetMeshSettings(relative_location: Vector?, relative_rotation: Rotator?, is_visible: boolean?): nil
    --- Changes the Gravity Scale
    --- @param gravity_scale number The new Gravity Scale
    method SetGravityScale(gravity_scale: number): nil
    --- Gets the gravity scale
    --- @return number Gravity scale
    @side(shared)
    method GetGravityScale(): number
    --- Sets if this Pawn is allowed to Jump
    --- @param can_jump boolean Whether this Pawn is allowed to Jump
    method SetCanJump(can_jump: boolean): nil
    --- Sets if this Pawn is allowed to Crouch
    --- @param can_crouch boolean Whether this Pawn is allowed to Crouch
    method SetCanCrouch(can_crouch: boolean): nil
    --- Gets if this Pawn is allowed to Crouch
    --- @return boolean Whether this Pawn is allowed to Crouch
    @side(shared)
    method GetCanCrouch(): boolean
    --- Gets if this Pawn is allowed to Jump
    --- @return boolean Whether this Pawn is allowed to Jump
    @side(shared)
    method GetCanJump(): boolean
    --- Sets the Movement Braking Settings of this Pawn
    --- @param ground_friction number Friction applied when walking on the ground
    --- @param braking_friction_factor number Multiplier of the friction applied when braking
    --- @param braking_walking number Deceleration when walking without input
    --- @param braking_flying number Deceleration when flying without input
    --- @param braking_swimming number Deceleration when swimming without input
    --- @param braking_falling number Horizontal deceleration when falling without input
    method SetBrakingSettings(ground_friction: number?, braking_friction_factor: number?, braking_walking: number?, braking_flying: number?, braking_swimming: number?, braking_falling: number?): nil
end

--- A Billboard is a 2D Material that will be rendered always facing the camera.
@overrideCtor("$class($args)")
@side(client)
declare class Billboard extends Entity implements Actor, Paintable
    constructor(location: Vector, material_asset: string, size: Vector2D?, size_in_screen_space: boolean?)
end

--- A Blueprint Class allows spawning any Unreal Blueprint Actor in nanos world.
@overrideCtor("$class($args)")
declare class Blueprint extends Entity implements Actor, Paintable
    constructor(location: Vector, rotation: Rotator, blueprint_asset: string, collision_type: CollisionType?)
    --- Calls a Blueprint Event or Function
    --- @param event_name string Event or Function name
    --- @param ... any Sequence of arguments to pass to the event
    --- @return any the function return values
    @side(shared)
    function CallBlueprintEvent(event_name: string, ...: any): any
    --- Assigns and Binds a Blueprint Event Dispatcher
    --- @param dispatcher_name string Event Dispatcher name
    --- @param callback any Callback function to call
    --- @return any the callback itself
    @side(client)
    function BindBlueprintEventDispatcher(dispatcher_name: string, callback: any): any
    --- Unbinds a Blueprint Event Dispatcher
    --- @param dispatcher_name string Event Dispatcher name
    --- @param callback any Optional callback to unbind
    @side(client)
    function UnbindBlueprintEventDispatcher(dispatcher_name: string, callback: any?): nil
    --- Sets a Blueprint Property/Variable value directly
    --- @param property_name string Name of the Blueprint variable
    --- @param value any The value to set
    @side(client)
    function SetBlueprintPropertyValue(property_name: string, value: any): nil
    --- Gets a Blueprint Property/Variable value
    --- @param property_name string Name of the Blueprint variable
    --- @return any the value
    @side(client)
    function GetBlueprintPropertyValue(property_name: string): any
end

--- A Cable represents a Physics Constraint which joins two Actors with a rope-like visual representation between them.
@overrideCtor("$class($args)")
declare class Cable extends Entity implements Actor, Paintable
    constructor(location: Vector, enable_visuals: boolean?, spawn_mode: SpawnMode?)
    --- Attaches the beginning of this cable to another Actor at a specific bone or relative location
    --- @param other Actor The Actor to attach to
    --- @param relative_location Vector Offset relative to the Actor or bone
    --- @param bone_name string Which bone to attach to. If empty it will be attached to the Actor, otherwise to the Mesh at the bone/socket
    --- @return boolean if it was attached successfully
    @side(server)
    function AttachStartTo(other: Actor, relative_location: Vector?, bone_name: string?): boolean
    --- Attaches the end of this cable to another Actor at a specific bone or relative location
    --- @param other Actor The Actor to attach to
    --- @param relative_location Vector Offset relative to the Actor or bone
    --- @param bone_name string Which bone to attach to. If empty it will be attached to the Actor, otherwise to the Mesh at the bone/socket
    --- @param constraint_offset Vector The physics constraint offset applied to the attached end, in the local space of the other Actor
    --- @return boolean if it was attached successfully
    @side(server)
    function AttachEndTo(other: Actor, relative_location: Vector?, bone_name: string?, constraint_offset: Vector?): boolean
    --- Detaches the End of this Cable
    @side(server)
    function DetachEnd(): nil
    --- Detaches the Start of this Cable
    @side(server)
    function DetachStart(): nil
    --- Set the overall settings for this cable (visuals only)
    --- @param length number Rest length of the cable. Default is 100. Min is 0
    --- @param num_segments number How many segments the cable has. Default is 10. Min is 1
    --- @param solver_iterations number The number of solver iterations controls how 'stiff' the cable is. Default is 1. Max is 16
    --- @param enable_stiffness boolean Add stiffness constraints to cable. Default is true
    @side(shared)
    function SetCableSettings(length: number, num_segments: number?, solver_iterations: number?, enable_stiffness: boolean?): nil
    --- Set the forces the cable has applied (visuals only)
    --- @param force Vector Force vector (world space) applied to all particles in cable. Default is Vector(0, 0, 0)
    --- @param gravity_scale number Scaling applied to world gravity affecting this cable. Default is 1
    @side(shared)
    function SetForces(force: Vector, gravity_scale: number?): nil
    --- Set the Physics Constraint related settings for this cable
    --- @param disable_collision boolean If true, the collision between the two rigid bodies of the constraint will be disabled
    @side(server)
    function SetPhysicsConstraintSettings(disable_collision: boolean): nil
    --- Sets the Physics Angular Limits of this cable
    --- @param swing_1_motion ConstraintMotion Indicates whether the Swing1 limit is used
    --- @param swing_2_motion ConstraintMotion Indicates whether the Swing2 limit is used
    --- @param twist_motion ConstraintMotion Indicates whether the Twist limit is used
    --- @param swing_1_limit number Angle of movement along the XY plane. This defines the first symmetric angle of the cone
    --- @param swing_2_limit number Angle of movement along the XZ plane. This defines the second symmetric angle of the cone
    --- @param twist_limit number Symmetric angle of roll along the X-axis
    @side(server)
    function SetAngularLimits(swing_1_motion: ConstraintMotion, swing_2_motion: ConstraintMotion, twist_motion: ConstraintMotion, swing_1_limit: number?, swing_2_limit: number?, twist_limit: number?): nil
    --- Sets the Physics Linear Limits of this cable
    --- @param x_motion ConstraintMotion Indicates the linear constraint applied along the X-axis. Free implies no constraint at all. Locked implies no movement along X is allowed. Limited implies the distance in the joint along all active axes must be less than the Distance provided
    --- @param y_motion ConstraintMotion Indicates the linear constraint applied along the Y-axis. Free implies no constraint at all. Locked implies no movement along Y is allowed. Limited implies the distance in the joint along all active axes must be less than the Distance provided
    --- @param z_motion ConstraintMotion Indicates the linear constraint applied along theZX-axis. Free implies no constraint at all. Locked implies no movement along Z is allowed. Limited implies the distance in the joint along all active axes must be less than the Distance provided
    --- @param limit number The distance allowed between the two joint reference frames. Distance applies on all axes enabled (one axis means line, two axes implies circle, three axes implies sphere)
    --- @param restitution number Controls the amount of bounce when the constraint is violated. A restitution value of 1 will bounce back with the same velocity the limit was hit. A value of 0 will stop dead
    --- @param use_soft_constraint boolean Whether we want to use a soft constraint (spring)
    --- @param stiffness number Stiffness of the soft constraint. Only used when Soft Constraint is on
    --- @param damping number Damping of the soft constraint. Only used when Soft Constraint is on
    @side(server)
    function SetLinearLimits(x_motion: ConstraintMotion, y_motion: ConstraintMotion, z_motion: ConstraintMotion, limit: number?, restitution: number?, use_soft_constraint: boolean?, stiffness: number?, damping: number?): nil
    --- Sets which linear position drives are enabled and the target position
    --- @param enable_drive_x boolean Enable the linear position drive on X
    --- @param enable_drive_y boolean Enable the linear position drive on Y
    --- @param enable_drive_z boolean Enable the linear position drive on Z
    --- @param strength number Positional strength for the drive (stiffness)
    --- @param target Vector Target position
    @side(server)
    function SetLinearMotorPositionSettings(enable_drive_x: boolean?, enable_drive_y: boolean?, enable_drive_z: boolean?, strength: number?, target: Vector?): nil
    --- Sets which linear velocity drives are enabled and the target velocity
    --- @param enable_drive_x boolean Enable the linear velocity drive on X
    --- @param enable_drive_y boolean Enable the linear velocity drive on Y
    --- @param enable_drive_z boolean Enable the linear velocity drive on Z
    --- @param strength number Velocity strength of the drive (damping)
    --- @param target Vector Target velocity
    @side(server)
    function SetLinearMotorVelocitySettings(enable_drive_x: boolean?, enable_drive_y: boolean?, enable_drive_z: boolean?, strength: number?, target: Vector?): nil
    --- Sets whether the SLERP angular orientation drive is enabled and the target orientation
    --- @param enable_drive_slerp boolean Enable the SLERP angular orientation drive
    --- @param strength number Positional strength for the drive (stiffness)
    --- @param target Rotator Angular drive orientation target
    @side(server)
    function SetAngularMotorSLERPOrientationSettings(enable_drive_slerp: boolean?, strength: number?, target: Rotator?): nil
    --- Sets whether the SLERP angular velocity drive is enabled and the target angular velocity
    --- @param enable_drive_slerp boolean Enable the SLERP angular velocity drive
    --- @param strength number Velocity strength of the drive (damping)
    --- @param target Vector Target angular velocity
    @side(server)
    function SetAngularMotorSLERPVelocitySettings(enable_drive_slerp: boolean?, strength: number?, target: Vector?): nil
    --- Sets which twist and swing angular orientation drives are enabled and the target orientation
    --- @param enable_drive_twist boolean Enable the twist angular orientation drive
    --- @param enable_drive_swing boolean Enable the swing angular orientation drive
    --- @param strength number Positional strength for the drive (stiffness)
    --- @param target Rotator Angular drive orientation target
    @side(server)
    function SetAngularMotorTwistAndSwingOrientationSettings(enable_drive_twist: boolean?, enable_drive_swing: boolean?, strength: number?, target: Rotator?): nil
    --- Sets which twist and swing angular velocity drives are enabled and the target angular velocity
    --- @param enable_drive_twist boolean Enable the twist angular velocity drive
    --- @param enable_drive_swing boolean Enable the swing angular velocity drive
    --- @param strength number Velocity strength of the drive (damping)
    --- @param target Vector Target angular velocity
    @side(server)
    function SetAngularMotorTwistAndSwingVelocitySettings(enable_drive_twist: boolean?, enable_drive_swing: boolean?, strength: number?, target: Vector?): nil
    --- Set the rendering settings of this cable (visuals only)
    --- @param width number How wide the cable geometry is. Default is 6
    --- @param num_sides number Number of sides of the cable geometry. Default is 4
    --- @param tile_material number How many times to repeat the material along the length of the cable. Default is 1
    @side(shared)
    function SetRenderingSettings(width: number, num_sides: number, tile_material: number): nil
    --- Gets the Actor attached to Start
    --- @return Actor? Actor attached to Start
    @side(shared)
    function GetAttachedStartTo(): Actor?
    --- Gets the Actor attached to End
    --- @return Actor? Actor attached to End
    @side(shared)
    function GetAttachedEndTo(): Actor?
end

--- Canvas is an entity which you can draw onto it.
@overrideCtor("$class($args)")
@side(client)
declare class Canvas extends Entity
    constructor(is_visible: boolean?, clear_color: Color?, auto_repaint_rate: number?, should_clear_before_update: boolean?, auto_resize: boolean?, width: number?, height: number?, screen_position: Vector2D?)
    --- Draws an unfilled box on the Canvas
    --- @param screen_position Vector2D Position on the Canvas, in pixels
    --- @param screen_size Vector2D Size on the Canvas, in pixels
    --- @param thickness number Line thickness
    --- @param render_color Color Color to tint the drawing with
    --- @param blend_mode BlendMode How it blends with what is already drawn
    @side(client)
    function DrawBox(screen_position: Vector2D, screen_size: Vector2D, thickness: number, render_color: Color?, blend_mode: BlendMode?): nil
    --- Draws a line on the Canvas
    --- @param screen_position_a Vector2D Start position of the line, in pixels
    --- @param screen_position_b Vector2D End position of the line, in pixels
    --- @param thickness number Line thickness
    --- @param render_color Color Color to tint the drawing with
    --- @param blend_mode BlendMode How it blends with what is already drawn
    @side(client)
    function DrawLine(screen_position_a: Vector2D, screen_position_b: Vector2D, thickness: number, render_color: Color, blend_mode: BlendMode?): nil
    --- Draws a Material on the Canvas
    --- @param material_path string The Material asset to use
    --- @param screen_position Vector2D Position on the Canvas, in pixels
    --- @param screen_size Vector2D Size on the Canvas, in pixels
    --- @param coordinate_position Vector2D Top-left UV coordinate of the source to draw (0 to 1)
    --- @param coordinate_size Vector2D UV size of the source to draw (0 to 1), use (1, 1) for the whole source
    --- @param rotation number Rotation in degrees
    --- @param pivot_point Vector2D Pivot of the rotation, relative to the drawing size (0.5, 0.5 is the center)
    --- @param blend_mode BlendMode How it blends with what is already drawn
    @side(client)
    function DrawMaterial(material_path: string, screen_position: Vector2D, screen_size: Vector2D, coordinate_position: Vector2D, coordinate_size: Vector2D?, rotation: number?, pivot_point: Vector2D?, blend_mode: BlendMode?): nil
    --- Draws a WebUI on the Canvas
    --- @param webui_entity WebUI The WebUI to draw
    --- @param screen_position Vector2D Position on the Canvas, in pixels
    --- @param screen_size Vector2D Size on the Canvas, in pixels
    --- @param coordinate_position Vector2D Top-left UV coordinate of the source to draw (0 to 1)
    --- @param coordinate_size Vector2D UV size of the source to draw (0 to 1), use (1, 1) for the whole source
    --- @param rotation number Rotation in degrees
    --- @param pivot_point Vector2D Pivot of the rotation, relative to the drawing size (0.5, 0.5 is the center)
    --- @param blend_mode BlendMode How it blends with what is already drawn
    @side(client)
    function DrawMaterialFromWebUI(webui_entity: WebUI, screen_position: Vector2D, screen_size: Vector2D, coordinate_position: Vector2D, coordinate_size: Vector2D?, rotation: number?, pivot_point: Vector2D?, blend_mode: BlendMode?): nil
    --- Draws a SceneCapture on the Canvas
    --- @param scenecapture_entity SceneCapture The SceneCapture to draw
    --- @param screen_position Vector2D Position on the Canvas, in pixels
    --- @param screen_size Vector2D Size on the Canvas, in pixels
    --- @param coordinate_position Vector2D Top-left UV coordinate of the source to draw (0 to 1)
    --- @param coordinate_size Vector2D UV size of the source to draw (0 to 1), use (1, 1) for the whole source
    --- @param rotation number Rotation in degrees
    --- @param pivot_point Vector2D Pivot of the rotation, relative to the drawing size (0.5, 0.5 is the center)
    --- @param blend_mode BlendMode How it blends with what is already drawn
    @side(client)
    function DrawMaterialFromSceneCapture(scenecapture_entity: SceneCapture, screen_position: Vector2D, screen_size: Vector2D, coordinate_position: Vector2D, coordinate_size: Vector2D?, rotation: number?, pivot_point: Vector2D?, blend_mode: BlendMode?): nil
    --- Draws a Text on the Canvas
    --- @param text string The text to draw
    --- @param screen_position Vector2D Position on the Canvas, in pixels
    --- @param font_type FontType Font to use
    --- @param font_size number Font size
    --- @param text_color Color Color of the text
    --- @param kerning number Extra spacing between characters
    --- @param center_x boolean Whether to center the text horizontally on the position
    --- @param center_y boolean Whether to center the text vertically on the position
    --- @param shadow_color Color Color of the text shadow, transparent to disable it
    --- @param shadow_offset Vector2D Offset of the shadow, in pixels
    --- @param outlined boolean Whether to draw an outline around the text
    --- @param outline_color Color Color of the outline
    @side(client)
    function DrawText(text: string, screen_position: Vector2D, font_type: FontType?, font_size: number?, text_color: Color?, kerning: number?, center_x: boolean?, center_y: boolean?, shadow_color: Color?, shadow_offset: Vector2D?, outlined: boolean?, outline_color: Color?): nil
    --- Draws a Texture on the Canvas
    --- @param texture_path string The image to draw
    --- @param screen_position Vector2D Position on the Canvas, in pixels
    --- @param screen_size Vector2D Size on the Canvas, in pixels
    --- @param coordinate_position Vector2D Top-left UV coordinate of the source to draw (0 to 1)
    --- @param coordinate_size Vector2D UV size of the source to draw (0 to 1), use (1, 1) for the whole source
    --- @param render_color Color Color to tint the drawing with
    --- @param blend_mode BlendMode AlphaBlend is recommended for textures with transparency. Otherwise you may use Opaque.
    --- @param rotation number Rotation in degrees
    --- @param pivot_point Vector2D Pivot of the rotation, relative to the drawing size (0.5, 0.5 is the center)
    @side(client)
    function DrawTexture(texture_path: string, screen_position: Vector2D, screen_size: Vector2D, coordinate_position: Vector2D, coordinate_size: Vector2D?, render_color: Color?, blend_mode: BlendMode?, rotation: number?, pivot_point: Vector2D?): nil
    --- Draws a N-Polygon on the Canvas
    --- @param texture_path string Pass empty to use default white Texture
    --- @param screen_position Vector2D Position on the Canvas, in pixels
    --- @param radius Vector2D Radius of the polygon on each axis, in pixels
    --- @param number_of_sides number How many sides the polygon has
    --- @param render_color Color Color to tint the drawing with
    --- @param blend_mode BlendMode How it blends with what is already drawn
    @side(client)
    function DrawPolygon(texture_path: string, screen_position: Vector2D, radius: Vector2D?, number_of_sides: number?, render_color: Color?, blend_mode: BlendMode?): nil
    --- Draws a filled Rect on the Canvas
    --- @param texture_path string Pass empty to use default white Texture
    --- @param screen_position Vector2D Position on the Canvas, in pixels
    --- @param screen_size Vector2D Size on the Canvas, in pixels
    --- @param render_color Color Color to tint the drawing with
    --- @param blend_mode BlendMode How it blends with what is already drawn
    @side(client)
    function DrawRect(texture_path: string, screen_position: Vector2D, screen_size: Vector2D, render_color: Color?, blend_mode: BlendMode?): nil
    --- Sets the repaint rate
    --- @param auto_repaint_rate number Repaint interval in seconds, 0 to repaint every frame or -1 to stop auto repainting
    @side(client)
    function SetAutoRepaintRate(auto_repaint_rate: number): nil
    --- Gets the Canvas Size
    --- @return Vector2D the current size
    @side(client)
    function GetSize(): Vector2D
    --- Resizes the Canvas if not using auto_resize
    --- @param width number Width in pixels
    --- @param height number Height in pixels
    @side(client)
    function Resize(width: number, height: number): nil
    --- Sets the Canvas Screen Position offset
    --- @param screen_position Vector2D The new Canvas Screen Position offset
    @side(client)
    function SetScreenPosition(screen_position: Vector2D): nil
    --- Sets if the canvas should auto resize to screen size
    --- @param auto_resize boolean Whether the canvas should auto resize to screen size
    @side(client)
    function SetAutoResize(auto_resize: boolean): nil
    --- Sets if it's visible on screen
    --- @param visible boolean Whether it's visible on screen
    @side(client)
    function SetVisibility(visible: boolean): nil
    --- Forces the repaint
    @side(client)
    function Repaint(): nil
    --- Clear the Canvas with a specific Color
    --- @param clear_color Color The color to fill the Canvas with
    @side(client)
    function Clear(clear_color: Color): nil
end

--- Characters represents Actors which can be possessed, can move and interact with world. They are the default Skeletal Mesh Character built for nanos world.
@overrideCtor("$class($args)")
declare class Character extends Entity implements Actor, Paintable, Damageable, Pawn
    constructor(location: Vector, rotation: Rotator, skeletal_mesh_asset: string, collision_type: CollisionType?, gravity_enabled: boolean?, max_health: number?, death_sound: string?, pain_sound: string?, spawn_mode: SpawnMode?)
    --- Drops any Pickable the Character is holding
    @side(server)
    function Drop(): nil
    --- Enters the Vehicle at Seat (0 - Driver)
    --- @param vehicle Vehicle The Vehicle
    --- @param seat number Seat index to enter, 0 is the driver seat
    @side(server)
    function EnterVehicle(vehicle: Vehicle, seat: number?): nil
    --- Gives a Prop to the Character
    --- @param prop Prop The Prop
    @side(server)
    function GrabProp(prop: Prop): nil
    --- Leaves the current Vehicle
    @side(server)
    function LeaveVehicle(): nil
    --- AI: Tries to make this Character to look at Location
    --- @param location Vector World location to look
    @side(server)
    function LookAt(location: Vector): nil
    --- Gives a Melee/Grenade/Weapon (Pickable) to the Character
    --- @param pickable Pickable The Weapon, Melee or Grenade to give to this Character
    @side(server)
    function PickUp(pickable: Pickable): nil
    --- Plays an Animation Montage on this character
    --- @param animation_path string The Animation asset to play
    --- @param slot_type AnimationSlotType Which part of the body plays the animation
    --- @param loop_indefinitely boolean Whether to keep looping until stopped
    --- @param blend_in_time number Seconds to blend into the animation
    --- @param blend_out_time number Pass it -1 to disable auto blend out and keep the animation running in last pose forever
    --- @param play_rate number Speed multiplier of the animation
    --- @param stop_all_montages boolean Stops all running Montages from the same Group
    @side(shared)
    function PlayAnimation(animation_path: string, slot_type: AnimationSlotType?, loop_indefinitely: boolean?, blend_in_time: number?, blend_out_time: number?, play_rate: number?, stop_all_montages: boolean?): nil
    --- Sets the Blend Space (2D) Animation for Standing
    --- @param blend_space_path string The Blend Space (2D) asset
    --- @param enable_turn_in_place boolean Whether the Character plays turn-in-place animations when rotating while idle
    @side(server)
    function SetAnimationIdleWalkRunStanding(blend_space_path: string, enable_turn_in_place: boolean?): nil
    --- Sets the Blend Space (2D) Animation for Crouching
    --- 
    --- Horizontal Axis stands for Speed X and Vertical Axis for Speed Y
    --- @param blend_space_path string The Blend Space (2D) asset
    --- @param enable_turn_in_place boolean Whether the Character plays turn-in-place animations when rotating while idle
    @side(server)
    function SetAnimationIdleWalkRunCrouching(blend_space_path: string, enable_turn_in_place: boolean?): nil
    --- Sets the Blend Space (2D) Animation for Proning
    --- 
    --- Horizontal Axis stands for Speed X and Vertical Axis for Speed Y
    --- @param blend_space_path string The new Blend Space (2D) Animation for Proning
    @side(server)
    function SetAnimationIdleWalkRunProning(blend_space_path: string): nil
    --- Sets the Transition Animation between Standing and Crouching
    --- @param standing_to_crouching string Animation played when crouching
    --- @param crouching_to_standing string Animation played when standing up
    @side(server)
    function SetAnimationsTransitionStandingCrouching(standing_to_crouching: string, crouching_to_standing: string): nil
    --- Sets the Transition Animation between Crouching and Proning
    --- @param crouching_to_proning string Animation played when going prone
    --- @param proning_to_crouching string Animation played when getting up from prone
    @side(server)
    function SetAnimationsTransitionCrouchingProning(crouching_to_proning: string, proning_to_crouching: string): nil
    --- Sets the Movement Max Acceleration of this Character
    --- @param walking number Max acceleration while walking
    --- @param parachuting number Max acceleration while parachuting
    --- @param skydiving number Max acceleration while skydiving
    --- @param falling number Max air control acceleration while falling
    --- @param swimming number Max acceleration while swimming underwater
    --- @param swimming_surface number Max acceleration while swimming on the surface
    --- @param flying number Max acceleration while flying
    @side(server)
    function SetAccelerationSettings(walking: number?, parachuting: number?, skydiving: number?, falling: number?, swimming: number?, swimming_surface: number?, flying: number?): nil
    --- Sets the amount of movement control allowed when it is in air
    --- @param air_control number When falling, amount of lateral movement control available to the character. 0 = no control, 1 = full control at max speed of MaxWalkSpeed
    --- @param boost_multiplier number When falling, multiplier applied to air_control when lateral velocity is less than boost_velocity_threshold. Setting this to zero will disable air control boosting. Final result is clamped at 1
    --- @param boost_velocity_threshold number When falling, if lateral velocity magnitude is less than this value, air_control is multiplied by boost_multiplier. Setting this to zero will disable air control boosting
    @side(server)
    function SetAirControl(air_control: number?, boost_multiplier: number?, boost_velocity_threshold: number?): nil
    --- Sets the Camera Mode
    --- @param camera_mode CameraMode The new Camera Mode
    @side(server)
    function SetCameraMode(camera_mode: CameraMode): nil
    --- Sets if this Character is allowed to Aim
    --- @param can_aim boolean Whether this Character is allowed to Aim
    @side(server)
    function SetCanAim(can_aim: boolean): nil
    --- Sets if this Character is allowed to Drop the Picked up item
    --- @param can_drop boolean Whether this Character is allowed to Drop the Picked up item
    @side(server)
    function SetCanDrop(can_drop: boolean): nil
    --- Sets if this Character is allowed to Dive
    --- @param can_dive boolean Whether this Character is allowed to Dive
    @side(server)
    function SetCanDive(can_dive: boolean): nil
    --- Sets if this Character is allowed to Sprint
    --- @param can_sprint boolean Whether this Character is allowed to Sprint
    @side(server)
    function SetCanSprint(can_sprint: boolean): nil
    --- Sets if this Character is allowed to Grab any Prop
    --- @param can_grab_props boolean Whether this Character is allowed to Grab any Prop
    @side(server)
    function SetCanGrabProps(can_grab_props: boolean): nil
    --- Sets if this Character is allowed to Pick up any Pickable (Weapon, Grenade, Melee...)
    --- @param can_pickup boolean Whether this Character is allowed to Pick up any Pickable
    @side(server)
    function SetCanPickupPickables(can_pickup: boolean): nil
    --- Sets if this Character is in Shooter Mode, in which a held Weapon is always aimed while idle or walking, is lowered while sprinting, and the aim input aims down sights instead of raising the Weapon
    --- @param weapon_shooter_mode boolean Whether this Character is in Shooter Mode, in which a held Weapon is always aimed while idle or walking, is lowered while sprinting, and the aim input aims down sights instead of raising the Weapon
    @side(server)
    function SetWeaponShooterMode(weapon_shooter_mode: boolean): nil
    --- Sets if this Character is allowed to use Pickables (Weapon, Grenade, Melee...)
    --- @param can_use boolean Whether this Character is allowed to use Pickables
    @side(server)
    function SetCanUsePickables(can_use: boolean): nil
    --- Sets if this Character is allowed to Punch
    --- @param can_punch boolean Whether this Character is allowed to Punch
    @side(server)
    function SetCanPunch(can_punch: boolean): nil
    --- Sets if this Character is allowed to deploy the Parachute
    --- @param can_deploy_parachute boolean Whether this Character is allowed to deploy the Parachute
    @side(server)
    function SetCanDeployParachute(can_deploy_parachute: boolean): nil
    --- Changes the Death sound when Character dies
    --- @param sound_asset string The new Death sound when Character dies
    @side(server)
    function SetDeathSound(sound_asset: string): nil
    --- Set the Fall Damage multiplier taken when falling from High places
    --- @param damage number Default is 10
    @side(server)
    function SetFallDamageTaken(damage: number): nil
    --- Sets the Field of View multiplier
    --- @param multiplier number The new Field of View multiplier
    @side(server)
    function SetFOVMultiplier(multiplier: number): nil
    --- Sets time to transition to HighFalling state
    --- @param time number Default is 1 second
    @side(server)
    function SetHighFallingTime(time: number): nil
    --- Sets if the character will enter ragdoll mode when being hit by an object or falling from a high place
    --- @param is_enabled boolean Whether the character will enter ragdoll mode when being hit by an object or falling from a high place
    @side(server)
    function SetRagdollOnHitEnabled(is_enabled: boolean): nil
    --- Sets the cooldown time (in seconds) before this Character can stand up from ragdoll
    --- @param time number The new cooldown time (in seconds) before this Character can stand up from ragdoll
    @side(server)
    function SetRagdollStandUpCooldown(time: number): nil
    --- Sets the Gait Mode (walking or sprinting)
    --- @param gait_mode GaitMode The new Gait Mode
    @side(server)
    function SetGaitMode(gait_mode: GaitMode): nil
    --- Set the Impact Damage taken when being run over by things
    --- @param impact_damage number Default is 10
    @side(server)
    function SetImpactDamageTaken(impact_damage: number): nil
    --- Set the minimum radial damage (e.g. explosions) taken to enter in ragdoll mode
    --- @param damage number Default is 50
    @side(server)
    function SetRadialDamageToRagdoll(damage: number): nil
    --- Set the Footstep Volume multiplier
    --- @param volume_multiplier number The new Footstep Volume multiplier
    @side(server)
    function SetFootstepVolumeMultiplier(volume_multiplier: number): nil
    --- Sets if the Character can receive any damage
    --- @param is_invulnerable boolean Whether the Character can receive any damage
    @side(server)
    function SetInvulnerable(is_invulnerable: boolean): nil
    --- Changes the Character Mesh at runtime
    --- @param skeletal_mesh_asset string The new Skeletal Mesh asset
    @side(server)
    function SetMesh(skeletal_mesh_asset: string): nil
    --- Sets the value of a Morph Target
    --- @param name string Morph Target Name
    --- @param value number The Morph Target weight, usually from 0 to 1
    @side(shared)
    function SetMorphTarget(name: string, value: number): nil
    --- Returns the value of a Morph Target
    --- @param name string Morph Target Name
    --- @return number value of the Morph Target
    @side(shared)
    function GetMorphTarget(name: string): number
    --- Clear all Morph Target that are set to this Mesh
    @side(shared)
    function ClearMorphTargets(): nil
    --- Returns a table with all morph targets available
    --- @return string[] table with all morph targets available
    @side(client)
    function GetAllMorphTargetNames(): string[]
    --- Applies the physical animation settings to the body given
    --- @param bone string The body we will be driving
    --- @param include_self boolean Whether to modify the given body
    --- @param is_local_simulation boolean Whether the drive targets are in world space or local
    --- @param orientation_strength number The strength used to correct orientation error
    --- @param angular_velocity_strength number The strength used to correct angular velocity error
    --- @param position_strength number The strength used to correct linear position error. Only used for non-local simulation
    --- @param velocity_strength number The strength used to correct linear velocity error. Only used for non-local simulation
    --- @param max_linear_force number The max force used to correct linear errors
    --- @param max_angular_force number The max force used to correct angular errors
    @side(shared)
    function SetPhysicalAnimationSettings(bone: string, include_self: boolean, is_local_simulation: boolean, orientation_strength: number?, angular_velocity_strength: number?, position_strength: number?, velocity_strength: number?, max_linear_force: number?, max_angular_force: number?): nil
    --- Resets all Physical Animation settings
    @side(shared)
    function ResetPhysicalAnimationSettings(): nil
    --- Enables/Disables Character's Input
    --- @param is_enabled boolean Whether to enable Character's Input
    @side(server)
    function SetInputEnabled(is_enabled: boolean): nil
    --- Changes the texture of the Character's parachute
    --- @param texture string The new Parachute Texture
    @side(server)
    function SetParachuteTexture(texture: string): nil
    --- Changes the Pain sound when Character takes damage
    --- @param sound_asset string The new Pain sound when Character takes damage
    @side(server)
    function SetPainSound(sound_asset: string): nil
    --- Set the Punch Damage this Character will apply on others
    --- @param punch_damage number Default is 15
    @side(server)
    function SetPunchDamage(punch_damage: number): nil
    --- Enables or disables the Ragdoll Mode, making the Character fall as a physics body
    --- @param ragdoll_enabled boolean Whether the Ragdoll Mode is enabled
    @side(server)
    function SetRagdollMode(ragdoll_enabled: boolean): nil
    --- Sets the Character Capsule to simulate physics
    --- @param simulate_physics boolean The new Character Capsule to simulate physics
    @side(server)
    function SetSimulatePhysics(simulate_physics: boolean): nil
    --- Sets the multiplier applied to all movement speeds
    --- @param speed_multiplier number 1 is normal
    @side(server)
    function SetSpeedMultiplier(speed_multiplier: number): nil
    --- Sets the Stance Mode (standing, crouching or proning)
    --- @param stance_mode StanceMode The new Stance Mode
    @side(server)
    function SetStanceMode(stance_mode: StanceMode): nil
    --- Sets a Team which will disable damaging same Team Members
    --- @param team number 0 is neutral and default
    @side(server)
    function SetTeam(team: number): nil
    --- Sets the View Mode (first person, third person or top down)
    --- @param view_mode ViewMode The new View Mode
    function SetViewMode(view_mode: ViewMode): nil
    --- Sets the Weapon's Aim Mode
    --- @param aim_mode AimMode The new Weapon's Aim Mode
    function SetWeaponAimMode(aim_mode: AimMode): nil
    --- UnGrabs/Drops the Prop the Character is holding
    @side(server)
    function UnGrabProp(): nil
    --- Gets if Character is in ragdoll mode
    --- @return boolean Whether Character is in ragdoll mode
    @side(shared)
    function IsInRagdollMode(): boolean
    --- Gets if this Character is invulnerable
    --- @return boolean Whether this Character is invulnerable
    @side(shared)
    function IsInvulnerable(): boolean
    --- Gets if this Character has input enabled
    --- @return boolean Whether input is enabled
    @side(shared)
    function IsInputEnabled(): boolean
    --- Gets the camera mode
    --- @return CameraMode Camera mode
    @side(shared)
    function GetCameraMode(): CameraMode
    --- Gets if this Character is allowed to drop the picked up item
    --- @return boolean Whether it is allowed to drop
    @side(shared)
    function GetCanDrop(): boolean
    --- Gets if this Character is allowed to punch
    --- @return boolean Whether it is allowed to punch
    @side(shared)
    function GetCanPunch(): boolean
    --- Gets if this Character is allowed to deploy the Parachute
    --- @return boolean Whether this Character is allowed to deploy the Parachute
    @side(shared)
    function GetCanDeployParachute(): boolean
    --- Gets if this Character is allowed to Dive
    --- @return boolean Whether this Character is allowed to Dive
    @side(shared)
    function GetCanDive(): boolean
    --- Gets the Footstep Volume multiplier
    --- @return number Footstep Volume multiplier
    @side(shared)
    function GetFootstepVolumeMultiplier(): number
    --- Gets the minimum radial damage (e.g. explosions) taken to enter in ragdoll mode
    --- @return number -1 if the Character never enters ragdoll mode from radial damage
    @side(shared)
    function GetRadialDamageToRagdoll(): number
    --- Gets if this Character is allowed to aim
    --- @return boolean Whether it is allowed to aim
    @side(shared)
    function GetCanAim(): boolean
    --- Gets if this Character is allowed to sprint
    --- @return boolean Whether it is allowed to sprint
    @side(shared)
    function GetCanSprint(): boolean
    --- Gets if this Character is allowed to grab Props
    --- @return boolean Whether it is allowed to grab Props
    @side(shared)
    function GetCanGrabProps(): boolean
    --- Gets if this Character is allowed to pick up Pickables (Weapon, Grenade, Melee...)
    --- @return boolean Whether it is allowed to pick up Pickables
    @side(shared)
    function GetCanPickupPickables(): boolean
    --- Gets if this Character is in Shooter Mode
    --- @return boolean Whether this Character is in Shooter Mode
    @side(shared)
    function GetWeaponShooterMode(): boolean
    --- Gets if this Character is allowed to use Pickables (Weapon, Grenade, Melee...)
    --- @return boolean Whether it is allowed to use Pickables
    @side(shared)
    function GetCanUsePickables(): boolean
    --- Gets the Fall Damage multiplier
    --- @return number The Fall Damage multiplier
    @side(shared)
    function GetFallDamageTaken(): number
    --- Gets the current Falling Mode
    --- @return FallingMode The current Falling Mode
    @side(shared)
    function GetFallingMode(): FallingMode
    --- Gets the current Gait Mode
    --- @return GaitMode The current Gait Mode
    @side(shared)
    function GetGaitMode(): GaitMode
    --- Gets the Grabbed Prop
    --- @return Prop? Grabbed Prop
    @side(shared)
    function GetGrabbedProp(): Prop?
    --- Gets the Impact Damage taken when being run over
    --- @return number The Impact Damage
    @side(shared)
    function GetImpactDamageTaken(): number
    --- Gets the Pickable if picking up
    --- @return Pickable? Pickable if picking up
    @side(shared)
    function GetPicked(): Pickable?
    --- Gets the damage dealt by this Character's punches
    --- @return number The punch damage
    @side(shared)
    function GetPunchDamage(): number
    --- Gets the movement speed multiplier
    --- @return number The speed multiplier
    @side(shared)
    function GetSpeedMultiplier(): number
    --- Gets the Stance Mode
    --- @return StanceMode Stance Mode
    @side(shared)
    function GetStanceMode(): StanceMode
    --- Gets the Swimming Mode
    --- @return SwimmingMode Swimming Mode
    @side(shared)
    function GetSwimmingMode(): SwimmingMode
    --- Gets the Team of this Character
    --- @return number The Team, 0 means no team
    @side(shared)
    function GetTeam(): number
    --- Gets the entered Vehicle
    --- @return Vehicle? Entered Vehicle
    @side(shared)
    function GetVehicle(): Vehicle?
    --- Gets the entered Vehicle seat
    --- @return number The seat index the Character is sitting in the Vehicle. -1 if not in a Vehicle
    @side(shared)
    function GetVehicleSeat(): number
    --- Gets the View Mode
    --- @return ViewMode View Mode
    @side(shared)
    function GetViewMode(): ViewMode
    --- Gets the Weapon Aim Mode
    --- @return AimMode Weapon Aim Mode
    @side(shared)
    function GetWeaponAimMode(): AimMode
    --- Sets the Physics Asset for the Character
    --- @param physics_asset string The new Physics Asset for the Character
    @side(server)
    function SetPhysicsAsset(physics_asset: string): nil
end

--- CharacterSimple is a simpler Character implementation with basic Movement implementation. Aimed for custom NPCs or basic Pawns.
@overrideCtor("$class($args)")
declare class CharacterSimple extends Entity implements Actor, Paintable, Damageable, Pawn
    constructor(location: Vector, rotation: Rotator, mesh: string | string, custom_animation_blueprint: string?, collision_type: CollisionType?, gravity_enabled: boolean?, spawn_mode: SpawnMode?)
    --- Changes the Character Mesh at runtime
    --- @param mesh_asset string | string The new Skeletal or Static Mesh asset
    function SetMesh(mesh_asset: string | string): nil
    --- Sets the Physics Asset for the Character
    --- @param physics_asset string The new Physics Asset for the Character
    function SetPhysicsAsset(physics_asset: string): nil
    --- Plays an Animation Montage on this character
    --- @param animation_path string The Animation asset to play
    --- @param slot_name string The Animation Slot to play it on
    --- @param loop_indefinitely boolean Whether to keep looping until stopped
    --- @param blend_in_time number Seconds to blend into the animation
    --- @param blend_out_time number Pass it -1 to disable auto blend out and keep the animation running in last pose forever
    --- @param play_rate number Speed multiplier of the animation
    --- @param stop_all_montages boolean Stops all running Montages from the same Group
    function PlayAnimation(animation_path: string, slot_name: string?, loop_indefinitely: boolean?, blend_in_time: number?, blend_out_time: number?, play_rate: number?, stop_all_montages: boolean?): nil
    --- Sets the max acceleration of the movement
    --- @param acceleration number Default is 2048
    function SetMaxAcceleration(acceleration: number): nil
    --- Sets the Spring Arm Settings of this Character
    --- @param relative_location Vector Pass nil to use default as capsule height * 1.8
    --- @param target_arm_length number Distance from the camera to the Character, in units
    --- @param socket_offset Vector Offset of the camera at the end of the arm
    --- @param enable_camera_lag boolean Whether the camera smoothly lags behind the Character
    --- @param camera_lag_speed number How fast the camera catches up when lagging
    --- @param camera_lag_max_distance number Max distance the camera can lag behind
    @side(shared)
    function SetSpringArmSettings(relative_location: Vector?, target_arm_length: number?, socket_offset: Vector?, enable_camera_lag: boolean?, camera_lag_speed: number?, camera_lag_max_distance: number?): nil
    --- Sets the Rotation Settings of this Character
    --- @param rotation_rate Rotator Max rotation speed, in degrees per second
    --- @param use_controller_desired_rotation boolean Whether to smoothly rotate towards the controller rotation
    --- @param orient_rotation_to_movement boolean Whether to rotate towards the movement direction
    function SetRotationSettings(rotation_rate: Rotator, use_controller_desired_rotation: boolean, orient_rotation_to_movement: boolean): nil
    --- Sets the Speed Settings of this Character
    --- @param max_walk_speed number Max speed while walking
    --- @param max_walk_speed_crouched number Max speed while crouched
    --- @param max_fly_speed number Max speed while flying
    function SetSpeedSettings(max_walk_speed: number?, max_walk_speed_crouched: number?, max_fly_speed: number?): nil
    --- Sets the Pawn Settings of this Character
    --- @param use_controller_rotation_pitch boolean Whether the Pawn follows the controller Pitch
    --- @param use_controller_rotation_yaw boolean Whether the Pawn follows the controller Yaw
    --- @param use_controller_rotation_roll boolean Whether the Pawn follows the controller Roll
    function SetPawnSettings(use_controller_rotation_pitch: boolean, use_controller_rotation_yaw: boolean, use_controller_rotation_roll: boolean): nil
    --- Sets the amount of movement control allowed when it is in air
    --- @param air_control number When falling, amount of lateral movement control available to the character. 0 = no control, 1 = full control at max speed of MaxWalkSpeed
    --- @param boost_multiplier number When falling, multiplier applied to air_control when lateral velocity is less than boost_velocity_threshold. Setting this to zero will disable air control boosting. Final result is clamped at 1
    --- @param boost_velocity_threshold number When falling, if lateral velocity magnitude is less than this value, air_control is multiplied by boost_multiplier. Setting this to zero will disable air control boosting
    function SetAirControl(air_control: number?, boost_multiplier: number?, boost_velocity_threshold: number?): nil
    --- Sets the Animation Blueprint of this Character
    --- @param custom_animation_blueprint string The new Animation Blueprint of this Character
    function SetAnimationBlueprint(custom_animation_blueprint: string): nil
    --- Sets an Animation Blueprint Property/Variable value directly
    --- @param property_name string Name of the Animation Blueprint variable
    --- @param value any The value to set
    @side(client)
    function SetAnimationBlueprintPropertyValue(property_name: string, value: any): nil
    --- Gets an Animation Blueprint Property/Variable value directly
    --- @param property_name string Name of the Animation Blueprint variable
    --- @return any the property value
    @side(client)
    function GetAnimationBlueprintPropertyValue(property_name: string): any
    --- Calls an Animation Blueprint Event or Function
    --- @param event_name string Event or Function name
    --- @param ... any Sequence of arguments to pass to the event
    --- @return any the function return values
    @side(shared)
    function CallAnimationBlueprintEvent(event_name: string, ...: any): any
    --- Assigns and Binds an Animation Blueprint Event Dispatcher
    --- @param dispatcher_name string Event Dispatcher name
    --- @param callback any Callback function to call
    --- @return any the callback itself
    @side(client)
    function BindAnimationBlueprintEventDispatcher(dispatcher_name: string, callback: any): any
    --- Unbinds an Animation Blueprint Event Dispatcher
    --- @param dispatcher_name string Event Dispatcher name
    --- @param callback any Optional callback to unbind
    @side(client)
    function UnbindAnimationBlueprintEventDispatcher(dispatcher_name: string, callback: any?): nil
    --- Sets if this Character is crouching
    --- @param is_crouching boolean Whether this Character is crouching
    function SetCrouching(is_crouching: boolean): nil
    --- Gets if this Character is crouching
    --- @return boolean Whether this Character is crouching
    @side(shared)
    function IsCrouching(): boolean
end

--- The Database entity provides programmers a way to access SQL databases easily through scripting.
@overrideCtor("$class($args)")
@side(server)
declare class Database
    constructor(database_engine: DatabaseEngine, connection_string: string, pool_size: number?)
    --- Closes the Database
    @side(server)
    function Close(): nil
    --- Execute a query asynchronously
    --- @param query string Query to execute
    --- @param callback any Callback
    --- @param ... any Sequence of parameters to escape into the Query
    @side(server)
    function ExecuteAsync(query: string, callback: any?, ...: any): nil
    --- Executes a query synchronously, blocking until it finishes. Prefer `ExecuteAsync` to avoid freezing the server
    --- @param query string Query to execute
    --- @param ... any Sequence of parameters to escape into the Query
    --- @return number affected rows
    --- @return string error (if any)
    @side(server)
    function Execute(query: string, ...: any): (number, string)
    --- Execute a select query asynchronously
    --- @param query string Query to execute
    --- @param callback any Callback
    --- @param ... any Sequence of parameters to escape into the Query
    @side(server)
    function SelectAsync(query: string, callback: any?, ...: any): nil
    --- Runs a SELECT query synchronously, blocking until it finishes. Prefer `SelectAsync` to avoid freezing the server
    --- @param query string Query to execute
    --- @param ... any Sequence of parameters to escape into the Query
    --- @return any[] rows fetched
    --- @return string error (if any)
    @side(server)
    function Select(query: string, ...: any): (any[], string)
end

--- Decals are Materials that are projected onto meshes in your level, including Static Meshes and Skeletal Meshes.
@overrideCtor("$class($args)")
declare class Decal extends Entity implements Actor, Paintable
    constructor(location: Vector, rotation: Rotator, material_asset: string, size: Vector?, lifespan: number?, fade_screen_size: number?)
    --- Sets the size of this Decal.
    --- @param size Vector New size of the Decal
    function SetSize(size: Vector): nil
    --- Starts fading in this Decal after a delay.
    --- @param start_delay number Seconds to wait before starting the fade-in
    --- @param duration number Duration of the fade-in, in seconds
    function SetFadeIn(start_delay: number, duration: number): nil
    --- Starts fading out this Decal after a delay.
    --- @param start_delay number Seconds to wait before starting the fade-out
    --- @param duration number Duration of the fade-out in seconds
    --- @param destroy_after_fade_out boolean Whether to destroy the Decal after fade-out finishes
    function SetFadeOut(start_delay: number, duration: number, destroy_after_fade_out: boolean?): nil
end

--- A File represents an entry to a system file.
@overrideCtor("$class($args)")
@side(shared)
declare class File
    constructor(file_path: string, truncate: boolean?)
    --- Closes the file and destroys the entity
    @side(shared)
    function Close(): nil
    --- Flushes content to the file
    @side(shared)
    function Flush(): nil
    --- Checks if the file status is End of File
    --- @return boolean if is EOF
    @side(shared)
    function IsEOF(): boolean
    --- Checks if the file status is Bad
    --- @return boolean if status is Bad
    @side(shared)
    function IsBad(): boolean
    --- Checks if the file status is Good
    --- @return boolean if status is Good
    @side(shared)
    function IsGood(): boolean
    --- Checks if the last operation has Failed
    --- @return boolean if last operation failed
    @side(shared)
    function HasFailed(): boolean
    --- Reads characters from the File and returns it. Also moves the file pointer to the latest read position. Pass 0 to read the whole file
    --- @param length number Length to be read from file, leave it empty (or 0) to read the whole file
    --- @return string file data
    @side(shared)
    function Read(length: number?): string
    --- Reads characters from the File asynchronously.
    --- @param length number Length to be read from file, pass 0 to read the whole file
    --- @param callback any Callback
    @side(shared)
    function ReadAsync(length: number?, callback: any): nil
    --- Reads and returns the next file line
    --- @return string file line data
    @side(shared)
    function ReadLine(): string
    --- Reads the whole file as a JSON and returns it.
    --- @return any parsed table
    @side(shared)
    function ReadJSON(): any
    --- Reads the whole file as a JSON and returns it asynchronously.
    --- @param callback any Callback with the file read
    @side(shared)
    function ReadJSONAsync(callback: any): nil
    --- Sets the file pointer to a specific position
    --- @param position number Position to offset the file pointer
    @side(shared)
    function Seek(position: number): nil
    --- Returns the size of the file
    --- @return number file size
    @side(shared)
    function Size(): number
    --- Skips n (amount) positions from the current file pointer position
    --- @param amount number Amount to offset the file pointer
    @side(shared)
    function Skip(amount: number): nil
    --- Returns the current file pointer position
    --- @return number current file pointer position
    @side(shared)
    function Tell(): number
    --- Writes the Data at the current position of the file
    --- @param data string Data to write to the file
    @side(shared)
    function Write(data: string): nil
    --- Returns when a file was last modified in Unix time
    --- @param path string Path to file
    --- @return number the last update time in unix time
    @side(shared)
    static function Time(path: string): number
    --- Creates a Directory (for every folder passed)
    --- @param path string Path to folder
    --- @return boolean if succeeded
    @side(shared)
    static function CreateDirectory(path: string): boolean
    --- Deletes a folder or file
    --- @param path string Path to file or folder
    --- @return number amount of files deleted
    @side(shared)
    static function Remove(path: string): number
    --- Renames or moves a folder or file
    --- @param old_path string Path to the existing file or folder
    --- @param new_path string New path of the file or folder
    --- @return boolean if it was successfully renamed
    @side(shared)
    static function Rename(old_path: string, new_path: string): boolean
    --- Verifies if an entry exists in the file system
    --- @param path string Path to file or folder
    --- @return boolean if exists
    @side(shared)
    static function Exists(path: string): boolean
    --- Checks if a path is a directory
    --- @param path string Path to folder
    --- @return boolean Whether the path is a directory
    @side(shared)
    static function IsDirectory(path: string): boolean
    --- Checks if a path is a file
    --- @param path string Path to file
    --- @return boolean Whether the path is a regular file
    @side(shared)
    static function IsRegularFile(path: string): boolean
    --- Gets a list of all directories given a path
    --- @param path_filter string Path filter
    --- @param max_depth number The maximum depth to go further in the folders while searching. Pass -1 for maximum depth
    --- @return string[] List of directories
    @side(shared)
    static function GetDirectories(path_filter: string?, max_depth: number?): string[]
    --- Gets a list of all files in a directory
    --- @param path_filter string | any Path filter
    --- @param extension_filter string E.g.: `.lua`
    --- @param max_depth number The maximum depth to go further in the folders while searching. Pass -1 for maximum depth
    --- @return string[] List of files
    @side(shared)
    static function GetFiles(path_filter: string | any?, extension_filter: string?, max_depth: number?): string[]
    --- Gets the full path given a relative path based on the current side (client or server)
    --- @param path string Path to file or directory
    --- @return string the full path parsed
    @side(shared)
    static function GetFullPath(path: string): string
end

--- A tool to transform objects at runtime.
@overrideCtor("$class($args)")
@side(client)
declare class Gizmo extends Entity implements Actor
    constructor()
    --- Enables the interaction, placing the Gizmo at the given transform
    --- @param location Vector World location of the Gizmo
    --- @param rotation Rotator World rotation of the Gizmo
    --- @param scale Vector Scale of the Gizmo
    @side(client)
    function Activate(location: Vector, rotation: Rotator, scale: Vector): nil
    --- Disable the interaction
    @side(client)
    function Deactivate(): nil
    --- Returns if it's currently interacting
    --- @return boolean Whether it's currently interacting
    @side(client)
    function IsInteracting(): boolean
    --- Triggers the press pointer event on it
    @side(client)
    function PressPointer(): nil
    --- Triggers the release pointer event on it
    @side(client)
    function ReleasePointer(): nil
    --- Sets whether the Gizmo translates, rotates or scales
    --- @param transform_mode GizmoTransformMode The transform mode
    --- @param combine_translate_rotate boolean Whether to show the translation and rotation handles together
    @side(client)
    function SetTransformMode(transform_mode: GizmoTransformMode, combine_translate_rotate: boolean): nil
    --- Sets whether the Gizmo is aligned to the local or the world space
    --- @param align_space GizmoAlignSpace The align space
    @side(client)
    function SetAlignSpace(align_space: GizmoAlignSpace): nil
    --- Sets the snapping grid sizes, 0 to disable snapping
    --- @param location_grid_size number Translation snap size, in units
    --- @param rotation_grid_size number Rotation snap size, in degrees
    --- @param scale_grid_size number Scale snap size
    @side(client)
    function SetSnapSettings(location_grid_size: number, rotation_grid_size: number, scale_grid_size: number): nil
end

--- Grenades are Pickables which Characters can grab and throw. It explodes after X seconds after thrown, causing damage around.
@overrideCtor("$class($args)")
declare class Grenade extends Entity implements Actor, Paintable, Pickable
    constructor(location: Vector, rotation: Rotator, static_mesh_asset: string?, explosion_particles: string?, explosion_sound: string?, collision_type: CollisionType?, gravity_enabled: boolean?, spawn_mode: SpawnMode?)
    --- Forces this grenade to Explode
    @side(server)
    function Explode(): nil
    --- Sets Damage parameters of this Grenade
    --- @param base_damage number Max damage when inner radius
    --- @param minimum_damage number Min damage when outer radius
    --- @param damage_inner_radius number Radius which damage will be 100%
    --- @param damage_outer_radius number Radius which damage will be interpolated through falloff
    --- @param damage_falloff number Lerp function between Max and Min damage
    @side(server)
    function SetDamage(base_damage: number?, minimum_damage: number?, damage_inner_radius: number?, damage_outer_radius: number?, damage_falloff: number?): nil
    --- Set Time until Explosion after thrown
    --- @param time number Time in seconds
    @side(server)
    function SetTimeToExplode(time: number): nil
    --- Set Impulse applied when throwing
    --- @param throw_force number The new Impulse applied when throwing
    @side(server)
    function SetThrowForce(throw_force: number): nil
    --- Gets the max damage, applied within the inner radius
    --- @return number The base damage
    @side(shared)
    function GetBaseDamage(): number
    --- Gets the falloff exponent used to interpolate between the base and the minimum damage
    --- @return number The damage falloff
    @side(shared)
    function GetDamageFalloff(): number
    --- Gets the radius within which the base damage is fully applied
    --- @return number The inner radius
    @side(shared)
    function GetDamageInnerRadius(): number
    --- Gets the radius at which the damage reaches the minimum damage
    --- @return number The outer radius
    @side(shared)
    function GetDamageOuterRadius(): number
    --- Gets the min damage, applied at the outer radius
    --- @return number The minimum damage
    @side(shared)
    function GetMinimumDamage(): number
    --- Gets the time until the explosion after throwing
    --- @return number Seconds until the explosion
    @side(shared)
    function GetTimeToExplode(): number
    --- Gets the impulse applied when throwing
    --- @return number The throw force
    @side(shared)
    function GetThrowForce(): number
end

--- An Instanced Static Mesh entity allows spawning a mesh that can have multiple instances efficiently rendered.
@overrideCtor("$class($args)")
declare class InstancedStaticMesh extends Entity implements Actor, Paintable
    constructor(location: Vector, rotation: Rotator, static_mesh_asset: string, collision_type: CollisionType?, instances: any?, spawn_mode: SpawnMode?)
    --- Gets the Asset path mesh used
    --- @return string Asset path mesh used
    @side(shared)
    function GetMesh(): string
    --- Add an instance to this component
    --- @param relative_location Vector Location relative to this component
    --- @param relative_rotation Rotator Rotation relative to this component
    --- @param scale Vector Scale of the instance
    --- @return number the index of the added instance
    function AddInstance(relative_location: Vector, relative_rotation: Rotator?, scale: Vector?): number
    --- Add multiple instances to this component. It is way efficient calling this once than AddInstance multiple times
    --- @param instances any Array with the instances
    function AddInstances(instances: any): nil
    --- Removes the instance at the given index. This will move the last element to the provided index, reducing the count by 1
    --- @param index number Index of the instance
    function RemoveInstance(index: number): nil
    --- Changes the transform of an existing instance. You can pass all other parameters as nil to modify only a single property
    --- @param index number Index of the instance
    --- @param relative_location Vector Location relative to this component
    --- @param relative_rotation Rotator Rotation relative to this component
    --- @param scale Vector Scale of the instance
    function SetInstanceTransform(index: number, relative_location: Vector?, relative_rotation: Rotator?, scale: Vector?): nil
    --- Returns the current transform of the instance at the given index
    --- @param index number Index of the instance
    --- @return Vector The instance relative location
    --- @return Rotator The instance relative rotation
    --- @return Vector The instance scale
    @side(shared)
    function GetInstanceTransform(index: number): (Vector, Rotator, Vector)
    --- Returns the number of instances currently stored
    --- @return number Number of instances currently stored
    @side(shared)
    function GetInstanceCount(): number
    --- Removes all instances.
    function ClearInstances(): nil
end

--- A Light represents a Lighting source.
@overrideCtor("$class($args)")
@side(shared)
declare class Light extends Entity implements Actor
    constructor(location: Vector, rotation: Rotator?, color: Color?, light_type: LightType?, intensity: number?, attenuation_radius: number?, cone_angle: number?, inner_cone_angle_percent: number?, max_draw_distance: number?, use_inverse_squared_falloff: boolean?, cast_shadows: boolean?, visible: boolean?, source_radius: number?, spawn_mode: SpawnMode?)
    --- Sets the light color
    --- @param color Color The light color
    @side(shared)
    function SetColor(color: Color): nil
    --- Sets the light Texture Profile
    --- @param light_profile LightProfile The Light Profile to use
    @side(shared)
    function SetTextureLightProfile(light_profile: LightProfile): nil
    --- Sets if this Light casts shadows
    --- @param is_shadows_enabled boolean Whether it casts shadows
    @side(shared)
    function SetCastShadows(is_shadows_enabled: boolean): nil
    --- Sets the brightness of this Light
    --- @param intensity number The new brightness
    @side(shared)
    function SetIntensity(intensity: number): nil
    --- Sets the distance this Light reaches
    --- @param attenuation_radius number The new attenuation radius
    @side(shared)
    function SetAttenuationRadius(attenuation_radius: number): nil
    --- Gets if this Light casts shadows
    --- @return boolean Whether it casts shadows
    @side(shared)
    function GetCastShadows(): boolean
    --- Gets the brightness of this Light
    --- @return number The brightness
    @side(shared)
    function GetIntensity(): number
    --- Gets the distance this Light reaches
    --- @return number The attenuation radius
    @side(shared)
    function GetAttenuationRadius(): number
    --- Gets the color of this Light
    --- @return Color The light color
    @side(shared)
    function GetColor(): Color
end

--- A Melee represents an Entity which can be Pickable by a Character and can be used to melee attack, Characters can hold it with hands with pre-defined handling modes.
@overrideCtor("$class($args)")
declare class Melee extends Entity implements Actor, Paintable, Pickable
    constructor(location: Vector, rotation: Rotator, asset: string, collision_type: CollisionType?, gravity_enabled: boolean?, handling_mode: HandlingMode?, crosshair_material: string?, can_use: boolean?, spawn_mode: SpawnMode?)
    --- Sets an Animation when attacking
    --- @param asset_path string The Animation used when attacking
    --- @param play_rate number The Animation Play Rate
    --- @param slot_type AnimationSlotType Whether to play it on upper body or full body
    @side(server)
    function AddAnimationCharacterUse(asset_path: string, play_rate: number?, slot_type: AnimationSlotType?): nil
    --- Clears the Character Attack Animation list
    @side(server)
    function ClearAnimationsCharacterUse(): nil
    --- Sets the Sound when hitting something
    --- @param surface_type SurfaceType The surface to apply the sound. Use `SurfaceType.Default` to be the default to all non defined surfaces. Note: Surfaces Water and Flesh already have default sounds and must be explicitly overridden
    --- @param asset_path string The Sound used when attacking
    --- @param volume number Volume multiplier
    --- @param pitch number Pitch multiplier
    @side(shared)
    function SetImpactSound(surface_type: SurfaceType, asset_path: string, volume: number?, pitch: number?): nil
    --- Sets the Sound when attacking
    --- @param asset_path string The Sound used when attacking
    @side(shared)
    function SetSoundUse(asset_path: string): nil
    --- Sets the Base Damage
    --- @param damage number The Base Damage value
    @side(server)
    function SetBaseDamage(damage: number): nil
    --- Sets the times when to start applying damage and when to end
    --- @param damage_start_time number The initial time to start applying damage
    --- @param damage_duration_time number The duration time to stop applying damage
    @side(server)
    function SetDamageSettings(damage_start_time: number, damage_duration_time: number): nil
    --- Sets the cooldown between attacking
    --- @param cooldown number The new cooldown between attacking
    @side(shared)
    function SetCooldown(cooldown: number): nil
    --- Gets the Animations when Character uses it
    --- @return string[] Animations when Character uses it
    @side(shared)
    function GetAnimationsCharacterUse(): string[]
    --- Gets the Sound when Character uses it
    --- @return string Sound when Character uses it
    @side(shared)
    function GetSoundUse(): string
    --- Gets the Base Damage
    --- @return number Base Damage
    @side(shared)
    function GetBaseDamage(): number
    --- Gets the Cooldown between usages
    --- @return number Cooldown between usages
    @side(shared)
    function GetCooldown(): number
end

--- Class to spawn Particle Systems used to create effects in the world.
@overrideCtor("$class($args)")
declare class Particle extends Entity implements Actor
    constructor(location: Vector, rotation: Rotator, asset: string, auto_destroy: boolean?, auto_activate: boolean?, spawn_mode: SpawnMode?)
    --- Activates the Emitter
    --- @param should_reset boolean If should reset
    @side(shared)
    function Activate(should_reset: boolean?): nil
    --- Deactivate the Emitter
    @side(shared)
    function Deactivate(): nil
    --- Returns if this Particle is active
    --- @return boolean Whether this Particle is active
    @side(shared)
    function IsActive(): boolean
    --- Sets a float parameter in this Particle System
    --- @param parameter string The parameter name
    --- @param value number The float value
    @side(shared)
    function SetParameterFloat(parameter: string, value: number): nil
    --- Sets an integer parameter in this Particle System
    --- @param parameter string The parameter name
    --- @param value number The int value
    @side(shared)
    function SetParameterInt(parameter: string, value: number): nil
    --- Sets a boolean parameter in this Particle System
    --- @param parameter string The parameter name
    --- @param value boolean The boolean value
    @side(shared)
    function SetParameterBool(parameter: string, value: boolean): nil
    --- Sets a Vector parameter in this Particle System
    --- @param parameter string The parameter name
    --- @param value Vector The Vector value
    @side(shared)
    function SetParameterVector(parameter: string, value: Vector): nil
    --- Sets a Color parameter in this Particle System
    --- @param parameter string The parameter name
    --- @param value Color The Color value
    @side(shared)
    function SetParameterColor(parameter: string, value: Color): nil
    --- Sets a Material parameter in this Particle System
    --- @param parameter string The parameter name
    --- @param value string The Material to apply. Note: the material needs to be configured to be "Used with Niagara" or "Used with Particles" in the material asset settings, otherwise it may not be applied correctly
    @side(shared)
    function SetParameterMaterial(parameter: string, value: string): nil
    --- Sets a Material from a Texture parameter in this Particle System
    --- @param parameter string The parameter name
    --- @param value string The Texture value
    @side(client)
    function SetParameterMaterialFromTexture(parameter: string, value: string): nil
    --- Sets a Material from a Canvas parameter in this Particle System
    --- @param parameter string The parameter name
    --- @param value Canvas The Canvas value
    @side(client)
    function SetParameterMaterialFromCanvas(parameter: string, value: Canvas): nil
    --- Sets a Material from a Canvas parameter in this Particle System
    --- @param parameter string The parameter name
    --- @param value WebUI The WebUI value
    @side(client)
    function SetParameterMaterialFromWebUI(parameter: string, value: WebUI): nil
end

--- Players are Entities that represents the individual behind the mouse and keyboard. Players are spawned automatically when connected to the server.
declare class Player extends Entity
    --- Bans the player from the server
    --- @param reason string The reason shown to the Player
    @side(server)
    function Ban(reason: string): nil
    --- Redirects the player to another server
    --- @param ip string The server address to connect to, in the format `IP:PORT`
    --- @param password string Server password
    @side(server)
    function Connect(ip: string, password: string?): nil
    --- Kicks the player from the server
    --- @param reason string The reason shown to the Player
    @side(server)
    function Kick(reason: string): nil
    --- Makes this Player possess and control a Pawn (Character)
    --- @param new_pawn Pawn The Pawn to possess
    --- @param blend_time number Seconds to smoothly blend the camera to the new Pawn
    --- @param exp number Exponent used to smooth the blend, use 0 for linear
    @side(server)
    function Possess(new_pawn: Pawn, blend_time: number?, exp: number?): nil
    --- Does a camera fade to/from a solid color
    --- @param from_alpha number Alpha at which to begin the fade. Range [0..1], where 0 is fully transparent and 1 is fully opaque solid color.
    --- @param to_alpha number Alpha at which to finish the fade.
    --- @param duration number How long the fade should take, in seconds.
    --- @param to_color Color Color to fade to/from.
    --- @param should_fade_audio boolean True to fade audio volume along with the alpha of the solid color.
    --- @param hold_when_finished boolean True for fade to hold at the ToAlpha until explicitly stopped (e.g. with StopCameraFade)
    @side(shared)
    function StartCameraFade(from_alpha: number, to_alpha: number, duration: number, to_color: Color, should_fade_audio: boolean?, hold_when_finished: boolean?): nil
    --- Turns on camera fading at the given opacity
    --- @param in_fade_amount number Range [0..1], where 0 is fully transparent and 1 is fully opaque solid color.
    --- @param color Color The color to use
    --- @param in_fade_audio boolean Whether to fade the audio as well
    @side(shared)
    function SetManualCameraFade(in_fade_amount: number, color: Color, in_fade_audio: boolean): nil
    --- Stops camera fading.
    @side(shared)
    function StopCameraFade(): nil
    --- Sets the Player's Camera Location (only works if not possessing any Character)
    --- @param location Vector The new Player's Camera Location
    @side(shared)
    function SetCameraLocation(location: Vector): nil
    --- Sets the Player's Camera Rotation
    --- @param rotation Rotator The new Player's Camera Rotation
    @side(shared)
    function SetCameraRotation(rotation: Rotator): nil
    --- Smoothly moves the Player's Camera Location (only works if not possessing any Character)
    --- @param location Vector The target camera location
    --- @param time number Seconds to reach the target
    --- @param exp number Exponential used to smooth interp, use 0 for linear movement
    @side(shared)
    function TranslateCameraTo(location: Vector, time: number, exp: number?): nil
    --- Smoothly moves the Player's Camera Rotation
    --- @param rotation Rotator The target camera rotation
    --- @param time number Seconds to reach the target
    --- @param exp number Exponential used to smooth interp, use 0 for linear movement
    @side(shared)
    function RotateCameraTo(rotation: Rotator, time: number, exp: number?): nil
    --- Sets the Player's Camera Socket Offset (Spring Arm Offset)
    --- @param socket_offset Vector The new Player's Camera Socket Offset
    @side(shared)
    function SetCameraSocketOffset(socket_offset: Vector): nil
    --- Sets the Player's Camera Arm Length (Spring Arm length)
    --- @param length number Length of the camera spring arm, in units
    --- @param force boolean Whether to bypass interpolation and set the target to its value directly
    @side(shared)
    function SetCameraArmLength(length: number, force: boolean?): nil
    --- Sets the Player's Camera FOV (if not possessing a Character)
    --- @param fov number Value must be between 5 and 170. Pass empty to reset to default.
    @side(shared)
    function SetCameraFOV(fov: number?): nil
    --- Sets the Player's Camera Speed Settings (if not possessing a Character)
    --- @param max_speed number Maximum velocity magnitude allowed
    --- @param acceleration number Acceleration applied by input (rate of change of velocity)
    --- @param deceleration number Deceleration applied when there is no input (rate of change of velocity)
    --- @param turning_boost number Setting affecting extra force applied when changing direction, making turns have less drift and become more responsive. Velocity magnitude is not allowed to increase, that only happens due to normal acceleration. It may decrease with large direction changes. Larger values apply extra force to reach the target direction more quickly, while a zero value disables any extra turn force.
    @side(shared)
    function SetCameraSpeedSettings(max_speed: number?, acceleration: number?, deceleration: number?, turning_boost: number?): nil
    --- Attaches the Player's Camera to an Actor
    --- @param actor Actor The Actor to attach the camera to
    --- @param socket_offset Vector Offset of the camera relative to the Actor
    --- @param blend_speed number Speed of the camera blend, 0 to snap immediately
    @side(shared)
    function AttachCameraTo(actor: Actor, socket_offset: Vector?, blend_speed: number?): nil
    --- Resets the Camera to default state (Unspectate and Detaches)
    @side(shared)
    function ResetCamera(): nil
    --- Makes this Player spectate another Player
    --- @param player Player The Player
    --- @param blend_speed number Speed of the camera blend, 0 to snap immediately
    @side(shared)
    function Spectate(player: Player, blend_speed: number?): nil
    --- Sets the player's name
    --- @param player_name string The new player's name
    @side(server)
    function SetName(player_name: string): nil
    --- Sets the VOIP setting for a specific global channel
    --- @param channel number Channel number, from 1 to 63
    --- @param setting VOIPSetting Whether this Player listens, speaks, both or none on this channel
    @side(server)
    function SetVOIPGlobalChannelSetting(channel: number, setting: VOIPSetting): nil
    --- Sets the VOIP setting for all global channels
    --- @param setting VOIPSetting The new VOIP setting for all global channels
    @side(server)
    function SetVOIPGlobalAllChannelsSetting(setting: VOIPSetting): nil
    --- Sets the VOIP setting for the local/proximity
    --- @param setting VOIPSetting The new VOIP setting for the local/proximity
    @side(server)
    function SetVOIPLocalSetting(setting: VOIPSetting): nil
    --- Sets the local/proximity VOIP max distance. This also affects networking usage
    --- @param max_distance number Falloff Distance. Default is 3600
    @side(shared)
    function SetVOIPLocalMaxDistance(max_distance: number): nil
    --- Sets the local/proximity VOIP input/output volume. It only affects the local/proximity channel
    --- @param volume number The new local/proximity VOIP input/output volume. It only affects the local/proximity channel
    @side(shared)
    function SetVOIPLocalVolume(volume: number): nil
    --- Sets the global VOIP volume. It only affects the global channels
    --- @param volume number The new global VOIP volume. It only affects the global channels
    @side(shared)
    function SetVOIPGlobalVolume(volume: number): nil
    --- Sets the global VOIP high-pass filter threshold frequency
    --- @param threshold number The new global VOIP high-pass filter threshold frequency
    @side(shared)
    function SetVOIPGlobalHighPassFilter(threshold: number): nil
    --- Sets the global VOIP low-pass filter threshold frequency
    --- @param threshold number The new global VOIP low-pass filter threshold frequency
    @side(shared)
    function SetVOIPGlobalLowPassFilter(threshold: number): nil
    --- Mutes or unmutes VOIP for this player
    --- @param is_muted boolean Whether VOIP is muted
    @side(shared)
    function SetVOIPMuted(is_muted: boolean): nil
    --- Returns whether VOIP is muted for this player
    --- @return boolean Whether VOIP is muted for this player
    @side(shared)
    function IsVOIPMuted(): boolean
    --- Release the Player from the Character
    @side(server)
    function UnPossess(): nil
    --- Gets the Player's Steam ID
    --- @return string The Steam ID (SteamID64)
    @side(shared)
    function GetSteamID(): string
    --- Gets the Player's nanos world account ID
    --- @return string The nanos world account ID
    @side(shared)
    function GetAccountID(): string
    --- Gets the Player's nanos world account name
    --- @return string The account name
    @side(shared)
    function GetAccountName(): string
    --- Return a URL which can be used through WebUI and Widgets to display the Player's Steam Avatar (64x64)
    --- @return string URL of the Steam avatar image
    @side(shared)
    function GetAccountIconURL(): string
    --- Gets the location of the Player's camera
    --- @return Vector The camera location
    @side(client)
    function GetCameraLocation(): Vector
    --- Gets the Player's camera arm (spring arm) length
    --- @param return_base boolean Whether to return the current (false) or base (true) value. The base is the same value set by SetCameraArmLength(). Use base if you want to get the original value set by SetCameraArmLength() and not the current (interpolated) value.
    --- @return number The camera arm length, in units
    @side(client)
    function GetCameraArmLength(return_base: boolean?): number
    --- Gets the rotation of the Player's camera
    --- @return Rotator The camera rotation
    @side(client)
    function GetCameraRotation(): Rotator
    --- Gets the Pawn (Character) this Player is currently possessing
    --- @return Pawn? The possessed Pawn, or nil if not possessing any
    @side(shared)
    function GetControlledCharacter(): Pawn?
    --- Gets the Player's IP address
    --- @return string The IP address
    @side(server)
    function GetIP(): string
    --- Gets this Player's dimension
    --- @return number This Player's dimension
    @side(shared)
    function GetDimension(): number
    --- Sets the multiplier for how much this Player's is affected by distance optimization from other actors
    --- @param multiplier number The new multiplier for how much this Player's is affected by distance optimization from other actors
    @side(server)
    function SetDistanceOptimizationMultiplier(multiplier: number): nil
    --- Sets this Player's dimension
    --- @param dimension number The new dimension
    @side(server)
    function SetDimension(dimension: number): nil
    --- Gets the Player's name
    --- @return string The Player's name
    @side(shared)
    function GetName(): string
    --- Gets the Player's ping
    --- @return number The ping, in milliseconds
    @side(shared)
    function GetPing(): number
    --- Returns a list of VOIP channels this player is listening to
    --- @return number[] list of channel indexes
    @side(shared)
    function GetVOIPListeningChannels(): number[]
    --- Returns a list of VOIP channels this player is currently speaking to
    --- @return number[] list of channel indexes
    @side(shared)
    function GetVOIPSpeakingChannels(): number[]
    --- Gets if this Player is the host of a P2P (listen) server
    --- @return boolean Whether this Player is the host
    @side(client)
    function IsHost(): boolean
    --- Gets if this Player is the local Player (the one running this client)
    --- @return boolean Whether this is the local Player
    @side(client)
    function IsLocalPlayer(): boolean
    --- Retrieves a player by their Steam ID
    --- @param steam_id string The Steam ID (SteamID64) to look for
    --- @return Player? Player by their Steam ID
    @side(server)
    static function GetBySteamID(steam_id: string): Player?
end

--- A Prop represents a Dynamic Mesh which can be spawned in the world, can be grabbed around by characters and have physics.
@overrideCtor("$class($args)")
declare class Prop extends Entity implements Actor, Paintable
    constructor(location: Vector, rotation: Rotator, asset: string, collision_type: CollisionType?, gravity_enabled: boolean?, grab_mode: GrabMode?, ccd_mode: CCDMode?, spawn_mode: SpawnMode?)
    --- Sets ability to Characters to Grab this Prop
    --- @param grab_mode GrabMode If the Prop will be able to be grabbable or not. Set to Auto to automatically define based on Prop's size.
    @side(server)
    function SetGrabMode(grab_mode: GrabMode): nil
    --- Sets the interaction tooltip text shown when a Character interacts with this Prop
    --- @param tool_tip_text string Text to show in the interaction tooltip
    @side(client)
    function SetInteractionToolTipText(tool_tip_text: string): nil
    --- Sets the Physics damping of this Prop
    --- @param linear_damping number Linear damping value
    --- @param angular_damping number Angular damping value
    function SetPhysicsDamping(linear_damping: number, angular_damping: number): nil
    --- Changes the mesh in runtime
    --- @param asset string asset
    function SetMesh(asset: string): nil
    --- Gets the Asset name
    --- @return string asset name
    @side(shared)
    function GetMesh(): string
    --- Gets the Character (if existing) which is holding this
    --- @return Character? the character that holds the object
    @side(shared)
    function GetHandler(): Character?
    --- Gets ability to Grab this Prop
    --- @return GrabMode Ability to Grab this Prop
    @side(shared)
    function GetGrabMode(): GrabMode
    --- Override the mass (in Kg) of this Prop
    --- @param mass number Mass in KG to override. Pass -1 to reset to default
    function SetMassOverride(mass: number): nil
    --- Gets the overridden mass
    --- @return number The overridden mass
    @side(shared)
    function GetMassOverride(): number
    --- Change the mass scale used to calculate the mass of this Prop
    --- @param scale number The new mass scale used to calculate the mass of this Prop
    function SetMassScale(scale: number): nil
    --- Gets the mass scale
    --- @return number The mass scale
    @side(shared)
    function GetMassScale(): number
    --- Sets the Buoyancy Pontoons used by the Water simulation
    --- @param pontoons any Array with the Pontoons, or nil to restore the automatically calculated ones
    function SetBuoyancyPontoons(pontoons: any?): nil
    --- Sets how this entity behaves on Water
    --- @param enabled boolean Whether Buoyancy forces are applied at all
    --- @param buoyancy_coefficient number How much it floats, the higher the more
    --- @param buoyancy_damp number First order damping on the vertical velocity, reduces bobbing
    --- @param max_buoyant_force number Clamp on the upwards force, stops light objects being launched out of the water
    function SetBuoyancySettings(enabled: boolean?, buoyancy_coefficient: number?, buoyancy_damp: number?, max_buoyant_force: number?): nil
end

--- Scene Capture is an Actor which captures a fully dynamic image of the scene into a Texture. It captures the scene from its view frustum, stores that view as an image, which is then used within a Material.
@overrideCtor("$class($args)")
@side(client)
declare class SceneCapture extends Entity implements Actor
    constructor(location: Vector?, rotation: Rotator?, width: number?, height: number?, render_rate: number?, view_distance: number?, fov_angle: number?, enable_distance_optimization: boolean?)
    --- Adds an Actor to the Render Only list
    --- @param actor Actor The Actor to render
    @side(client)
    function AddRenderActor(actor: Actor): nil
    --- Removes an Actor from the Render Only list
    --- @param actor Actor The Actor to stop rendering
    @side(client)
    function RemoveRenderActor(actor: Actor): nil
    --- Clears the Render Only list
    @side(client)
    function ClearRenderActors(): nil
    --- Stops or resumes capturing
    --- @param freeze boolean Whether to stop capturing
    @side(client)
    function SetFreeze(freeze: boolean): nil
    --- Takes a snapshot of the SceneCapture and returns a Base64 of it
    --- @param image_format ImageFormat Which format to generate - JPEG is fastest but discards Alpha channel
    --- @return string The snapshot as a Base64 string
    @side(client)
    function EncodeToBase64(image_format: ImageFormat?): string
    --- Takes a snapshot of the SceneCapture and returns a Base64 of it (asynchronously)
    --- @param image_format ImageFormat Which format to generate - JPEG is fastest but discards Alpha channel
    --- @param callback any Callback
    @side(client)
    function EncodeToBase64Async(image_format: ImageFormat?, callback: any): nil
    --- Sets the FOV
    --- @param angle number The new FOV
    @side(client)
    function SetFOVAngle(angle: number): nil
    --- Enables/Disables rendering features from being captured
    --- @param flag string Name of the Unreal Show Flag, e.g. `Fog`
    --- @param enable boolean Whether it is rendered
    @side(client)
    function SetShowFlag(flag: string, enable: boolean): nil
    --- Change the output Texture size
    --- Note: too high texture will make the capture slower and will affect game performance
    --- @param width number Width in pixels
    --- @param height number Height in pixels
    @side(client)
    function Resize(width: number, height: number): nil
    --- Set how frequent is the capture
    --- Note: Set to 0 to capture every frame, or -1 to disable auto-capturing
    --- @param render_rate number Seconds between captures, 0 for every frame or -1 to disable automatic capture
    @side(client)
    function SetRenderRate(render_rate: number): nil
    --- Enables or not the rendering frequency optimization if the entities with this Material are too far
    --- @param enabled boolean Whether to enable or not the rendering frequency optimization if the entities with this Material are too far
    @side(client)
    function SetDistanceOptimizationEnabled(enabled: boolean): nil
    --- Captures the scene. If deferred is true, performs deferred capture and records the frame; otherwise captures immediately and triggers Capture event
    --- @param deferred boolean If true, performs deferred capture (will capture and trigger Capture event later)
    @side(client)
    function CaptureScene(deferred: boolean?): nil
end

--- A StaticMesh entity represents a Mesh which can be spawned in the world, can't move and is more optimized for using in decorating the world.
@overrideCtor("$class($args)")
declare class StaticMesh extends Entity implements Actor, Paintable
    constructor(location: Vector, rotation: Rotator, static_mesh_asset: string, collision_type: CollisionType?, spawn_mode: SpawnMode?)
    --- Changes the mesh in runtime
    --- @param static_mesh_asset string asset
    function SetMesh(static_mesh_asset: string): nil
    --- Gets the Asset path mesh used
    --- @return string asset path
    @side(shared)
    function GetMesh(): string
    --- Gets if this StaticMesh is from the Level
    --- @return boolean if this StaticMesh is from the level
    @side(client)
    function IsFromLevel(): boolean
end

--- Class for playing in-game 2D and 3D sounds.
@overrideCtor("$class($args)")
@side(client)
declare class Sound extends Entity implements Actor
    constructor(location: Vector, asset: string, is_2d_sound: boolean?, auto_destroy: boolean?, sound_type: SoundType?, volume: number?, pitch: number?, inner_radius: number?, falloff_distance: number?, attenuation_function: AttenuationFunction?, keep_playing_when_silent: boolean?, loop_mode: SoundLoopMode?, auto_play: boolean?)
    --- Plays the sound with a fade effect
    --- @param fade_in_duration number Seconds to fade in
    --- @param fade_volume_level number Volume multiplier to fade to
    --- @param start_time number Seconds into the sound to start playing from
    @side(client)
    function FadeIn(fade_in_duration: number, fade_volume_level: number?, start_time: number?): nil
    --- Stops the sound with a fade effect
    --- @param fade_out_duration number Seconds to fade out
    --- @param fade_volume_level number Volume multiplier to fade to
    --- @param destroy_after_fadeout boolean Whether to destroy the Sound after fading out
    @side(client)
    function FadeOut(fade_out_duration: number, fade_volume_level: number?, destroy_after_fadeout: boolean?): nil
    --- Starts the sound
    --- @param start_time number Seconds into the sound to start playing from
    @side(client)
    function Play(start_time: number?): nil
    --- If a 3D Sound, sets the distance which the sound is inaudible
    --- @param falloff_distance number Distance from the inner radius at which the sound becomes inaudible
    @side(client)
    function SetFalloffDistance(falloff_distance: number): nil
    --- If a 3D Sound, sets the radius within which the volume is 100%
    --- @param inner_radius number Radius within which the volume is 100%
    @side(client)
    function SetInnerRadius(inner_radius: number): nil
    --- Sets low-pass filter frequency. Sets 0 to disable it.
    --- @param frequency number The new low-pass filter frequency. Sets 0 to disable it
    @side(client)
    function SetLowPassFilter(frequency: number): nil
    --- Pauses or resumes the sound
    --- @param pause boolean Whether to pause (true) or resume (false)
    @side(client)
    function SetPaused(pause: boolean?): nil
    --- Sets the Sound's pitch
    --- @param new_pitch number The new Sound's pitch
    @side(client)
    function SetPitch(new_pitch: number): nil
    --- Sets the Sound's volume
    --- @param new_volume number Volume multiplier, 1 is the original volume
    @side(client)
    function SetVolume(new_volume: number): nil
    --- Stops the sound
    @side(client)
    function Stop(): nil
    --- Stops the sound after the provided delay
    --- @param delay number Seconds to wait before stopping
    @side(client)
    function StopDelayed(delay: number): nil
    --- Gets if the sound is 2D
    --- @return boolean Whether the sound is 2D
    @side(client)
    function Is2D(): boolean
    --- Gets if the sound is playing
    --- @return boolean Whether the sound is playing
    @side(client)
    function IsPlaying(): boolean
    --- Gets the duration of the Sound
    --- @return number Duration of the Sound
    @side(client)
    function GetDuration(): number
    --- Gets the pitch multiplier
    --- @return number The pitch multiplier
    @side(client)
    function GetPitch(): number
    --- Gets the volume multiplier
    --- @return number The volume multiplier
    @side(client)
    function GetVolume(): number
    --- Gets the low pass filter frequency
    --- @return number The low pass filter frequency
    @side(client)
    function GetLowPassFilter(): number
    --- Gets the radius within which the volume is 100%
    --- @return number The inner radius
    @side(client)
    function GetInnerRadius(): number
    --- Gets the distance at which the sound becomes inaudible
    --- @return number The falloff distance
    @side(client)
    function GetFalloffDistance(): number
    --- Gets the Sound Type, used to apply the user's volume settings
    --- @return SoundType The Sound Type
    @side(client)
    function GetSoundType(): SoundType
    --- Gets the asset path of this Sound
    --- @return string The asset path
    @side(client)
    function GetPath(): string
end

--- A Text Render class is useful for spawning Texts in 3D world.
@overrideCtor("$class($args)")
@side(shared)
declare class TextRender extends Entity implements Actor
    constructor(location: Vector, rotation: Rotator, text: string, word_size: number?, color: Color?, rendering_type: TextRenderRenderingType?, horizontal_alignment: TextRenderHorizontalAlignment?, vertical_alignment: TextRenderVerticalAlignment?, font_asset: string?, cast_shadow: boolean?)
    --- Gets the current Text
    --- @return string The current Text
    @side(shared)
    function GetText(): string
    --- Gets the current Text Color
    --- @return Color The current Text Color
    @side(shared)
    function GetColor(): Color
    --- Gets the current Word Size
    --- @return number The current Word Size
    @side(shared)
    function GetWordSize(): number
    --- Sets the Font. The font must be pre-cooked as an offline cached, distance field font.
    --- @param font_asset string The new Font. The font must be pre-cooked as an offline cached, distance field font
    @side(shared)
    function SetFont(font_asset: string): nil
    --- Sets the Text alignment
    --- @param horizontal_alignment TextRenderHorizontalAlignment Horizontal alignment of the text
    --- @param vertical_alignment TextRenderVerticalAlignment Vertical alignment of the text
    @side(shared)
    function SetAlignment(horizontal_alignment: TextRenderHorizontalAlignment, vertical_alignment: TextRenderVerticalAlignment): nil
    --- Sets the horizontal and vertical spacing adjust values
    --- @param horizontal_spacing number Extra horizontal spacing between characters
    --- @param vertical_spacing number Extra vertical spacing between lines
    @side(shared)
    function SetSpacingAdjust(horizontal_spacing: number, vertical_spacing: number): nil
    --- Sets the Text
    --- @param text string The new Text
    @side(shared)
    function SetText(text: string): nil
    --- Sets the Text Color
    --- @param color Color The new Text Color
    @side(shared)
    function SetColor(color: Color): nil
    --- Sets the Word Size
    --- @param word_size number The new Word Size
    @side(shared)
    function SetWordSize(word_size: number): nil
end

--- Class to create 3D Text with advanced options
@overrideCtor("$class($args)")
@side(shared)
declare class Text3D extends Entity implements Actor, Paintable
    constructor(location: Vector, rotation: Rotator, text: string, scale: Vector?, color: Color?, font_type: FontType?, align_camera: Text3DAlignCamera?)
    --- Sets the Font
    --- @param font_type FontType The new Font
    @side(shared)
    function SetFont(font_type: FontType): nil
    --- Sets the Glyph representation settings to generate the 3D Mesh for this text render
    --- @param extrude number Depth of the 3D letters
    --- @param level number Size of the bevel
    --- @param bevel_type Text3DBevelType Shape of the bevel
    --- @param bevel_segments number Number of segments of the bevel, more looks smoother
    --- @param outline boolean Whether to only generate the outline of the letters
    @side(shared)
    function SetGlyphSettings(extrude: number?, level: number?, bevel_type: Text3DBevelType?, bevel_segments: number?, outline: boolean?): nil
    --- Sets the Max Size of the Text3D, optionally scaling it proportionally
    --- @param max_width number Max width of the text, 0 for no limit
    --- @param max_height number Max height of the text, 0 for no limit
    --- @param scale_proportionally boolean Whether to keep the aspect ratio when scaling down
    @side(shared)
    function SetMaxSize(max_width: number?, max_height: number?, scale_proportionally: boolean?): nil
    --- Sets the Text
    --- @param text string The new Text
    @side(shared)
    function SetText(text: string): nil
    --- Sets the Text & Font settings for this text render
    --- @param kerning number Extra spacing between characters
    --- @param line_spacing number Extra spacing between lines
    --- @param word_spacing number Extra spacing between words
    --- @param horizontal_alignment Text3DHorizontalAlignment Horizontal alignment of the text
    --- @param vertical_alignment Text3DVerticalAlignment Vertical alignment of the text
    @side(shared)
    function SetTextSettings(kerning: number?, line_spacing: number?, word_spacing: number?, horizontal_alignment: Text3DHorizontalAlignment?, vertical_alignment: Text3DVerticalAlignment?): nil
end

--- A Trigger class is a utility class to trigger events when any Entity enters an Area.
@overrideCtor("$class($args)")
declare class Trigger extends Entity implements Actor
    constructor(location: Vector, rotation: Rotator, extent: Vector | number, trigger_type: TriggerType?, is_visible: boolean?, color: Color?, overlap_only_classes: string[]?)
    --- Forces an Overlap check to occur, will immediately trigger overlaps
    function ForceOverlapChecking(): nil
    --- Sets the extent size of this trigger (sphere triggers can receive as float for radius)
    --- @param extent Vector | number The new extent size of this trigger
    function SetExtent(extent: Vector | number): nil
    --- Sets the Trigger color (if visible)
    --- @param color Color The new Trigger color
    @side(shared)
    function SetColor(color: Color): nil
    --- Sets the filter to Trigger to only overlap specific Classes. Leave it empty for all Classes
    --- @param overlap_only_classes string[] The new filter to Trigger to only overlap specific Classes. Leave it empty for all Classes
    function SetOverlapOnlyClasses(overlap_only_classes: string[]): nil
end

--- Vehicles are wheeled entities which Characters can possess and drive.
@overrideCtor("$class($args)")
declare class VehicleWheeled extends Entity implements Actor, Paintable, Damageable, Vehicle
    constructor(location: Vector, rotation: Rotator, asset: string, collision_type: CollisionType?, gravity_enabled: boolean?, auto_unflip: boolean?, engine_sound: string?, horn_sound: string?, brake_sound: string?, engine_start_sound: string?, vehicle_door_sound: string?, auto_start_engine: boolean?, custom_animation_blueprint: string?, spawn_mode: SpawnMode?)
    --- Starts or stops the vehicle horn
    --- @param enable_horn boolean Whether to honk
    @side(server)
    function Horn(enable_horn: boolean): nil
    --- Sets the sound asset used by the vehicle horn
    --- @param sound_asset string The new sound asset used by the vehicle horn
    @side(server)
    function SetHornSound(sound_asset: string): nil
    --- Sets if the Engine auto starts when the driver enters the Vehicle
    --- @param auto_start boolean Whether the Engine auto starts when the driver enters the Vehicle
    @side(server)
    function SetAutoStartEngine(auto_start: boolean): nil
    --- Sets if the Engine is turned off/on
    --- @param started boolean Whether the Engine is turned off/on
    @side(server)
    function SetEngineStarted(started: boolean): nil
    --- Configures the Vehicle Steering
    --- @param steering_type SteeringType Type of steering to use. Default is SteeringType.AngleRatio
    --- @param angle_ratio number Only applies when SteeringType.AngleRatio is selected
    --- @param steering_curve any Maximum steering versus forward speed (MPH)
    @side(server)
    function SetSteeringSetup(steering_type: SteeringType, angle_ratio: number?, steering_curve: any?): nil
    --- Configures the Vehicle Engine (Torque, RPM, Braking)
    --- @param max_torque number Max Engine Torque (Nm) is multiplied by TorqueCurve
    --- @param max_rpm number Maximum revolutions per minute of the engine
    --- @param idle_rpm number Idle RMP of engine then in neutral/stationary
    --- @param brake_effect number Braking effect from engine, when throttle released
    --- @param rev_up_moi number Affects how fast the engine RPM speed up
    --- @param rev_down_rate number Affects how fast the engine RPM slows down
    --- @param torque_curve any Map defining the torque [Normalized 0..1] for a given RPM
    @side(server)
    function SetEngineSetup(max_torque: number?, max_rpm: number?, idle_rpm: number?, brake_effect: number?, rev_up_moi: number?, rev_down_rate: number?, torque_curve: any?): nil
    --- Configures the Vehicle Aerodynamics Settings
    --- @param mass number Mass of the vehicle chassis
    --- @param drag_coefficient number Force resisting forward motion at speed
    --- @param vehicle_chassis_width number Chassis width used for drag force computation (cm)
    --- @param vehicle_chassis_height number Chassis height used for drag force computation (cm)
    --- @param vehicle_downforce_coefficient number Force pressing vehicle into ground at speed
    --- @param center_of_mass_override Vector Overrides the center of mass. Good for curves stabilization. Ideally the Z should be the same as the wheels radius
    @side(server)
    function SetAerodynamicsSetup(mass: number?, drag_coefficient: number?, vehicle_chassis_width: number?, vehicle_chassis_height: number?, vehicle_downforce_coefficient: number?, center_of_mass_override: Vector?): nil
    --- Configures the Vehicle Transmission
    --- @param transmission_final_ratio number The final gear ratio multiplies the transmission gear ratios
    --- @param transmission_change_up_rpm number Engine Revs at which gear up change occurs
    --- @param transmission_change_down_rpm number Engine Revs at which gear down change occurs
    --- @param transmission_gear_change_time number Time it takes to switch gears (seconds)
    --- @param transmission_efficiency number Mechanical frictional losses mean transmission might operate at 0.94 (94% efficiency)
    --- @param forward_gear_ratios number[] List of forward gear ratios
    --- @param reverse_gear_ratios number[] List of reverse gear ratios
    @side(server)
    function SetTransmissionSetup(transmission_final_ratio: number?, transmission_change_up_rpm: number?, transmission_change_down_rpm: number?, transmission_gear_change_time: number?, transmission_efficiency: number?, forward_gear_ratios: number[]?, reverse_gear_ratios: number[]?): nil
    --- Configures a Vehicle Wheel
    --- @param index number Index of the wheel (0-N). Set it in ASC order
    --- @param bone_name string Name of the bone to attach this wheel to
    --- @param radius number Radius of the wheel
    --- @param width number Width of the wheel
    --- @param max_steer_angle number Steer angle in degrees for this wheel
    --- @param offset Vector If bone_name is specified, offset the wheel from the bone's location. Otherwise this offsets the wheel from the vehicle's origin
    --- @param is_affected_by_engine boolean Whether engine should power this wheel
    --- @param is_affected_by_brake boolean Whether brake should affect this wheel
    --- @param is_affected_by_handbrake boolean Whether handbrake should affect this wheel
    --- @param has_abs_enabled boolean Advanced Braking System Enabled
    --- @param has_traction_control_enabled boolean Straight Line Traction Control Enabled
    --- @param max_brake_torque number Max brake torque for this wheel (Nm)
    --- @param max_handbrake_torque number Max handbrake brake torque for this wheel (Nm). A handbrake should have a stronger brake torque than the brake
    --- @param cornering_stiffness number Tyre Cornering Ability
    --- @param side_slip_modifier number Wheel Lateral Skid Grip Loss, lower number less grip on skid
    --- @param friction_force_multiplier number Friction Force Multiplier
    --- @param slip_threshold number Wheel Longitudinal Slip Threshold
    --- @param skid_threshold number Wheel Lateral Skid Threshold
    --- @param suspension_spring_rate number Spring Force (N/m)
    --- @param suspension_spring_preload number Spring Preload (N/m)
    --- @param suspension_max_raise number How far the wheel can go above the resting position
    --- @param suspension_max_drop number How far the wheel can drop below the resting position
    --- @param suspension_smoothing number Smooth suspension [0-off, 10-max] - Warning might cause momentary visual inter-penetration of the wheel against objects/terrain
    --- @param suspension_damping_ratio number Suspension damping, larger value causes the suspension to come to rest faster [range 0 to 1]
    --- @param suspension_wheel_load_ratio number Amount wheel load effects wheel friction.   - At 0 wheel friction is completely independent of the loading on the wheel (This is artificial as it always assumes even balance between all wheels)   - At 1 wheel friction is based on the force pressing wheel into the ground. This is more realistic.   - Lower value cures lift off over-steer, generally makes vehicle easier to handle under extreme motions.
    --- @param suspension_axis Vector Local body direction in which where suspension forces are applied (typically along -Z-axis)
    --- @param suspension_force_offset Vector Vertical offset from where suspension forces are applied (along Z-axis)
    --- @param suspension_sweep_shape SuspensionSweepShape Wheel suspension trace type, defaults to ray trace
    @side(server)
    function SetWheel(index: number, bone_name: string, radius: number?, width: number?, max_steer_angle: number?, offset: Vector?, is_affected_by_engine: boolean?, is_affected_by_brake: boolean?, is_affected_by_handbrake: boolean?, has_abs_enabled: boolean?, has_traction_control_enabled: boolean?, max_brake_torque: number?, max_handbrake_torque: number?, cornering_stiffness: number?, side_slip_modifier: number?, friction_force_multiplier: number?, slip_threshold: number?, skid_threshold: number?, suspension_spring_rate: number?, suspension_spring_preload: number?, suspension_max_raise: number?, suspension_max_drop: number?, suspension_smoothing: number?, suspension_damping_ratio: number?, suspension_wheel_load_ratio: number?, suspension_axis: Vector?, suspension_force_offset: Vector?, suspension_sweep_shape: SuspensionSweepShape?): nil
    --- Configures the type of Differential
    --- @param differential_type DifferentialType Type of Differential
    --- @param front_rear_split number Ratio of torque split between front and rear (less than 0.5 means more to front, bigger than 0.5 means more to rear, works only with 4W type)
    @side(server)
    function SetDifferentialSetup(differential_type: DifferentialType, front_rear_split: number?): nil
    --- Configures where the Steering Wheel is located
    --- @param relative_location Vector Relative location of the steering wheel from the vehicle's origin
    --- @param radius number Radius of the steering wheel to align the hands properly
    --- @param rotation Rotator Rotation of the steering wheel to align the hands properly
    @side(server)
    function SetSteeringWheelSetup(relative_location: Vector, radius: number, rotation: Rotator?): nil
    --- Configures the Headlights offset and color
    --- @param location Vector Offset of the headlights relative to the vehicle
    --- @param color Color The color to use
    @side(server)
    function SetHeadlightsSetup(location: Vector, color: Color?): nil
    --- Configures the Taillights offset
    --- @param location Vector Offset of the taillights relative to the vehicle
    @side(server)
    function SetTaillightsSetup(location: Vector): nil
    --- Enables or disables the headlights
    --- @param is_enabled boolean Whether the headlights are on
    @side(server)
    function SetHeadlightsEnabled(is_enabled: boolean): nil
    --- Enables or disables the taillights
    --- @param is_enabled boolean Whether the taillights are on
    @side(server)
    function SetTaillightsEnabled(is_enabled: boolean): nil
    --- Sets a Tire as Flat or not
    --- @param wheel_index number Index of the wheel
    --- @param is_flat boolean Whether the tire is flat
    @side(server)
    function SetTireFlat(wheel_index: number, is_flat: boolean): nil
    --- Gets the current RPM
    --- @return number Current RPM
    @side(client)
    function GetRPM(): number
    --- Gets the current Gear
    --- @return number Current Gear
    @side(client)
    function GetGear(): number
    --- Checks if the vehicle is in the air (no wheels touching the ground)
    --- @return boolean Whether the vehicle is in the air
    @side(client)
    function IsInAir(): boolean
end

--- VehicleWater are entities which Characters can possess and drive over the water with dynamic physics.
@overrideCtor("$class($args)")
@side(server)
declare class VehicleWater extends Entity implements Actor, Paintable, Damageable, Vehicle
    constructor(location: Vector, rotation: Rotator, asset: string, collision_type: CollisionType?, gravity_enabled: boolean?, spawn_mode: SpawnMode?)
    --- Sets the relative location of the Engine (where the Physics Thruster, sounds and effects are attached)
    --- @param offset Vector The new relative location of the Engine
    @side(server)
    function SetEngineOffset(offset: Vector): nil
    --- Sets the force of the Engine/Thruster
    --- @param force number The new force of the Engine/Thruster
    @side(server)
    function SetThrustStrength(force: number): nil
end

--- Weapons are entities with firing, reloading and aiming functionalities.
--- 
--- They are fully customizable, all pieces of the weapon can be changed with immense possibility of creation.
@overrideCtor("$class($args)")
declare class Weapon extends Entity implements Actor, Paintable, Pickable
    constructor(location: Vector, rotation: Rotator, asset: string, collision_type: CollisionType?, gravity_enabled: boolean?, spawn_mode: SpawnMode?)
    --- Forces this Weapon to reload
    @side(server)
    function Reload(): nil
    --- Sets this Weapon's Ammo in the Bag
    --- @param new_ammo_bag number The new Ammo in the Bag
    @side(server)
    function SetAmmoBag(new_ammo_bag: number): nil
    --- Sets this Weapon's Ammo in the Clip
    --- @param new_ammo_clip number The new Ammo in the Clip
    @side(server)
    function SetAmmoClip(new_ammo_clip: number): nil
    --- Sets the ammo counts and the clip capacity at once
    --- @param ammo_clip number Bullets currently loaded in the clip
    --- @param ammo_bag number Spare bullets carried, used when reloading
    --- @param ammo_to_reload number Bullets loaded on each reload, useful for shotguns that load one shell at a time. Defaults to the clip capacity
    --- @param clip_capacity number Max bullets the clip can hold
    @side(server)
    function SetAmmoSettings(ammo_clip: number, ammo_bag: number, ammo_to_reload: number?, clip_capacity: number?): nil
    --- Sets the Animation played by the Weapon itself when firing
    --- @param animation_fire_path string The Animation asset to play on the Weapon mesh
    --- @param play_rate number Speed multiplier of the animation
    @side(server)
    function SetAnimationFire(animation_fire_path: string, play_rate: number?): nil
    --- Sets the Animation played by the Character when firing this Weapon
    --- @param animation_character_fire_path string The Animation asset to play on the Character
    --- @param play_rate number Speed multiplier of the animation
    @side(server)
    function SetAnimationCharacterFire(animation_character_fire_path: string, play_rate: number?): nil
    --- Sets the Animation played by the Character when reloading this Weapon
    --- @param reload_animation_path string The Animation asset to play on the Character
    --- @param play_rate number Speed multiplier of the animation
    @side(server)
    function SetAnimationReload(reload_animation_path: string, play_rate: number?): nil
    --- Gets the reload animation
    --- @return string Reload animation
    @side(shared)
    function GetAnimationReload(): string
    --- Sets if the Character will reload automatically when the clip is empty
    --- @param auto_reload boolean Whether to reload automatically
    @side(server)
    function SetAutoReload(auto_reload: boolean): nil
    --- Set the Bullet Color
    --- @param bullet_color Color The new Bullet Color
    @side(server)
    function SetBulletColor(bullet_color: Color): nil
    --- Sets how many bullets are fired per shot and how they look and travel
    --- @param bullet_count number 1 for common weapons > 1 for shotguns
    --- @param bullet_max_distance number Max distance the bullet travels (in units, 1 unit = 1 cm)
    --- @param bullet_velocity number Visuals only
    --- @param bullet_color Color Color of the bullet trail
    @side(server)
    function SetBulletSettings(bullet_count: number, bullet_max_distance: number, bullet_velocity: number, bullet_color: Color): nil
    --- Sets the time between shots
    --- @param cadence number 1 shot at each `cadence` second
    @side(server)
    function SetCadence(cadence: number): nil
    --- Sets the max number of bullets the Weapon's clip can hold
    --- @param clip number The new clip capacity
    @side(server)
    function SetClipCapacity(clip: number): nil
    --- Set the Base Weapon's Damage
    --- @param damage number The new Base Weapon's Damage
    @side(server)
    function SetDamage(damage: number): nil
    --- Sets how the Character grabs this Weapon
    --- @param handling_mode HandlingMode The new how the Character grabs this Weapon
    @side(server)
    function SetHandlingMode(handling_mode: HandlingMode): nil
    --- Sets where the Character's left hand holds this Weapon, relative to the Weapon
    --- @param left_hand_location Vector Location offset of the left hand
    --- @param left_hand_rotation Rotator Rotation offset of the left hand
    @side(server)
    function SetLeftHandTransform(left_hand_location: Vector, left_hand_rotation: Rotator): nil
    --- Set the mesh used when the Character reloads the weapon
    --- @param magazine_mesh string The Static Mesh of the magazine, spawned in the Character's hand during the reload
    --- @param magazine_mesh_hide_bone string Weapon bone to hide when reloading it
    @side(server)
    function SetMagazineMesh(magazine_mesh: string, magazine_mesh_hide_bone: string?): nil
    --- Plays an Animation on this Weapon
    --- @param animation_path string The Animation asset to play
    --- @param slot_name string The Animation Slot to play it on
    --- @param loop_indefinitely boolean This parameter is only used if the Weapon has an Animation Blueprint
    --- @param blend_in_time number This parameter is only used if the Weapon has an Animation Blueprint
    --- @param blend_out_time number This parameter is only used if the Weapon has an Animation Blueprint
    --- @param play_rate number This parameter is only used if the Weapon has an Animation Blueprint
    --- @param stop_all_montages boolean Stops all running Montages from the same Group. This parameter is only used if the Weapon has an Animation Blueprint
    @side(shared)
    function PlayAnimation(animation_path: string, slot_name: string?, loop_indefinitely: boolean?, blend_in_time: number?, blend_out_time: number?, play_rate: number?, stop_all_montages: boolean?): nil
    --- Stops an Animation Montage on this Weapon
    --- @param animation_asset string Leave empty to stop all Montages
    @side(shared)
    function StopAnimation(animation_asset: string?): nil
    --- Sets the Particle of the bullet trail
    --- @param particle_bullet_trail_asset_path string The Particle asset to spawn for each bullet
    @side(server)
    function SetParticlesBulletTrail(particle_bullet_trail_asset_path: string): nil
    --- Sets the Particle of the fire blast at the muzzle
    --- @param particle_asset_path string The Particle asset to spawn at the muzzle when firing
    @side(server)
    function SetParticlesBarrel(particle_asset_path: string): nil
    --- Sets the Particle of the empty shells ejected when firing
    --- @param particle_shells_asset_path string The Particle asset to spawn when ejecting a shell
    @side(server)
    function SetParticlesShells(particle_shells_asset_path: string): nil
    --- Set the offset of Right Hand
    --- @param right_hand_offset Vector The new offset of Right Hand
    @side(server)
    function SetRightHandOffset(right_hand_offset: Vector): nil
    --- Sets the Field of View multiplier applied when aiming down sights
    --- @param sight_fov_multiplier number Values below 1 zoom in, for example 0.5 for a scope
    @side(server)
    function SetSightFOVMultiplier(sight_fov_multiplier: number): nil
    --- Sets the offset that aligns the Player's view with the Weapon's sight when aiming down sights
    --- @param sight_location Vector Offset between the camera and the sight
    --- @param sight_rotation Rotator Rotation applied to the Weapon while aiming
    @side(server)
    function SetSightTransform(sight_location: Vector, sight_rotation: Rotator): nil
    --- Sets the Sound played when trying to fire with an empty clip
    --- @param sound_dry_asset_path string The Sound asset to play
    --- @param volume number Volume multiplier
    --- @param pitch number Pitch multiplier
    @side(server)
    function SetSoundDry(sound_dry_asset_path: string, volume: number?, pitch: number?): nil
    --- Sets the Sound played when loading a magazine
    --- @param sound_load_asset_path string The Sound asset to play
    --- @param volume number Volume multiplier
    --- @param pitch number Pitch multiplier
    @side(server)
    function SetSoundLoad(sound_load_asset_path: string, volume: number?, pitch: number?): nil
    --- Sets the Sound played when unloading a magazine
    --- @param sound_unload_asset_path string The Sound asset to play
    --- @param volume number Volume multiplier
    --- @param pitch number Pitch multiplier
    @side(server)
    function SetSoundUnload(sound_unload_asset_path: string, volume: number?, pitch: number?): nil
    --- Sets the Sound played when zooming
    --- @param sound_zooming_asset_path string The Sound asset to play
    --- @param volume number Volume multiplier
    --- @param pitch number Pitch multiplier
    @side(server)
    function SetSoundZooming(sound_zooming_asset_path: string, volume: number?, pitch: number?): nil
    --- Sets the Sound played when firing
    --- @param sound_fire_asset_path string The Sound asset to play
    --- @param volume number Volume multiplier
    --- @param pitch number Pitch multiplier
    @side(server)
    function SetSoundFire(sound_fire_asset_path: string, volume: number?, pitch: number?): nil
    --- Sets the Sound played when starting to aim
    --- @param sound_aim_asset_path string The Sound asset to play
    --- @param volume number Volume multiplier
    --- @param pitch number Pitch multiplier
    @side(server)
    function SetSoundAim(sound_aim_asset_path: string, volume: number?, pitch: number?): nil
    --- Sound when firing with only having X remaining bullets in the magazine
    --- @param sound_asset_path string The Sound asset to play
    --- @param remaining_bullets_count number The amount of remaining bullet to start playing this sound
    @side(server)
    function SetSoundFireLastBullets(sound_asset_path: string, remaining_bullets_count: number?): nil
    --- Sets the base spread of this Weapon
    --- @param spread number the higher the less precision - recommended value: 20
    @side(server)
    function SetSpread(spread: number): nil
    --- Sets the base recoil of this Weapon
    --- @param recoil number 0 means no Recoil, default is 1
    @side(server)
    function SetRecoil(recoil: number): nil
    --- Sets if the Weapon can hold to keep firing and if it needs to release to fire
    --- @param can_hold_use boolean Whether holding the fire button keeps firing (automatic weapons)
    --- @param hold_release_use boolean Whether it only fires when the fire button is released (e.g. bows)
    @side(server)
    function SetUsageSettings(can_hold_use: boolean, hold_release_use: boolean): nil
    --- Sets how the bullet will pass through walls
    --- @param max_distance number Max distance to pass through another wall
    --- @param damage_multiplier number Damage given if wallbangged
    @side(server)
    function SetWallbangSettings(max_distance: number, damage_multiplier: number): nil
    --- Gets this Weapon's Ammo Bag
    --- @return number This Weapon's Ammo Bag
    @side(shared)
    function GetAmmoBag(): number
    --- Gets this Weapon's Ammo Clip
    --- @return number This Weapon's Ammo Clip
    @side(shared)
    function GetAmmoClip(): number
    --- Gets the amount of ammo needed to fully reload
    --- @return number Amount of ammo needed to fully reload
    @side(shared)
    function GetAmmoToReload(): number
    --- Gets the Animation played by the Character when firing
    --- @return string The Animation asset
    @side(shared)
    function GetAnimationCharacterFire(): string
    --- Gets the Animation played by the Weapon when firing
    --- @return string The Animation asset
    @side(shared)
    function GetAnimationFire(): string
    --- Gets the magazine Static Mesh used when reloading
    --- @return string The Static Mesh asset
    @side(shared)
    function GetMagazineMesh(): string
    --- Gets the Particle of the bullet trail
    --- @return string The Particle asset
    @side(shared)
    function GetParticlesBulletTrail(): string
    --- Gets the Particle of the Fire Blast in the muzzle
    --- @return string Particle of the Fire Blast in the muzzle
    @side(shared)
    function GetParticlesBarrel(): string
    --- Gets the max distance a bullet can pass through walls
    --- @return number Max distance a bullet can pass through walls
    @side(shared)
    function GetWallbangMaxDistance(): number
    --- Gets the damage multiplier applied when a bullet passes through a wall
    --- @return number Damage multiplier applied when a bullet passes through a wall
    @side(shared)
    function GetWallbangDamageMultiplier(): number
    --- Gets the Particle of the ejected shells
    --- @return string The Particle asset
    @side(shared)
    function GetParticlesShells(): string
    --- Gets the Sound played when firing with an empty clip
    --- @return string The Sound asset
    @side(shared)
    function GetSoundDry(): string
    --- Gets the Sound played when loading a magazine
    --- @return string The Sound asset
    @side(shared)
    function GetSoundLoad(): string
    --- Gets the Sound played when unloading a magazine
    --- @return string The Sound asset
    @side(shared)
    function GetSoundUnload(): string
    --- Gets the Sound played when zooming
    --- @return string The Sound asset
    @side(shared)
    function GetSoundZooming(): string
    --- Gets the Sound played when aiming
    --- @return string The Sound asset
    @side(shared)
    function GetSoundAim(): string
    --- Gets the Sound played when firing
    --- @return string The Sound asset
    @side(shared)
    function GetSoundFire(): string
    --- Gets if the weapon can be used continuously by holding the use button
    --- @return boolean Whether the weapon can be used continuously by holding the use button
    @side(shared)
    function GetCanHoldUse(): boolean
    --- Gets if the weapon is triggered/fired when releasing the use button
    --- @return boolean Whether the weapon is triggered/fired when releasing the use button
    @side(shared)
    function GetHoldReleaseUse(): boolean
    --- Gets how many bullets are fired per shot
    --- @return number Bullets per shot
    @side(shared)
    function GetBulletCount(): number
    --- Gets the color of the bullet trail
    --- @return Color The bullet trail color
    @side(shared)
    function GetBulletColor(): Color
    --- Gets the time between shots
    --- @return number Seconds between shots
    @side(shared)
    function GetCadence(): number
    --- Gets the max number of bullets the clip can hold
    --- @return number The clip capacity
    @side(shared)
    function GetClipCapacity(): number
    --- Gets the base damage of this Weapon
    --- @return number The base damage
    @side(shared)
    function GetDamage(): number
    --- Gets the offset of the right hand, relative to the camera
    --- @return Vector The right hand offset
    @side(shared)
    function GetRightHandOffset(): Vector
    --- Gets the location offset of the left hand
    --- @return Vector The left hand location offset
    @side(shared)
    function GetLeftHandLocation(): Vector
    --- Gets the rotation offset of the left hand
    --- @return Rotator The left hand rotation offset
    @side(shared)
    function GetLeftHandRotation(): Rotator
    --- Gets the sight location offset used when aiming down sights
    --- @return Vector The sight location offset
    @side(shared)
    function GetSightLocation(): Vector
    --- Gets the sight rotation used when aiming down sights
    --- @return Rotator The sight rotation
    @side(shared)
    function GetSightRotation(): Rotator
    --- Gets the Field of View multiplier applied when aiming down sights
    --- @return number The FOV multiplier
    @side(shared)
    function GetSightFOVMultiplier(): number
    --- Gets the base spread of this Weapon
    --- @return number The base spread, higher means less precision
    @side(shared)
    function GetSpread(): number
    --- Gets the base recoil of this Weapon
    --- @return number The base recoil, 0 means no recoil
    @side(shared)
    function GetRecoil(): number
end

--- Class for spawning a dynamic Web Browser.
@overrideCtor("$class($args)")
@side(client)
declare class WebUI extends Entity
    constructor(name: string, path: string, visibility: WidgetVisibility?, is_transparent: boolean?, auto_resize: boolean?, width: number?, height: number?)
    --- Puts this WebUI in the front of all WebUIs and Widgets
    @side(client)
    function BringToFront(): nil
    --- Calls an Event on the Browser's JavaScript
    --- @param event_name string The Event Name to trigger the event
    --- @param ... any Arguments to pass to the event
    @side(client)
    function CallEvent(event_name: string, ...: any): nil
    --- Loads a new File/URL in this Browser
    --- @param url string The URL or package file to load, e.g. `file://UI/index.html` or `https://...`
    @side(client)
    function LoadURL(url: string): nil
    --- Loads a pure HTML in this Browser
    --- @param html string The HTML content to load
    @side(client)
    function LoadHTML(html: string): nil
    --- Gets this WebUI name
    --- @return string This WebUI name
    @side(client)
    function GetName(): string
    --- Executes a JavaScript code in the Browser
    --- @param javascript_code string The JavaScript code to run
    @side(client)
    function ExecuteJavaScript(javascript_code: string): nil
    --- Enables the focus on this browser (i.e. can receive Keyboard input and will trigger input events)
    @side(client)
    function SetFocus(): nil
    --- Returns if this WebUI has any DOM Node focused
    --- @return boolean Whether any DOM node is focused
    @side(client)
    function HasNodeFocus(): boolean
    --- Removes the focus from this WebUI (and sets it back to game viewport)
    @side(client)
    function RemoveFocus(): nil
    --- Sets the Layout as Canvas on Screen
    --- @param location Vector2D Screen location, or the left and top offsets when the anchors are stretched
    --- @param size Vector2D Size, or the right and bottom offsets when the anchors are stretched
    --- @param anchors_min Vector2D Min anchor, from (0, 0) top-left to (1, 1) bottom-right
    --- @param anchors_max Vector2D Max anchor, from (0, 0) top-left to (1, 1) bottom-right
    --- @param alignment Vector2D Pivot of the WebUI, (0.5, 0.5) is the center
    @side(client)
    function SetLayout(location: Vector2D?, size: Vector2D?, anchors_min: Vector2D?, anchors_max: Vector2D?, alignment: Vector2D?): nil
    --- Freezes the WebUI rendering to the surface (JavaScript keeps running)
    --- @param freeze boolean Whether to freeze the rendering
    @side(client)
    function SetFreeze(freeze: boolean): nil
    --- Sets the visibility in screen
    --- @param visibility WidgetVisibility The new visibility in screen
    @side(client)
    function SetVisibility(visibility: WidgetVisibility): nil
    --- Spawns a Sound entity that plays this WebUI audio
    --- @param location Vector World location of the Sound, if 3D
    --- @param is_2d boolean Whether the Sound is 2D
    --- @param volume number Volume multiplier
    --- @param inner_radius number Radius within which the volume is 100%, if 3D
    --- @param falloff_distance number Distance at which the sound becomes inaudible, if 3D
    --- @param attenuation_function AttenuationFunction How the volume fades with distance, if 3D
    --- @return Sound The spawned Sound
    @side(client)
    function SpawnSound(location: Vector?, is_2d: boolean?, volume: number?, inner_radius: number?, falloff_distance: number?, attenuation_function: AttenuationFunction?): Sound
    --- Sends a Mouse Event into the WebUI programmatically
    --- @param mouse_x number Position X of the mouse
    --- @param mouse_y number Position Y of the mouse
    --- @param delta_x number Horizontal scroll amount
    --- @param delta_y number Vertical scroll amount
    @side(client)
    function SendMouseWheelEvent(mouse_x: number, mouse_y: number, delta_x: number, delta_y: number): nil
    --- Sends a Key Event into the WebUI programmatically
    --- @param key_type WebUIKeyType Whether it is a key down, key up or char event
    --- @param key_code number The JavaScript key code
    --- @param modifiers WebUIModifier Supports several modifiers separating by `|` (using bit-wise operations)
    @side(client)
    function SendKeyEvent(key_type: WebUIKeyType, key_code: number, modifiers: WebUIModifier?): nil
    --- Sends a Mouse Move Event into the WebUI programmatically
    --- @param mouse_x number Position X of the mouse
    --- @param mouse_y number Position Y of the mouse
    --- @param modifiers WebUIModifier Supports several modifiers separating by `|` (using bit-wise operations)
    --- @param mouse_leave boolean Whether the mouse left the WebUI
    @side(client)
    function SendMouseMoveEvent(mouse_x: number, mouse_y: number, modifiers: WebUIModifier?, mouse_leave: boolean?): nil
    --- Sends a Mouse Click into the WebUI programmatically
    --- @param mouse_x number Position X of the mouse
    --- @param mouse_y number Position Y of the mouse
    --- @param mouse_type WebUIMouseType Which mouse button
    --- @param is_mouse_up boolean Whether the event was up or down
    --- @param modifiers WebUIModifier Supports several modifiers separating by `|` (using bit-wise operations)
    --- @param click_count number Use 2 for double click event
    @side(client)
    function SendMouseClickEvent(mouse_x: number, mouse_y: number, mouse_type: WebUIMouseType, is_mouse_up: boolean, modifiers: WebUIModifier?, click_count: number?): nil
    --- Gets the current size of this WebUI
    --- @return Vector2D Current size of this WebUI
    @side(client)
    function GetSize(): Vector2D
    --- Returns the current WebUI visibility
    --- @return WidgetVisibility Current WebUI visibility
    @side(client)
    function GetVisibility(): WidgetVisibility
    --- Returns if this WebUI is currently frozen
    --- @return boolean Whether this WebUI is currently frozen
    @side(client)
    function IsFrozen(): boolean
    --- Returns if this WebUI is ready
    --- @return boolean Whether this WebUI is ready
    @side(client)
    function IsReady(): boolean
    --- Opens the Developer Tools for this WebUI, it only works if the Client.SetDebugEnabled() was not disabled
    @side(client)
    function OpenDevTools(): nil
    --- Closes the Developer Tools for this WebUI, it only works if the Client.SetDebugEnabled() not disabled
    @side(client)
    function CloseDevTools(): nil
end

--- The Widget class supports spawning Unreal Widgets classes through scripting and manipulate them such as Blueprints!
@overrideCtor("$class($args)")
@side(client)
declare class Widget extends Entity
    --- Spawns a Widget passing a UserWidget blueprint
    constructor(blueprint_path: string)
    --- Spawns a Widget passing a NativeWidget enum
    constructor(native_widget: NativeWidget)
    --- Spawns a 3D Widget actor rendering this Widget in the world
    --- @param location Vector World location
    --- @param rotation Rotator World rotation
    --- @param widget_space WidgetSpace Whether it renders in the world or always facing the screen
    --- @param auto_size boolean Whether to size it automatically based on its content
    --- @param size Vector2D Only works if auto_size = false
    --- @param auto_repaint_rate number Leaves -1 to repaint every frame
    --- @param pivot Vector2D Pivot of the widget, (0.5, 0.5) is the center
    --- @return Widget3D The spawned Widget3D
    @side(client)
    function SpawnWidget3D(location: Vector?, rotation: Rotator?, widget_space: WidgetSpace?, auto_size: boolean?, size: Vector2D?, auto_repaint_rate: number?, pivot: Vector2D?): Widget3D
    --- Sets the visibility in screen
    --- @param visibility WidgetVisibility The new visibility in screen
    @side(client)
    function SetVisibility(visibility: WidgetVisibility): nil
    --- Returns the current WebUI visibility
    --- @return WidgetVisibility Current WebUI visibility
    @side(client)
    function GetVisibility(): WidgetVisibility
    --- Enables the focus on this Widget (i.e. can receive Keyboard input and will trigger input events)
    @side(client)
    function SetFocus(): nil
    --- Puts this Widget in the front of all WebUIs and Widgets
    @side(client)
    function BringToFront(): nil
    --- Adds it to the game's viewport and fills the entire screen
    @side(client)
    function AddToViewport(): nil
    --- Adds a new child widget to this Widget container, if this is a Panel
    --- @param other WebUI | Widget The WebUI or Widget to add
    @side(client)
    function AddChild(other: WebUI | Widget): nil
    --- Sets the widget for a given slot by name, if this is a UserWidget
    --- @param slot_name string Name of the Named Slot
    --- @param widget Widget Pass nil to remove it
    @side(client)
    function SetContentForSlot(slot_name: string, widget: Widget?): nil
    --- Sets the Layout as Canvas on Screen
    --- @param location Vector2D Screen location, or the left and top offsets when the anchors are stretched
    --- @param size Vector2D Size, or the right and bottom offsets when the anchors are stretched
    --- @param anchors_min Vector2D Min anchor, from (0, 0) top-left to (1, 1) bottom-right
    --- @param anchors_max Vector2D Max anchor, from (0, 0) top-left to (1, 1) bottom-right
    --- @param alignment Vector2D Pivot of the Widget, (0.5, 0.5) is the center
    @side(client)
    function SetSlotCanvasLayout(location: Vector2D?, size: Vector2D?, anchors_min: Vector2D?, anchors_max: Vector2D?, alignment: Vector2D?): nil
    --- Calls a Blueprint Event or Function
    --- @param event_name string Event or Function name
    --- @param ... any Sequence of arguments to pass to the event
    --- @return any the function return values
    @side(client)
    function CallBlueprintEvent(event_name: string, ...: any): any
    --- Assigns and Binds a Blueprint Event Dispatcher
    --- @param dispatcher_name string Event Dispatcher name
    --- @param callback any Callback function to call
    --- @return any the callback itself
    @side(client)
    function BindBlueprintEventDispatcher(dispatcher_name: string, callback: any): any
    --- Unbinds a Blueprint Event Dispatcher
    --- @param dispatcher_name string Event Dispatcher name
    --- @param callback any Optional callback to unbind
    @side(client)
    function UnbindBlueprintEventDispatcher(dispatcher_name: string, callback: any?): nil
    --- Sets a Blueprint Property/Variable value directly
    --- @param property_name string Name of the Blueprint variable
    --- @param value any The value to set
    @side(client)
    function SetBlueprintPropertyValue(property_name: string, value: any): nil
    --- Gets a Blueprint Property/Variable value
    --- @param property_name string Name of the Blueprint variable
    --- @return any the value
    @side(client)
    function GetBlueprintPropertyValue(property_name: string): any
    --- Sets the slot alignment for horizontal and vertical positioning
    --- @param horizontal_alignment WidgetHorizontalAlignment Horizontal alignment for the slot
    --- @param vertical_alignment WidgetVerticalAlignment Vertical alignment for the slot
    @side(client)
    function SetSlotAlignment(horizontal_alignment: WidgetHorizontalAlignment?, vertical_alignment: WidgetVerticalAlignment?): nil
    --- Sets the slot padding for horizontal and vertical spacing
    --- @param padding_horizontal Vector2D Horizontal padding for the slot
    --- @param padding_vertical Vector2D Vertical padding for the slot
    @side(client)
    function SetSlotPadding(padding_horizontal: Vector2D?, padding_vertical: Vector2D?): nil
    --- Sets the slot size and size rule
    --- @param size number Size value for the slot
    --- @param slate_size_rule WidgetSizeRule Size rule for the slot
    @side(client)
    function SetSlotSize(size: number?, slate_size_rule: WidgetSizeRule?): nil
end

--- The Widget3D class is the 3D representation of a Widget class spawned in the world.
@side(client)
declare class Widget3D extends Entity implements Actor
    --- Sets the auto repaint rate
    --- @param rate number The new auto repaint rate
    @side(client)
    function SetAutoRepaintRate(rate: number): nil
    --- Forces this to repaint
    @side(client)
    function Repaint(): nil
    --- Gets the Widget rendered by this Widget3D
    --- @return Widget The Widget
    @side(client)
    function GetWidget(): Widget
end

-- ========================================================================
-- Utility classes
-- ========================================================================

--- JSON library.
declare interface JSON__Static
    --- Returns a string representing value encoded in JSON
    --- @param value any the table that will become JSON
    --- @return string the table in JSON
    function stringify(value: any): string
    --- Returns a value representing the decoded JSON string
    --- @param value string the JSON that will become a table
    --- @return any the json in table
    function parse(value: string): any
end
declare JSON: JSON__Static

--- A table containing useful and aux Math functions.
declare interface NanosMath__Static
    --- Rounds a number to the nearest value with the given decimal places
    --- @param value number The number to be rounded
    --- @param decimals number How many decimal places to keep
    --- @return number the rounded number
    function Round(value: number, decimals: number?): number
    --- Clamps a number
    --- @param value number The number to be clamped
    --- @param min number The min value
    --- @param max number The max value
    --- @return number the number clamped
    function Clamp(value: number, min: number, max: number): number
    --- Clamps an angle to the range of [0, 360]
    --- @param value number The number to be clamped
    --- @return number the number clamped
    function ClampAxis(value: number): number
    --- Clamps an angle to the range of [-180, 180]
    --- @param value number The number to be clamped
    --- @return number the number clamped
    function NormalizeAxis(value: number): number
    --- Calculates the location and rotation relative to an actor
    --- @param location Vector The location of the new system
    --- @param rotation Rotator The rotation of the new system
    --- @param actor Actor The actor to be translated to the new system
    --- @return Vector the location relative to the actor
    --- @return Rotator the rotation relative to the actor
    function RelativeTo(location: Vector, rotation: Rotator, actor: Actor): (Vector, Rotator)
    --- Converts a local location and rotation to world coordinates based on an actor's transform
    --- @param local_location Vector The local location to convert
    --- @param local_rotation Rotator The local rotation to convert
    --- @param actor Actor The actor whose transform defines the local space
    --- @return Vector the location in world coordinates
    --- @return Rotator the rotation in world coordinates
    function LocalToWorld(local_location: Vector, local_rotation: Rotator, actor: Actor): (Vector, Rotator)
    --- Returns a random float value
    --- @param min number Minimum value
    --- @param max number Maximum value
    --- @return number the random value
    function RandomFloat(min: number, max: number): number
    --- Interpolate number from Current to Target
    --- @param current number The current value
    --- @param target number The target value
    --- @param delta_time number Time since the last call, usually the Tick delta time
    --- @param interp_speed number Interpolation speed, 0 jumps straight to the target
    --- @return number The interpolated value
    function FInterpTo(current: number, target: number, delta_time: number, interp_speed: number): number
    --- Interpolate Rotator from Current to Target
    --- @param current Rotator The current value
    --- @param target Rotator The target value
    --- @param delta_time number Time since the last call, usually the Tick delta time
    --- @param interp_speed number Interpolation speed, 0 jumps straight to the target
    --- @return Rotator The interpolated Rotator
    function RInterpTo(current: Rotator, target: Rotator, delta_time: number, interp_speed: number): Rotator
    --- Interpolate Rotator from Current to Target with a constant step
    --- @param current Rotator The current value
    --- @param target Rotator The target value
    --- @param delta_time number Time since the last call, usually the Tick delta time
    --- @param interp_speed number Interpolation speed, 0 jumps straight to the target
    --- @return Rotator The interpolated Rotator
    function RInterpConstantTo(current: Rotator, target: Rotator, delta_time: number, interp_speed: number): Rotator
    --- Interpolate Vector from Current to Target
    --- @param current Vector The current value
    --- @param target Vector The target value
    --- @param delta_time number Time since the last call, usually the Tick delta time
    --- @param interp_speed number Interpolation speed, 0 jumps straight to the target
    --- @return Vector The interpolated Vector
    function VInterpTo(current: Vector, target: Vector, delta_time: number, interp_speed: number): Vector
    --- Interpolate Vector from Current to Target with a constant step
    --- @param current Vector The current value
    --- @param target Vector The target value
    --- @param delta_time number Time since the last call, usually the Tick delta time
    --- @param interp_speed number Interpolation speed, 0 jumps straight to the target
    --- @return Vector The interpolated Vector
    function VInterpConstantTo(current: Vector, target: Vector, delta_time: number, interp_speed: number): Vector
end
declare NanosMath: NanosMath__Static

--- A table containing useful and aux functions.
declare interface NanosUtils__Static
    --- Returns if an entity is valid
    --- @param entity any Entity to verify
    --- @return boolean if the entity is valid
    function IsEntityValid(entity: any): boolean
    --- Benchmarks a function performance
    --- @param name string Benchmark name to output
    --- @param amount number Amount of times to loop
    --- @param func any The function to call
    --- @param ... any The arguments of the function to call
    --- @return number the elapsed time in milliseconds
    function Benchmark(name: string, amount: number, func: any, ...: any): number
end
declare NanosUtils: NanosUtils__Static

--- A table containing useful and aux table functions.
declare interface NanosTable__Static
    --- Dumps a table into a readable text
    --- @param table any Table to dump
    --- @return string the table as readable text
    function Dump(table: any): string
    --- Performs a shallow copy of a table
    --- @param table any The table to shallow copy
    --- @return any the copied table
    function ShallowCopy(table: any): any
end
declare NanosTable: NanosTable__Static

--- TOML library.
declare interface TOML__Static
    --- Returns a string representing value encoded in TOML
    --- @param value any the table that will become TOML
    --- @return string the table in TOML
    function Dump(value: any): string
    --- Returns a value representing the decoded TOML string
    --- @param value string the TOML that will become a table
    --- @return any the TOML in table
    function Parse(value: string): any
end
declare TOML: TOML__Static

-- ========================================================================
-- Static classes
-- ========================================================================

--- Retrieve Assets Data from Asset Packs.
@side(shared)
declare interface Assets__Static
    --- Gets a list containing information about all loaded Asset Packs
    --- @return any[] List containing information about all loaded Asset Packs
    function GetAssetPacks(): any[]
    --- Gets the file path of an asset
    --- @param asset string The asset reference in the format `asset-pack::AssetKey`
    --- @param asset_type AssetType The Asset Type
    --- @return string The file path defined in the Assets.toml
    function GetAssetPath(asset: string, asset_type: AssetType): string
    --- Gets a list containing all Animation Assets Keys from an AssetPack
    --- @param asset_pack_path string The Asset Pack path to get the assets
    --- @return any[] array of tables containing all assets and its metadata
    function GetAnimations(asset_pack_path: string): any[]
    --- Gets a list containing all Blueprints Assets Keys from an AssetPack
    --- @param asset_pack_path string The Asset Pack path to get the assets
    --- @return any[] array of tables containing all assets and its metadata
    function GetBlueprints(asset_pack_path: string): any[]
    --- Gets a list containing all Map Asset Keys from an AssetPack
    --- @param asset_pack_path string The Asset Pack path to get the assets
    --- @return any[] array of tables containing all assets and its metadata
    function GetMaps(asset_pack_path: string): any[]
    --- Gets a list containing all Materials Asset Keys from an AssetPack
    --- @param asset_pack_path string The Asset Pack path to get the assets
    --- @return any[] array of tables containing all assets and its metadata
    function GetMaterials(asset_pack_path: string): any[]
    --- Gets a list containing all Particle Assets Keys from an AssetPack
    --- @param asset_pack_path string The Asset Pack path to get the assets
    --- @return any[] array of tables containing all assets and its metadata
    function GetParticles(asset_pack_path: string): any[]
    --- Gets a list containing all Sound Assets Keys from an AssetPack
    --- @param asset_pack_path string The Asset Pack path to get the assets
    --- @return any[] array of tables containing all assets and its metadata
    function GetSounds(asset_pack_path: string): any[]
    --- Gets a list containing all Skeletal Mesh Asset Keys from an AssetPack
    --- @param asset_pack_path string The Asset Pack path to get the assets
    --- @return any[] array of tables containing all assets and its metadata
    function GetSkeletalMeshes(asset_pack_path: string): any[]
    --- Gets a list containing all Static Mesh Assets Keys from an AssetPack
    --- @param asset_pack_path string The Asset Pack path to get the assets
    --- @return any[] array of tables containing all assets and its metadata
    function GetStaticMeshes(asset_pack_path: string): any[]
    --- Gets a list containing all Other Assets Keys from an AssetPack
    --- @param asset_pack_path string The Asset Pack path to get the assets
    --- @return any[] array of tables containing all assets and its metadata
    function GetOthers(asset_pack_path: string): any[]
    --- Manually adds an Asset to be loaded during the Player's loading screen
    --- @param asset_path string The Asset Key
    --- @param asset_type AssetType The Asset Type
    @side(server)
    function Precache(asset_path: string, asset_type: AssetType): nil
end
@side(shared)
declare Assets: Assets__Static

--- Configure, send and intercept chat messages.
@side(shared)
declare interface Chat__Static
    --- Adds a chat message which will display local only
    --- @param message string The message, supports the same rich text tags as the chat
    @side(client)
    function AddMessage(message: string): nil
    --- Sends a chat message to a Player only
    --- @param player Player The player to receive the message
    --- @param message string The message
    @side(server)
    function SendMessage(player: Player, message: string): nil
    --- Configures the Chat visuals and position
    --- @param screen_location Vector2D Screen location, or the left and top offsets when the anchors are stretched
    --- @param size Vector2D Size, or the right and bottom offsets when the anchors are stretched
    --- @param anchors_min Vector2D Min anchor, from (0, 0) top-left to (1, 1) bottom-right
    --- @param anchors_max Vector2D Max anchor, from (0, 0) top-left to (1, 1) bottom-right
    --- @param alignment Vector2D Pivot of the chat, (0.5, 0.5) is the center
    --- @param justify boolean Whether the text is justified
    --- @param show_scrollbar boolean Whether to show the scrollbar
    @side(client)
    function SetConfiguration(screen_location: Vector2D?, size: Vector2D?, anchors_min: Vector2D?, anchors_max: Vector2D?, alignment: Vector2D?, justify: boolean?, show_scrollbar: boolean?): nil
    --- Sets if the Chat is visible or not
    --- @param is_visible boolean Whether the Chat is visible or not
    @side(client)
    function SetVisibility(is_visible: boolean): nil
    --- Clears all messages
    @side(client)
    function Clear(): nil
    --- Sends a chat message to all Players
    --- @param message string The message to send to all Players
    @side(server)
    function BroadcastMessage(message: string): nil
    --- Subscribes to an Event
    --- @param event_name string Event to subscribe to
    --- @param callback any Callback to run on the event occurring
    --- @return any The function callback
    function Subscribe(event_name: string, callback: any): any
    --- Unsubscribes from all subscribed Events in this Class and in this Package, optionally passing the function to unsubscribe only that callback
    --- @param event_name string Event to unsubscribe to
    --- @param callback any Optional callback to specifically unsubscribe to
    function Unsubscribe(event_name: string, callback: any?): nil
end
@side(shared)
declare Chat: Chat__Static

--- Static Class present on Client side.
@side(client)
declare interface Client__Static
    --- Disconnects from the server
    function Disconnect(): nil
    --- Copies a text to Clipboard
    --- @param text string The text to copy
    function CopyToClipboard(text: string): nil
    --- Sets the Near Clip Plane
    --- @param near_clip_plane number The new Near Clip Plane
    function SetNearClipPlane(near_clip_plane: number): nil
    --- Sets the Escape Menu text
    --- @param text string Supports using `<h1>`, `<h2>`, `<h3>` and `<strong>` tags in the text.
    function SetEscapeMenuText(text: string): nil
    --- Shows a notification using the built-in notification system.
    --- @param text string The text of the notification
    --- @param notification_type NotificationType The notification style
    --- @param add_to_notification_list boolean Whether to add this notification to the notification list (accessible from the bell icon on the top-right corner)
    --- @param duration number Duration in seconds to display the notification
    function ShowNotification(text: string, notification_type: NotificationType?, add_to_notification_list: boolean?, duration: number?): nil
    --- Gets the Near Clip Plane value
    --- @return number Near Clip Plane value
    function GetNearClipPlane(): number
    --- Gets the current connected server IP:Port
    --- @return string Current connected server IP:Port
    function GetConnectedServerIP(): string
    --- Enables/Disables Debug settings and Client Console to be used
    --- @param enable_debug boolean Whether to enable Debug settings and Client Console to be used
    function SetDebugEnabled(enable_debug: boolean): nil
    --- Overrides the gamma setting and prevents the client from changing it
    --- @param override_ boolean Whether to override the gamma setting
    --- @param new_gamma number? The new gamma value if overriding
    function SetSettingGammaOverride(override_: boolean, new_gamma: number?): nil
    --- Changes the Highlight Color for highlighted actors at a specific Index
    --- @param highlight_color Color The color to use
    --- @param index number Highlight slot index (0 to 2)
    --- @param mode HighlightMode When the highlight is visible
    function SetHighlightColor(highlight_color: Color, index: number, mode: HighlightMode?): nil
    --- Changes the Outline Color for outlined actors at a specific Index
    --- @param outline_color Color The color to use
    --- @param index number Outline slot index (0 to 2)
    --- @param thickness number Line thickness
    function SetOutlineColor(outline_color: Color, index: number?, thickness: number?): nil
    --- Sets a global value in the Client, which can be accessed from anywhere (client side)
    --- @param key string Key
    --- @param value any Value
    function SetValue(key: string, value: any): nil
    --- Subscribes for an Event
    --- @param event_name string The name of the event
    --- @param callback any The function to be called
    --- @return any the function callback itself
    function Subscribe(event_name: string, callback: any): any
    --- Unsubscribes from all subscribed Events in this Class and in this Package, optionally passing the function to unsubscribe only that callback
    --- @param event_name string The name of the event
    --- @param callback any The function to be called
    function Unsubscribe(event_name: string, callback: any?): nil
    --- Gets the local Player
    --- @return Player the local Player
    function GetLocalPlayer(): Player
    --- Gets the current Frame Time
    --- @return number the Frame Time
    function GetFrameTime(): number
    --- Gets the Unix Epoch Time in milliseconds
    --- @return number the unix timestamp
    function GetTime(): number
    --- Returns the current log level
    --- @return number the log level
    function GetLogLevel(): number
    --- Returns the entity with the specified ID
    --- @param entity_id number The entity ID
    --- @return Entity? the entity
    function GetEntityByID(entity_id: number): Entity?
    --- Returns the actors within the specified radius
    --- @param location Vector The center location of the search
    --- @param radius number The search radius
    --- @param only_classes string[] Only actors of these classes will be returned (pass empty for all classes)
    --- @return Actor[] The actors found in radius
    function GetActorsInRadius(location: Vector, radius: number, only_classes: string[]?): Actor[]
    --- Returns the current map package name
    --- @return string the current Map
    function GetMap(): string
    --- Returns if a Package is currently loaded
    --- @param package_name string The package folder name
    --- @return boolean if the package is loaded
    function IsPackageLoaded(package_name: string): boolean
    --- Returns a list of Packages running
    --- @param package_type_filter PackageType Which Package type to return. Leave it default to return all types.
    --- @return any[] a list of Packages data
    function GetPackages(package_type_filter: PackageType?): any[]
    --- Gets a value given a key
    --- @param key string The key
    --- @param fallback any Value returned if the key doesn't exist
    --- @return any Value at key or fallback if key doesn't exist
    function GetValue(key: string, fallback: any): any
    --- Gets a list of all values keys
    --- @return string[] a list with all values keys
    function GetAllValuesKeys(): string[]
    --- Opens the escape menu
    --- @param open_settings boolean If true, opens the Settings tab directly
    function OpenEscapeMenu(open_settings: boolean?): nil
    --- Gets whether the local player has muted their own microphone
    --- @return boolean Whether the microphone is muted by the player
    function IsVOIPSelfMuted(): boolean
    --- Gets the current language of the Client
    --- @return string the language code
    function GetLanguage(): string
    --- Gets the local player's game Settings
    --- @return any the current Settings
    function GetSettings(): any
end
@side(client)
declare Client: Client__Static

--- Exposes access to registering Console Commands and Logging messages.
@side(shared)
declare interface Console__Static
    --- Logs and formats a message in the console
    --- @param message string Message to print
    --- @param ... any Other arguments to format with the message using string.format
    function Log(message: string, ...: any): nil
    --- Logs an orange warning in the console with stack information
    --- @param message string Message to print
    --- @param ... any Other arguments to format with the message using string.format
    function Warn(message: string, ...: any): nil
    --- Logs a red error in the console with stack information
    --- @param message string Message to print
    --- @param ... any Other arguments to format with the message using string.format
    function Error(message: string, ...: any): nil
    --- Registers a new Console Command
    --- @param command string The command
    --- @param callback any The callback to be called when the command is inputted
    --- @param description string The command description to display in the console
    --- @param parameters string[] The list of supported parameters to display in the console
    function RegisterCommand(command: string, callback: any, description: string?, parameters: string[]?): nil
    --- Runs a Console Command programmatically (only scripting-registered commands can be triggered)
    --- @param command string The command
    function RunCommand(command: string): nil
    --- Logs a debug message in the console, with formatted arguments. Outputted only when the current log level is Debug or Verbose
    --- @param message string Message to print
    --- @param ... any Other arguments to format with the message using string.format
    function Debug(message: string, ...: any): nil
    --- Subscribes to an Event
    --- @param event_name string Event to subscribe to
    --- @param callback any Callback to run on the event occurring
    --- @return any The function callback
    function Subscribe(event_name: string, callback: any): any
    --- Unsubscribes from all subscribed Events in this Class and in this Package, optionally passing the function to unsubscribe only that callback
    --- @param event_name string Event to unsubscribe to
    --- @param callback any Optional callback to specifically unsubscribe to
    function Unsubscribe(event_name: string, callback: any?): nil
end
@side(shared)
declare Console: Console__Static

--- Draws Debug shapes in the world.
@side(client)
declare interface Debug__Static
    --- Draws a Debug box in the world
    --- @param location Vector World location
    --- @param extent Vector Half size of the box on each axis
    --- @param rotation Rotator World rotation
    --- @param color Color The color to use
    --- @param life_time number Seconds before the drawing disappears
    --- @param thickness number Line thickness
    function DrawBox(location: Vector, extent: Vector, rotation: Rotator, color: Color, life_time: number?, thickness: number?): nil
    --- Draws a Debug coordinate system in the world
    --- @param location Vector World location
    --- @param rotation Rotator World rotation
    --- @param size number Size of the drawing
    --- @param life_time number Seconds before the drawing disappears
    --- @param thickness number Line thickness
    function DrawCoordinateSystem(location: Vector, rotation: Rotator, size: number?, life_time: number?, thickness: number?): nil
    --- Draws a Debug crosshair in the world
    --- @param location Vector World location
    --- @param rotation Rotator World rotation
    --- @param size number Size of the drawing
    --- @param color Color The color to use
    --- @param life_time number Seconds before the drawing disappears
    --- @param thickness number Line thickness
    function DrawCrosshairs(location: Vector, rotation: Rotator, size: number?, color: Color?, life_time: number?, thickness: number?): nil
    --- Draws a Debug cylinder in the world
    --- @param start_location Vector World start location
    --- @param end_location Vector World end location
    --- @param radius number Radius
    --- @param segments number Number of segments used to draw it, more segments look smoother
    --- @param color Color The color to use
    --- @param life_time number Seconds before the drawing disappears
    --- @param thickness number Line thickness
    function DrawCylinder(start_location: Vector, end_location: Vector, radius: number, segments: number, color: Color?, life_time: number?, thickness: number?): nil
    --- Draws a Debug directional arrow in the world
    --- @param start_location Vector World start location
    --- @param end_location Vector World end location
    --- @param arrow_size number Size of the arrow head
    --- @param color Color The color to use
    --- @param life_time number Seconds before the drawing disappears
    --- @param thickness number Line thickness
    function DrawDirectionalArrow(start_location: Vector, end_location: Vector, arrow_size: number?, color: Color?, life_time: number?, thickness: number?): nil
    --- Draws a Debug Line in the World
    --- @param start_position Vector World start location
    --- @param end_position Vector World end location
    --- @param color Color The color to use
    --- @param life_time number Seconds before the drawing disappears
    --- @param thickness number Line thickness
    function DrawLine(start_position: Vector, end_position: Vector, color: Color?, life_time: number?, thickness: number?): nil
    --- Draws a Debug Point in the World
    --- @param start_position Vector World start location
    --- @param color Color The color to use
    --- @param life_time number Seconds before the drawing disappears
    --- @param size number Size of the drawing
    function DrawPoint(start_position: Vector, color: Color?, life_time: number?, size: number?): nil
    --- Draws a Debug sphere in the World
    --- @param start_location Vector World start location
    --- @param radius number Radius
    --- @param segments number Number of segments used to draw it, more segments look smoother
    --- @param color Color The color to use
    --- @param life_time number Seconds before the drawing disappears
    --- @param thickness number Line thickness
    function DrawSphere(start_location: Vector, radius: number, segments: number, color: Color?, life_time: number?, thickness: number?): nil
    --- Draws a Debug capsule in the World
    --- @param center Vector Center of the capsule
    --- @param half_height number Half of the capsule height
    --- @param radius number Radius of the capsule
    --- @param rotation Rotator Rotation of the capsule
    --- @param color Color The color to use
    --- @param life_time number Seconds before the debug drawing disappears
    --- @param thickness number Line thickness
    function DrawCapsule(center: Vector, half_height: number, radius: number, rotation: Rotator, color: Color?, life_time: number?, thickness: number?): nil
    --- Draws a Debug string in the world
    --- @param location Vector World location
    --- @param text string The text to draw
    --- @param color Color The color to use
    --- @param life_time number Seconds before the drawing disappears
    --- @param draw_shadow boolean Whether to draw a shadow behind the text
    --- @param font_scale number Scale of the text
    function DrawString(location: Vector, text: string, color: Color?, life_time: number?, draw_shadow: boolean?, font_scale: number?): nil
end
@side(client)
declare Debug: Debug__Static

--- Initialize and set Discord activity.
@side(client)
declare interface Discord__Static
    --- Initializes the Discord Integration with your custom client_id
    --- @param client_id number Your Discord application client ID
    function Initialize(client_id: number): nil
    --- Communicates with Discord and sets a custom user status
    --- @param state string First line of the status
    --- @param details string Second line of the status
    --- @param large_image string Asset key of the large image, configured in your Discord application
    --- @param large_text string Tooltip of the large image
    --- @param reset_time boolean Whether or not to reset current activity elapsed time
    function SetActivity(state: string, details: string, large_image: string, large_text: string, reset_time: boolean?): nil
end
@side(client)
declare Discord: Discord__Static

--- Subscribe for user-defined Events.
@side(shared)
declare interface Events__Static
    --- Triggers a local custom Event across all Packages on the same side (Client ➔ Client OR Server ➔ Server)
    --- @param event_name string The Event Name to trigger the event
    --- @param ... any Arguments to pass to the event
    --- @return boolean Returns false if any of the event listeners returned false, otherwise returns true
    function Call(event_name: string, ...: any): boolean
    --- Triggers a remote custom Event from the Client to the Server (Client ➔ Server)
    --- @param event_name string The Event Name to trigger the event
    --- @param reliability Reliability The network reliability rule
    --- @param ... any Arguments to pass to the event
    @side(client)
    function CallRemote(event_name: string, reliability: Reliability?, ...: any): nil
    --- Triggers a remote custom Event from the Server to the Client (Server ➔ Client)
    --- @param event_name string The Event Name to trigger the event
    --- @param player Player The remote player to send this event
    --- @param reliability Reliability The network reliability rule
    --- @param ... any Arguments to pass to the event
    @side(server)
    function CallRemote(event_name: string, player: Player, reliability: Reliability?, ...: any): nil
    --- Triggers a remote custom Event from the Server to an array of specific Players (Server ➔ Clients)
    --- @param event_name string The Event Name to trigger the event
    --- @param players Player[] The remote players to send this event
    --- @param reliability Reliability The network reliability rule
    --- @param ... any Arguments to pass to the event
    @side(server)
    function CallRemotePlayers(event_name: string, players: Player[], reliability: Reliability?, ...: any): nil
    --- Broadcasts a remote custom Event from the Server to ALL currently connected Players (Server ➔ Clients)
    --- @param event_name string The Event Name to trigger the event
    --- @param reliability Reliability The network reliability rule
    --- @param ... any Arguments to pass to the event
    @side(server)
    function BroadcastRemote(event_name: string, reliability: Reliability?, ...: any): nil
    --- Broadcasts a remote custom Event from the Server to all Players currently residing in the specified Dimension (Server ➔ Clients)
    --- @param event_name string The Event Name to trigger the event
    --- @param dimension number The Dimension to send this event
    --- @param reliability Reliability The network reliability rule
    --- @param ... any Arguments to pass to the event
    @side(server)
    function BroadcastRemoteDimension(event_name: string, dimension: number, reliability: Reliability?, ...: any): nil
    --- Broadcasts a remote custom Event from the Server to all Players within a specific location radius (Server ➔ Clients)
    --- @param event_name string The Event Name to trigger the event
    --- @param location Vector The location used to calculate the event radius
    --- @param radius number The radius to send this event
    --- @param reliability Reliability The network reliability rule
    --- @param ... any Arguments to pass to the event
    @side(server)
    function BroadcastRemoteInRadius(event_name: string, location: Vector, radius: number, reliability: Reliability?, ...: any): nil
    --- Broadcasts a remote custom Event from the Server to all Players within a specific location radius AND residing in a specific Dimension (Server ➔ Clients)
    --- @param event_name string The Event Name to trigger the event
    --- @param location Vector The location used to calculate the event radius
    --- @param radius number The radius to send this event
    --- @param dimension number The Dimension to send this event
    --- @param reliability Reliability The network reliability rule
    --- @param ... any Arguments to pass to the event
    @side(server)
    function BroadcastRemoteInRadiusDimension(event_name: string, location: Vector, radius: number, dimension: number, reliability: Reliability?, ...: any): nil
    --- Listens for a local custom Event triggered by `Events.Call()` on the same side
    --- @param event_name string The Event Name to subscribe
    --- @param callback any The callback function to execute
    --- @return any the subscribed callback itself
    function Subscribe(event_name: string, callback: any): any
    --- Listens for a network custom Event
    --- @param event_name string The Event Name to subscribe
    --- @param callback any The callback function to execute
    --- @return any the subscribed callback itself
    function SubscribeRemote(event_name: string, callback: any): any
    --- Removes a local event listener previously registered with `Events.Subscribe()`
    --- @param event_name string The Event Name to unsubscribe
    --- @param callback any The callback function to unsubscribe
    function Unsubscribe(event_name: string, callback: any?): nil
    --- Removes a network event listener previously registered with `Events.SubscribeRemote()`
    --- @param event_name string The Event Name to unsubscribe
    --- @param callback any The callback function to unsubscribe
    function UnsubscribeRemote(event_name: string, callback: any?): nil
end
@side(shared)
declare Events: Events__Static

--- HTTP Requests Interface.
@side(shared)
declare interface HTTP__Static
    --- Makes an asynchronous HTTP Request
    --- @param uri string The main URI (the base address)
    --- @param endpoint string The endpoint
    --- @param method HTTPMethod The HTTP Method to be used
    --- @param data string Payload
    --- @param content_type string The Content Type to be used
    --- @param compress boolean Whether or not to compress the content with gzip
    --- @param headers any The Headers to be used
    --- @param callback any The result
    function RequestAsync(uri: string, endpoint: string?, method: HTTPMethod?, data: string?, content_type: string?, compress: boolean?, headers: any?, callback: any?): nil
    --- Makes a synchronous HTTP Request
    --- @param uri string The main URI (the base address)
    --- @param endpoint string The endpoint
    --- @param method HTTPMethod The HTTP Method to be used
    --- @param data string Payload
    --- @param content_type string The Content Type to be used
    --- @param compress boolean Whether or not to compress the content with gzip
    --- @param headers any The Headers to be used
    --- @return any Table with the response `Status`, `Data` and `Headers`
    @side(server)
    function Request(uri: string, endpoint: string?, method: HTTPMethod?, data: string?, content_type: string?, compress: boolean?, headers: any?): any
    --- Sets the HTTP requests global Connection Timeout in seconds
    --- @param connection_timeout number The timeout in seconds
    function SetConnectionTimeout(connection_timeout: number): nil
    --- Sets the HTTP requests global Read and Write Timeout in seconds
    --- @param read_write_timeout number The timeout in seconds
    function SetReadWriteTimeout(read_write_timeout: number): nil
end
@side(shared)
declare HTTP: HTTP__Static

--- Create custom keybindings and retrieve input information.
@side(client)
declare interface Input__Static
    --- Binds a function to an Input defined using `Register` or from the game
    --- @param binding_name string The keybinding id
    --- @param input_event InputEvent Which event to register (Released/Pressed)
    --- @param callback any The function to trigger
    function Bind(binding_name: string, input_event: InputEvent, callback: any): nil
    --- Unbinds an Input function
    --- @param binding_name string The keybinding id
    --- @param input_event InputEvent Which event to register (Released/Pressed)
    --- @param callback any The specific function to unbind
    function Unbind(binding_name: string, input_event: InputEvent, callback: any?): nil
    --- Registers a keybinding to a default key
    --- @param binding_name string The keybinding id
    --- @param key_name string The Key to use by default if this wasn't set before
    --- @param description string? Text to show on Key Bindings Settings
    function Register(binding_name: string, key_name: string, description: string?): nil
    --- Unregisters a keybinding
    --- @param binding_name string The keybinding id
    function Unregister(binding_name: string): nil
    --- Gets the keyboard layout of the user
    --- @return KeyboardLayout Keyboard layout of the user
    function GetKeyboardLayout(): KeyboardLayout
    --- Gets the icon path of a key
    --- @param key_name string The key name, e.g. `E` or `LeftMouseButton`
    --- @param dark_mode boolean Whether to return the dark version of the icon
    --- @return string Icon path of a key
    function GetKeyIcon(key_name: string, dark_mode: boolean?): string
    --- Gets the key code of a key
    --- @param key_name string The key name, e.g. `E` or `LeftMouseButton`
    --- @return number Key code of a key
    function GetKeyCode(key_name: string): number
    --- Gets the currently pressed modifier keys
    --- @return KeyModifier Currently pressed modifier keys
    function GetModifierKeys(): KeyModifier
    --- Returns the keys bound to a keybinding
    --- @param binding_name string The keybinding id
    --- @return string[] list of all keys
    function GetMappedKeys(binding_name: string): string[]
    --- Resets all bound functions by this Package
    function ResetBindings(): nil
    --- Returns a table with all Scripting KeyBindings
    --- @return any Table with all Scripting KeyBindings
    function GetScriptingKeyBindings(): any
    --- Returns a table with all Game KeyBindings
    --- @return any Table with all Game KeyBindings
    function GetGameKeyBindings(): any
    --- Toggles Local Player input
    --- @param enable_input boolean Whether to enable Local Player input
    function SetInputEnabled(enable_input: boolean): nil
    --- Shows or hides the mouse cursor
    --- @param is_enabled boolean Whether the mouse cursor is enabled
    function SetMouseEnabled(is_enabled: boolean): nil
    --- Sets the current Mouse Cursor type
    --- @param cursor_type CursorType The new current Mouse Cursor type
    function SetMouseCursor(cursor_type: CursorType): nil
    --- Gets the current Mouse Cursor type
    --- @return CursorType the current Cursor type
    function GetMouseCursor(): CursorType
    --- Forces an Input Key event on Local Player
    --- @param key_name string Key Name to input
    --- @param input_event InputEvent Which Event to input
    --- @param amount_depressed number The amount pressed
    function InputKey(key_name: string, input_event: InputEvent, amount_depressed: number?): nil
    --- Returns if a key is being pressed
    --- @param key_name string The key name, e.g. `E` or `LeftMouseButton`
    --- @return boolean if the key is pressed
    function IsKeyDown(key_name: string): boolean
    --- Returns if a Key Binding is being pressed
    --- @param binding_name string The name of the Key Binding
    --- @return boolean if the Key Binding is pressed
    function IsBindingDown(binding_name: string): boolean
    --- Gets if the mouse cursor is enabled
    --- @return boolean if the mouse is visible
    function IsMouseEnabled(): boolean
    --- Gets if the game input is enabled
    --- @return boolean if the input is visible
    function IsInputEnabled(): boolean
    --- Subscribes to an Event
    --- @param event_name string Event to subscribe to
    --- @param callback any Callback to run on the event occurring
    --- @return any The function callback
    function Subscribe(event_name: string, callback: any): any
    --- Unsubscribes from all subscribed Events in this Class and in this Package, optionally passing the function to unsubscribe only that callback
    --- @param event_name string Event to unsubscribe to
    --- @param callback any Optional callback to specifically unsubscribe to
    function Unsubscribe(event_name: string, callback: any?): nil
end
@side(client)
declare Input: Input__Static

--- Work with Unreal level in runtime.
@side(client)
declare interface Level__Static
    --- Loads a Level in runtime
    --- @param level_name string Name of the Stream Level
    --- @param should_block_on_load boolean If this should be a blocking operation - the game will freeze
    --- @param make_visible_after_load boolean If this should be visible automatically after loaded
    function LoadStreamLevel(level_name: string, should_block_on_load: boolean?, make_visible_after_load: boolean?): nil
    --- Unloads a Level in runtime
    --- @param level_name string Name of the Stream Level
    --- @param should_block_on_unload boolean If this should be a blocking operation - the game will freeze
    function UnloadStreamLevel(level_name: string, should_block_on_unload: boolean?): nil
    --- Sets a Stream Level visibility
    --- @param level_name string Name of the Stream Level
    --- @param visibility boolean If this level should be visible
    function SetStreamLevelVisibility(level_name: string, visibility: boolean): nil
    --- Gets a list of all Stream Levels
    --- @return any[] List of all Stream Levels
    function GetStreamLevels(): any[]
    --- Calls a Level Blueprint custom event (which can be added when creating levels through Unreal Engine)
    --- @param event_name string Event or Function name
    --- @param ... any Sequence of arguments to pass to the event
    --- @return any the function return values
    function CallLevelBlueprintEvent(event_name: string, ...: any): any
    --- Subscribes to an Event
    --- @param event_name string Event to subscribe to
    --- @param callback any Callback to run on the event occurring
    --- @return any The function callback
    function Subscribe(event_name: string, callback: any): any
    --- Unsubscribes from all subscribed Events in this Class and in this Package, optionally passing the function to unsubscribe only that callback
    --- @param event_name string Event to unsubscribe to
    --- @param callback any Optional callback to specifically unsubscribe to
    function Unsubscribe(event_name: string, callback: any?): nil
end
@side(client)
declare Level: Level__Static

--- Creates a reachable path into navigable space.
@side(client)
declare interface Navigation__Static
    --- Finds random, reachable point in navigable space restricted to radius around origin
    --- @param origin Vector Center of the search
    --- @param radius number Search radius
    --- @return Vector The random point
    function GetRandomReachablePointInRadius(origin: Vector, radius: number): Vector
    --- Finds random, point in navigable space restricted to Radius around Origin. Resulting location is not tested for reachability from the Origin
    --- @param origin Vector Center of the search
    --- @param radius number Search radius
    --- @return Vector The random point
    function GetRandomPointInNavigableRadius(origin: Vector, radius: number): Vector
    --- Finds a Path given Start and End location
    --- @param start_location Vector World start location
    --- @param end_location Vector World end location
    --- @return any Table with the path points and whether a path was found
    function FindPathToLocation(start_location: Vector, end_location: Vector): any
end
@side(client)
declare Navigation: Navigation__Static

--- Class which represents the current Package
@side(shared)
declare interface Package__Static
    --- Makes any variable available in the global scope
    --- @param variable_name string Name of the variable to export
    --- @param value any Value to be set in the global scope
    function Export(variable_name: string, value: any): nil
    --- Loads a .lua file
    --- @param file_path string Path to the script file to load
    --- @param force_load boolean Whether to force loading this file even if it was already loaded
    --- @return any any return values from the included file
    function Require(file_path: string, force_load: boolean?): any
    --- Compiles a .lua file and returns a function to run it
    --- @param file_path string Path to the script file to compile
    --- @return any the compiled function to run the script, allowing you to pass an environment table for the script
    function LoadFile(file_path: string): any
    --- Reloads a file from `Client/` or `Shared/` folder and sends the updated version to clients, triggering the FileReload event on them
    --- @param file_path string The file path relative to the package root
    @side(server)
    function ReloadClientFile(file_path: string): nil
    --- Subscribes to an Event
    --- @param event_name string Event to subscribe to
    --- @param callback any Callback to run on the event occurring
    --- @return any The function callback
    function Subscribe(event_name: string, callback: any): any
    --- Unsubscribes from all subscribed Events in this Class and in this Package, optionally passing the function to unsubscribe only that callback
    --- @param event_name string Event to unsubscribe to
    --- @param callback any Optional callback to specifically unsubscribe to
    function Unsubscribe(event_name: string, callback: any?): nil
    --- Sets a Persistent Value which will be saved to disk
    --- @param key string Key to index data into. It can be separated by '.' to set a child element.
    --- @param value any Value to set at the key
    function SetPersistentData(key: string, value: any): nil
    --- Gets a list of all directories in this package
    --- @param path_filter string Path filter
    --- @return string[] List of directories
    function GetDirectories(path_filter: string?): string[]
    --- Gets a list of all files in this package
    --- @param path_filter string | any Path filter
    --- @param extension_filter string Example: `.lua`
    --- @return string[] List of files
    function GetFiles(path_filter: string | any?, extension_filter: string?): string[]
    --- Returns the package folder name
    --- @return string The package name/path
    function GetName(): string
    --- Returns the package title
    --- @return string The package title
    function GetTitle(): string
    --- Returns the package version
    --- @return string The package version
    function GetVersion(): string
    --- Returns the package compatibility version
    --- @return string The package compatibility version
    function GetCompatibilityVersion(): string
    --- Gets the Persistent Value from the disk
    --- @param key string The key to get the data
    --- @return any Persistent values from disk
    function GetPersistentData(key: string?): any
    --- Flushes the Persistent Data pending changes to disk immediately
    function FlushPersistentData(): nil
    --- Returns whether this package is currently unloading
    --- @return boolean Whether this package is currently unloading
    function IsUnloading(): boolean
end
@side(shared)
declare Package: Package__Static

--- Interaction with Post Process effects.
@side(client)
declare interface PostProcess__Static
    --- Set Post Process Bloom Settings
    --- @param intensity number Bloom intensity
    --- @param threshold number Minimum brightness for a pixel to bloom
    function SetBloom(intensity: number?, threshold: number?): nil
    --- Set Post Process Chromatic Aberration Settings
    --- @param intensity number Chromatic aberration intensity
    --- @param start_offset number Distance from the screen center where it starts (0 to 1)
    function SetChromaticAberration(intensity: number?, start_offset: number?): nil
    --- Set Post Process Image Effect Settings
    --- @param vignette_intensity number Darkening of the screen edges
    --- @param film_grain_intensity number Amount of film grain noise
    function SetImageEffects(vignette_intensity: number?, film_grain_intensity: number?): nil
    --- Set Post Process Exposure Settings
    --- @param exposure_compensation number Exposure bias, in EV
    --- @param min_ev100 number Min auto exposure brightness, in EV100
    --- @param max_ev100 number Max auto exposure brightness, in EV100
    --- @param low_percent number Histogram low percentage used by auto exposure
    --- @param high_percent number Histogram high percentage used by auto exposure
    function SetExposure(exposure_compensation: number?, min_ev100: number?, max_ev100: number?, low_percent: number?, high_percent: number?): nil
    --- Set Post Process Film Settings
    --- @param slope number Steepness of the tonemapper S-curve
    --- @param toe number Adjusts the dark tones
    --- @param shoulder number Adjusts the bright tones
    --- @param black_clip number Where the dark tones clip
    --- @param white_clip number Where the bright tones clip
    function SetFilm(slope: number?, toe: number?, shoulder: number?, black_clip: number?, white_clip: number?): nil
    --- Set Post Process Saturation Colors. Use Alpha for overall Saturation intensity
    --- @param color Color The new Post Process Saturation Colors. Use Alpha for overall Saturation intensity
    function SetGlobalSaturation(color: Color): nil
    --- Set Post Process Global Gain
    --- @param gain Color The new Post Process Global Gain
    function SetGlobalGain(gain: Color): nil
    --- Set Post Process Global Gamma
    --- @param gamma Color The new Post Process Global Gamma
    function SetGlobalGamma(gamma: Color): nil
    --- Set Post Process Global Contrast
    --- @param contrast Color The new Post Process Global Contrast
    function SetGlobalContrast(contrast: Color): nil
    --- Set Post Process Global Offset
    --- @param offset Color The new Post Process Global Offset
    function SetGlobalOffset(offset: Color): nil
    --- Set Post Process Lookup Table (LUT) Texture
    --- @param texture_path string The new Post Process Lookup Table (LUT) Texture
    function SetLookupTable(texture_path: string): nil
    --- Sets a Post Process Material
    --- @param material_path string The Material Asset to set as Post Process
    function SetMaterial(material_path: string): nil
    --- Removes the current Post Process Material
    function RemoveMaterial(): nil
end
@side(client)
