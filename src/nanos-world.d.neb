-- Server represents all Server controls in the Server side.
@side(server)
declare interface Server__Static
    -- Restarts the server in a new Map, restarts all packages and reconnects all players
    function ChangeMap(map_path: string): nil
    -- Loads a Package
    function LoadPackage(package_folder_name: string): boolean
    -- Reloads a Package on the next server tick
    function ReloadPackage(package_folder_name: string): boolean
    -- Unloads a Package
    function UnloadPackage(package_folder_name: string): boolean
    -- Sets the description of the server, optionally overrides Config.toml
    function SetDescription(description: string, persist_to_config_file: boolean?): nil
    -- Sets the logo of the server, optionally overrides Config.toml
    function SetLogo(logo_url: string, persist_to_config_file: boolean?): nil
    -- Sets the maximum player slots of the server, optionally overrides Config.toml
    function SetMaxPlayers(max_players: number, persist_to_config_file: boolean?): nil
    -- Sets the name of the server, optionally overrides Config.toml
    function SetName(name: string, persist_to_config_file: boolean?): nil
    -- Sets the password of the server, optionally overrides Config.toml
    function SetPassword(password: string, persist_to_config_file: boolean?): nil
    -- Sets the default server dimension that players will spawn in
    function SetDefaultPlayerDimension(default_dimension: number): nil
    -- Sets the default server dimension that entities will spawn in
    function SetDefaultEntityDimension(default_dimension: number): nil
    -- Returns the default player dimension
    function GetDefaultPlayerDimension(): number
    -- Returns the default entity dimension
    function GetDefaultEntityDimension(): number
    -- Returns if the server was started with --enable_unsafe_libs
    function IsUnsafeLibsEnabled(): boolean
    -- Returns the number of connected players (including players in the process of connecting)
    function GetConnectionCount(): number
    -- Returns the players within the specified radius
    function GetPlayersInRadius(location: Vector, radius: number, dimension: number?): Player[]
    -- Returns the actors within the specified radius
    function GetActorsInRadius(location: Vector, radius: number, only_classes: string[]?, dimension: number?): Actor[]
    -- Sets a global value in the Server, which can be accessed from anywhere (server side)
    function SetValue(key: string, value: any, sync_on_client: boolean?): nil
    -- Gets a value given a key
    function GetValue(key: string, fallback: any): any
    -- Gets a list of all values keys
    function GetAllValuesKeys(): string[]
    -- Kicks the player from the server by its Account ID, ideal for kicking from inside PlayerConnect event
    function KickByAccountID(player_account_id: string, reason: string): nil
    -- Ban the player from the server by its Account ID, ideal for banning from inside PlayerConnect event
    function BanByAccountID(player_account_id: string, reason: string): nil
    -- Unbans a Player by its account ID
    function Unban(account_id: string): nil
    -- Stops the server
    function Stop(): nil
    -- Restarts the server, reloading all Packages and reconnecting all Players
    function Restart(): nil
    -- Subscribes for an Event
    function Subscribe(event_name: string, callback: any): any
    -- Unsubscribes from all subscribed Events in this Class and in this Package, optionally passing the function to unsubscribe only that callback
    function Unsubscribe(event_name: string, callback: any?): nil
    -- Returns the current Map Package name
    function GetMap(): string
    -- Returns the current Map Asset reference
    function GetMapAsset(): string
    -- Returns a list of the Custom Config of the current map (defined in the map package's Package.toml)
    function GetMapConfig(): any
    -- Returns a list of the Spawn Points of the current map (defined in the map package's Package.toml)
    function GetMapSpawnPoints(): any[]
    -- Adds a spawn point to the current map's spawn points list
    function AddMapSpawnPoint(location: Vector, rotation: Rotator?): nil
    -- Returns if a Package is currently loaded
    function IsPackageLoaded(package_name: string): boolean
    -- Returns a list of Packages running, optionally returns all Packages installed in the server
    function GetPackages(only_loaded: boolean?, package_type_filter: PackageType?): any[]
    -- Returns the server version
    function GetVersion(): string
    -- Returns the server Public IP
    function GetIP(): string
    -- Returns the server Port
    function GetPort(): number
    -- Returns the current log level
    function GetLogLevel(): number
    -- Returns the entity with the specified ID
    function GetEntityByID(entity_id: number): Entity?
    -- Returns the server QueryPort
    function GetQueryPort(): number
    -- Returns the Max Players configured
    function GetMaxPlayers(): number
    -- Returns the Server Description
    function GetDescription(): string
    -- Returns the Server Name
    function GetName(): string
    -- Returns the Server Custom Settings passed as parameter or New Game screen
    function GetCustomSettings(): any[]
    -- Returns the Configured Tick Rate
    function GetTickRate(): number
    -- Gets the Unix Epoch Time in milliseconds
    function GetTime(): number
    -- Returns if the Server is announced in the Master List
    function IsAnnounced(): boolean
end
@side(server)
declare Server: Server__Static

-- Interact with built-in Sky & Weather system.
