    -- Sets the Text alignment
    @side(shared)
    function SetAlignment(horizontal_alignment: TextRenderHorizontalAlignment, vertical_alignment: TextRenderVerticalAlignment): nil
    -- Sets the horizontal and vertical spacing adjust values
    @side(shared)
    function SetSpacingAdjust(horizontal_spacing: number, vertical_spacing: number): nil
    -- Sets the Text
    @side(shared)
    function SetText(text: string): nil
    -- Sets the Text Color
    @side(shared)
    function SetColor(color: Color): nil
    -- Sets the Word Size
    @side(shared)
    function SetWordSize(word_size: number): nil
end

-- Class to create 3D Text with advanced options
@overrideCtor("$class($args)")
@side(shared)
declare class Text3D extends Entity implements Actor, Paintable
    constructor(location: Vector, rotation: Rotator, text: string, scale: Vector?, color: Color?, font_type: FontType?, align_camera: Text3DAlignCamera?)
    -- Sets the Font
    @side(shared)
    function SetFont(font_type: FontType): nil
    -- Sets the Glyph representation settings to generate the 3D Mesh for this text render
    @side(shared)
    function SetGlyphSettings(extrude: number?, level: number?, bevel_type: Text3DBevelType?, bevel_segments: number?, outline: boolean?): nil
    -- Sets the Max Size of the Text3D, optionally scaling it proportionally
    @side(shared)
    function SetMaxSize(max_width: number?, max_height: number?, scale_proportionally: boolean?): nil
    -- Sets the Text
    @side(shared)
    function SetText(text: string): nil
    -- Sets the Text & Font settings for this text render
    @side(shared)
    function SetTextSettings(kerning: number?, line_spacing: number?, word_spacing: number?, horizontal_alignment: Text3DHorizontalAlignment?, vertical_alignment: Text3DVerticalAlignment?): nil
end

-- A Trigger class is a utility class to trigger events when any Entity enters an Area.
@overrideCtor("$class($args)")
declare class Trigger extends Entity implements Actor
    constructor(location: Vector, rotation: Rotator, extent: Vector | number, trigger_type: TriggerType?, is_visible: boolean?, color: Color?, overlap_only_classes: string[]?)
    -- Forces an Overlap check to occur, will immediately trigger overlaps
    function ForceOverlapChecking(): nil
    -- Sets the extent size of this trigger (sphere triggers can receive as float for radius)
    function SetExtent(extent: Vector | number): nil
    -- Sets the Trigger color (if visible)
    @side(shared)
    function SetColor(color: Color): nil
    -- Sets the filter to Trigger to only overlap specific Classes. Leave it empty for all Classes
    function SetOverlapOnlyClasses(overlap_only_classes: string[]): nil
end

-- Vehicles are wheeled entities which Characters can possess and drive.
@overrideCtor("$class($args)")
declare class VehicleWheeled extends Entity implements Actor, Paintable, Damageable, Vehicle
    constructor(location: Vector, rotation: Rotator, asset: string, collision_type: CollisionType?, gravity_enabled: boolean?, auto_unflip: boolean?, engine_sound: string?, horn_sound: string?, brake_sound: string?, engine_start_sound: string?, vehicle_door_sound: string?, auto_start_engine: boolean?, custom_animation_blueprint: string?, spawn_mode: SpawnMode?)
    -- Starts or stops the vehicle horn
    @side(server)
    function Horn(enable_horn: boolean): nil
    -- Sets the sound asset used by the vehicle horn
    @side(server)
    function SetHornSound(sound_asset: string): nil
    -- Sets if the Engine auto starts when the driver enters the Vehicle
    @side(server)
    function SetAutoStartEngine(auto_start: boolean): nil
    -- Sets if the Engine is turned off/on
    @side(server)
    function SetEngineStarted(started: boolean): nil
    -- Configures the Vehicle Steering
    @side(server)
    function SetSteeringSetup(steering_type: SteeringType, angle_ratio: number?, steering_curve: any?): nil
    -- Configures the Vehicle Engine (Torque, RPM, Braking)
    @side(server)
    function SetEngineSetup(max_torque: number?, max_rpm: number?, idle_rpm: number?, brake_effect: number?, rev_up_moi: number?, rev_down_rate: number?, torque_curve: any?): nil
    -- Configures the Vehicle Aerodynamics Settings
    @side(server)
    function SetAerodynamicsSetup(mass: number?, drag_coefficient: number?, vehicle_chassis_width: number?, vehicle_chassis_height: number?, vehicle_downforce_coefficient: number?, center_of_mass_override: Vector?): nil
    -- Configures the Vehicle Transmission
    @side(server)
    function SetTransmissionSetup(transmission_final_ratio: number?, transmission_change_up_rpm: number?, transmission_change_down_rpm: number?, transmission_gear_change_time: number?, transmission_efficiency: number?, forward_gear_ratios: number[]?, reverse_gear_ratios: number[]?): nil
    -- Configures a Vehicle Wheel
    @side(server)
    function SetWheel(index: number, bone_name: string, radius: number?, width: number?, max_steer_angle: number?, offset: Vector?, is_affected_by_engine: boolean?, is_affected_by_brake: boolean?, is_affected_by_handbrake: boolean?, has_abs_enabled: boolean?, has_traction_control_enabled: boolean?, max_brake_torque: number?, max_handbrake_torque: number?, cornering_stiffness: number?, side_slip_modifier: number?, friction_force_multiplier: number?, slip_threshold: number?, skid_threshold: number?, suspension_spring_rate: number?, suspension_spring_preload: number?, suspension_max_raise: number?, suspension_max_drop: number?, suspension_smoothing: number?, suspension_damping_ratio: number?, suspension_wheel_load_ratio: number?, suspension_axis: Vector?, suspension_force_offset: Vector?, suspension_sweep_shape: SuspensionSweepShape?): nil
    -- Configures the type of Differential
    @side(server)
    function SetDifferentialSetup(differential_type: DifferentialType, front_rear_split: number?): nil
    -- Configures where the Steering Wheel is located
    @side(server)
    function SetSteeringWheelSetup(relative_location: Vector, radius: number, rotation: Rotator?): nil
    -- Configures the Headlights offset and color
    @side(server)
    function SetHeadlightsSetup(location: Vector, color: Color?): nil
    -- Configures the Taillights offset
    @side(server)
    function SetTaillightsSetup(location: Vector): nil
    -- Enables or disables the headlights
    @side(server)
    function SetHeadlightsEnabled(is_enabled: boolean): nil
    -- Enables or disables the taillights
    @side(server)
    function SetTaillightsEnabled(is_enabled: boolean): nil
    -- Sets a Tire as Flat or not
    @side(server)
    function SetTireFlat(wheel_index: number, is_flat: boolean): nil
    -- Gets the current RPM
    @side(client)
    function GetRPM(): number
    -- Gets the current Gear
    @side(client)
    function GetGear(): number
    -- Checks if the vehicle is in the air (no wheels touching the ground)
    @side(client)
    function IsInAir(): boolean
end

-- VehicleWater are entities which Characters can possess and drive over the water with dynamic physics.
@overrideCtor("$class($args)")
@side(server)
declare class VehicleWater extends Entity implements Actor, Paintable, Damageable, Vehicle
    constructor(location: Vector, rotation: Rotator, asset: string, collision_type: CollisionType?, gravity_enabled: boolean?, spawn_mode: SpawnMode?)
    -- Sets the relative location of the Engine (where the Physics Thruster, sounds and effects are attached)
    @side(server)
    function SetEngineOffset(offset: Vector): nil
    -- Sets the force of the Engine/Thruster
    @side(server)
    function SetThrustStrength(force: number): nil
end

-- Weapons are entities with firing, reloading and aiming functionalities.
-- 
-- They are fully customizable, all pieces of the weapon can be changed with immense possibility of creation.
@overrideCtor("$class($args)")
declare class Weapon extends Entity implements Actor, Paintable, Pickable
    constructor(location: Vector, rotation: Rotator, asset: string, collision_type: CollisionType?, gravity_enabled: boolean?, spawn_mode: SpawnMode?)
    -- Forces this Weapon to reload
    @side(server)
    function Reload(): nil
    -- Sets this Weapon's Ammo in the Bag
    @side(server)
    function SetAmmoBag(new_ammo_bag: number): nil
    -- Sets this Weapon's Ammo in the Clip
    @side(server)
    function SetAmmoClip(new_ammo_clip: number): nil
    -- Sets the ammo counts and the clip capacity at once
    @side(server)
    function SetAmmoSettings(ammo_clip: number, ammo_bag: number, ammo_to_reload: number?, clip_capacity: number?): nil
    -- Sets the Animation played by the Weapon itself when firing
    @side(server)
    function SetAnimationFire(animation_fire_path: string, play_rate: number?): nil
    -- Sets the Animation played by the Character when firing this Weapon
    @side(server)
    function SetAnimationCharacterFire(animation_character_fire_path: string, play_rate: number?): nil
    -- Sets the Animation played by the Character when reloading this Weapon
    @side(server)
    function SetAnimationReload(reload_animation_path: string, play_rate: number?): nil
    -- Gets the reload animation
    @side(shared)
    function GetAnimationReload(): string
    -- Sets if the Character will reload automatically when the clip is empty
    @side(server)
    function SetAutoReload(auto_reload: boolean): nil
    -- Set the Bullet Color
    @side(server)
    function SetBulletColor(bullet_color: Color): nil
    -- Sets how many bullets are fired per shot and how they look and travel
    @side(server)
    function SetBulletSettings(bullet_count: number, bullet_max_distance: number, bullet_velocity: number, bullet_color: Color): nil
    -- Sets the time between shots
    @side(server)
    function SetCadence(cadence: number): nil
    -- Sets the max number of bullets the Weapon's clip can hold
    @side(server)
    function SetClipCapacity(clip: number): nil
    -- Set the Base Weapon's Damage
    @side(server)
    function SetDamage(damage: number): nil
    -- Sets how the Character grabs this Weapon
    @side(server)
    function SetHandlingMode(handling_mode: HandlingMode): nil
    -- Sets where the Character's left hand holds this Weapon, relative to the Weapon
    @side(server)
    function SetLeftHandTransform(left_hand_location: Vector, left_hand_rotation: Rotator): nil
    -- Set the mesh used when the Character reloads the weapon
    @side(server)
    function SetMagazineMesh(magazine_mesh: string, magazine_mesh_hide_bone: string?): nil
    -- Plays an Animation on this Weapon
    @side(shared)
    function PlayAnimation(animation_path: string, slot_name: string?, loop_indefinitely: boolean?, blend_in_time: number?, blend_out_time: number?, play_rate: number?, stop_all_montages: boolean?): nil
    -- Stops an Animation Montage on this Weapon
    @side(shared)
    function StopAnimation(animation_asset: string?): nil
    -- Sets the Particle of the bullet trail
    @side(server)
    function SetParticlesBulletTrail(particle_bullet_trail_asset_path: string): nil
    -- Sets the Particle of the fire blast at the muzzle
    @side(server)
    function SetParticlesBarrel(particle_asset_path: string): nil
    -- Sets the Particle of the empty shells ejected when firing
    @side(server)
    function SetParticlesShells(particle_shells_asset_path: string): nil
    -- Set the offset of Right Hand
    @side(server)
    function SetRightHandOffset(right_hand_offset: Vector): nil
    -- Sets the Field of View multiplier applied when aiming down sights
    @side(server)
    function SetSightFOVMultiplier(sight_fov_multiplier: number): nil
    -- Sets the offset that aligns the Player's view with the Weapon's sight when aiming down sights
    @side(server)
    function SetSightTransform(sight_location: Vector, sight_rotation: Rotator): nil
    -- Sets the Sound played when trying to fire with an empty clip
    @side(server)
    function SetSoundDry(sound_dry_asset_path: string, volume: number?, pitch: number?): nil
    -- Sets the Sound played when loading a magazine
    @side(server)
    function SetSoundLoad(sound_load_asset_path: string, volume: number?, pitch: number?): nil
    -- Sets the Sound played when unloading a magazine
    @side(server)
    function SetSoundUnload(sound_unload_asset_path: string, volume: number?, pitch: number?): nil
    -- Sets the Sound played when zooming
    @side(server)
    function SetSoundZooming(sound_zooming_asset_path: string, volume: number?, pitch: number?): nil
    -- Sets the Sound played when firing
    @side(server)
    function SetSoundFire(sound_fire_asset_path: string, volume: number?, pitch: number?): nil
    -- Sets the Sound played when starting to aim
    @side(server)
    function SetSoundAim(sound_aim_asset_path: string, volume: number?, pitch: number?): nil
    -- Sound when firing with only having X remaining bullets in the magazine
    @side(server)
    function SetSoundFireLastBullets(sound_asset_path: string, remaining_bullets_count: number?): nil
    -- Sets the base spread of this Weapon
    @side(server)
    function SetSpread(spread: number): nil
    -- Sets the base recoil of this Weapon
    @side(server)
    function SetRecoil(recoil: number): nil
    -- Sets if the Weapon can hold to keep firing and if it needs to release to fire
    @side(server)
    function SetUsageSettings(can_hold_use: boolean, hold_release_use: boolean): nil
    -- Sets how the bullet will pass through walls
    @side(server)
    function SetWallbangSettings(max_distance: number, damage_multiplier: number): nil
    -- Gets this Weapon's Ammo Bag
    @side(shared)
    function GetAmmoBag(): number
    -- Gets this Weapon's Ammo Clip
    @side(shared)
    function GetAmmoClip(): number
    -- Gets the amount of ammo needed to fully reload
    @side(shared)
    function GetAmmoToReload(): number
    -- Gets the Animation played by the Character when firing
    @side(shared)
    function GetAnimationCharacterFire(): string
    -- Gets the Animation played by the Weapon when firing
    @side(shared)
    function GetAnimationFire(): string
    -- Gets the magazine Static Mesh used when reloading
    @side(shared)
    function GetMagazineMesh(): string
    -- Gets the Particle of the bullet trail
    @side(shared)
    function GetParticlesBulletTrail(): string
    -- Gets the Particle of the Fire Blast in the muzzle
    @side(shared)
    function GetParticlesBarrel(): string
    -- Gets the max distance a bullet can pass through walls
    @side(shared)
    function GetWallbangMaxDistance(): number
    -- Gets the damage multiplier applied when a bullet passes through a wall
    @side(shared)
    function GetWallbangDamageMultiplier(): number
    -- Gets the Particle of the ejected shells
    @side(shared)
    function GetParticlesShells(): string
    -- Gets the Sound played when firing with an empty clip
    @side(shared)
    function GetSoundDry(): string
    -- Gets the Sound played when loading a magazine
    @side(shared)
    function GetSoundLoad(): string
    -- Gets the Sound played when unloading a magazine
    @side(shared)
    function GetSoundUnload(): string
    -- Gets the Sound played when zooming
    @side(shared)
    function GetSoundZooming(): string
    -- Gets the Sound played when aiming
    @side(shared)
    function GetSoundAim(): string
    -- Gets the Sound played when firing
    @side(shared)
    function GetSoundFire(): string
    -- Gets if the weapon can be used continuously by holding the use button
    @side(shared)
    function GetCanHoldUse(): boolean
    -- Gets if the weapon is triggered/fired when releasing the use button
    @side(shared)
    function GetHoldReleaseUse(): boolean
    -- Gets how many bullets are fired per shot
    @side(shared)
    function GetBulletCount(): number
    -- Gets the color of the bullet trail
    @side(shared)
    function GetBulletColor(): Color
    -- Gets the time between shots
    @side(shared)
    function GetCadence(): number
    -- Gets the max number of bullets the clip can hold
    @side(shared)
    function GetClipCapacity(): number
    -- Gets the base damage of this Weapon
    @side(shared)
    function GetDamage(): number
    -- Gets the offset of the right hand, relative to the camera
    @side(shared)
    function GetRightHandOffset(): Vector
    -- Gets the location offset of the left hand
    @side(shared)
    function GetLeftHandLocation(): Vector
    -- Gets the rotation offset of the left hand
    @side(shared)
    function GetLeftHandRotation(): Rotator
    -- Gets the sight location offset used when aiming down sights
    @side(shared)
    function GetSightLocation(): Vector
    -- Gets the sight rotation used when aiming down sights
    @side(shared)
    function GetSightRotation(): Rotator
    -- Gets the Field of View multiplier applied when aiming down sights
    @side(shared)
    function GetSightFOVMultiplier(): number
    -- Gets the base spread of this Weapon
    @side(shared)
    function GetSpread(): number
    -- Gets the base recoil of this Weapon
    @side(shared)
    function GetRecoil(): number
end

-- Class for spawning a dynamic Web Browser.
@overrideCtor("$class($args)")
@side(client)
declare class WebUI extends Entity
    constructor(name: string, path: string, visibility: WidgetVisibility?, is_transparent: boolean?, auto_resize: boolean?, width: number?, height: number?)
    -- Puts this WebUI in the front of all WebUIs and Widgets
    @side(client)
    function BringToFront(): nil
    -- Calls an Event on the Browser's JavaScript
    @side(client)
    function CallEvent(event_name: string, ...: any): nil
    -- Loads a new File/URL in this Browser
    @side(client)
    function LoadURL(url: string): nil
    -- Loads a pure HTML in this Browser
    @side(client)
    function LoadHTML(html: string): nil
    -- Gets this WebUI name
    @side(client)
    function GetName(): string
    -- Executes a JavaScript code in the Browser
    @side(client)
    function ExecuteJavaScript(javascript_code: string): nil
    -- Enables the focus on this browser (i.e. can receive Keyboard input and will trigger input events)
    @side(client)
    function SetFocus(): nil
    -- Returns if this WebUI has any DOM Node focused
    @side(client)
    function HasNodeFocus(): boolean
    -- Removes the focus from this WebUI (and sets it back to game viewport)
    @side(client)
    function RemoveFocus(): nil
    -- Sets the Layout as Canvas on Screen
    @side(client)
    function SetLayout(location: Vector2D?, size: Vector2D?, anchors_min: Vector2D?, anchors_max: Vector2D?, alignment: Vector2D?): nil
    -- Freezes the WebUI rendering to the surface (JavaScript keeps running)
    @side(client)
    function SetFreeze(freeze: boolean): nil
    -- Sets the visibility in screen
    @side(client)
    function SetVisibility(visibility: WidgetVisibility): nil
    -- Spawns a Sound entity that plays this WebUI audio
    @side(client)
    function SpawnSound(location: Vector?, is_2d: boolean?, volume: number?, inner_radius: number?, falloff_distance: number?, attenuation_function: AttenuationFunction?): Sound
    -- Sends a Mouse Event into the WebUI programmatically
    @side(client)
    function SendMouseWheelEvent(mouse_x: number, mouse_y: number, delta_x: number, delta_y: number): nil
    -- Sends a Key Event into the WebUI programmatically
    @side(client)
    function SendKeyEvent(key_type: WebUIKeyType, key_code: number, modifiers: WebUIModifier?): nil
    -- Sends a Mouse Move Event into the WebUI programmatically
    @side(client)
    function SendMouseMoveEvent(mouse_x: number, mouse_y: number, modifiers: WebUIModifier?, mouse_leave: boolean?): nil
    -- Sends a Mouse Click into the WebUI programmatically
    @side(client)
    function SendMouseClickEvent(mouse_x: number, mouse_y: number, mouse_type: WebUIMouseType, is_mouse_up: boolean, modifiers: WebUIModifier?, click_count: number?): nil
    -- Gets the current size of this WebUI
    @side(client)
    function GetSize(): Vector2D
    -- Returns the current WebUI visibility
    @side(client)
    function GetVisibility(): WidgetVisibility
    -- Returns if this WebUI is currently frozen
    @side(client)
    function IsFrozen(): boolean
    -- Returns if this WebUI is ready
    @side(client)
    function IsReady(): boolean
    -- Opens the Developer Tools for this WebUI, it only works if the Client.SetDebugEnabled() was not disabled
    @side(client)
    function OpenDevTools(): nil
    -- Closes the Developer Tools for this WebUI, it only works if the Client.SetDebugEnabled() not disabled
    @side(client)
    function CloseDevTools(): nil
end

-- The Widget class supports spawning Unreal Widgets classes through scripting and manipulate them such as Blueprints!
@overrideCtor("$class($args)")
@side(client)
declare class Widget extends Entity
    -- Spawns a Widget passing a UserWidget blueprint
    constructor(blueprint_path: string)
    -- Spawns a Widget passing a NativeWidget enum
    constructor(native_widget: NativeWidget)
    -- Spawns a 3D Widget actor rendering this Widget in the world
    @side(client)
    function SpawnWidget3D(location: Vector?, rotation: Rotator?, widget_space: WidgetSpace?, auto_size: boolean?, size: Vector2D?, auto_repaint_rate: number?, pivot: Vector2D?): Widget3D
    -- Sets the visibility in screen
    @side(client)
    function SetVisibility(visibility: WidgetVisibility): nil
    -- Returns the current WebUI visibility
    @side(client)
    function GetVisibility(): WidgetVisibility
    -- Enables the focus on this Widget (i.e. can receive Keyboard input and will trigger input events)
    @side(client)
    function SetFocus(): nil
    -- Puts this Widget in the front of all WebUIs and Widgets
    @side(client)
    function BringToFront(): nil
    -- Adds it to the game's viewport and fills the entire screen
    @side(client)
    function AddToViewport(): nil
    -- Adds a new child widget to this Widget container, if this is a Panel
    @side(client)
    function AddChild(other: WebUI | Widget): nil
    -- Sets the widget for a given slot by name, if this is a UserWidget
    @side(client)
    function SetContentForSlot(slot_name: string, widget: Widget?): nil
    -- Sets the Layout as Canvas on Screen
    @side(client)
    function SetSlotCanvasLayout(location: Vector2D?, size: Vector2D?, anchors_min: Vector2D?, anchors_max: Vector2D?, alignment: Vector2D?): nil
    -- Calls a Blueprint Event or Function
    @side(client)
    function CallBlueprintEvent(event_name: string, ...: any): any
    -- Assigns and Binds a Blueprint Event Dispatcher
    @side(client)
    function BindBlueprintEventDispatcher(dispatcher_name: string, callback: any): any
    -- Unbinds a Blueprint Event Dispatcher
    @side(client)
    function UnbindBlueprintEventDispatcher(dispatcher_name: string, callback: any?): nil
    -- Sets a Blueprint Property/Variable value directly
    @side(client)
    function SetBlueprintPropertyValue(property_name: string, value: any): nil
    -- Gets a Blueprint Property/Variable value
    @side(client)
    function GetBlueprintPropertyValue(property_name: string): any
    -- Sets the slot alignment for horizontal and vertical positioning
    @side(client)
    function SetSlotAlignment(horizontal_alignment: WidgetHorizontalAlignment?, vertical_alignment: WidgetVerticalAlignment?): nil
    -- Sets the slot padding for horizontal and vertical spacing
    @side(client)
    function SetSlotPadding(padding_horizontal: Vector2D?, padding_vertical: Vector2D?): nil
    -- Sets the slot size and size rule
    @side(client)
    function SetSlotSize(size: number?, slate_size_rule: WidgetSizeRule?): nil
end

-- The Widget3D class is the 3D representation of a Widget class spawned in the world.
@side(client)
declare class Widget3D extends Entity implements Actor
    -- Sets the auto repaint rate
    @side(client)
    function SetAutoRepaintRate(rate: number): nil
    -- Forces this to repaint
    @side(client)
    function Repaint(): nil
    -- Gets the Widget rendered by this Widget3D
    @side(client)
    function GetWidget(): Widget
end

-- ========================================================================
-- Utility classes
-- ========================================================================

-- JSON library.
declare interface JSON__Static
    -- Returns a string representing value encoded in JSON
    function stringify(value: any): string
    -- Returns a value representing the decoded JSON string
    function parse(value: string): any
end
declare JSON: JSON__Static

-- A table containing useful and aux Math functions.
declare interface NanosMath__Static
    -- Rounds a number to the nearest value with the given decimal places
    function Round(value: number, decimals: number?): number
    -- Clamps a number
    function Clamp(value: number, min: number, max: number): number
    -- Clamps an angle to the range of [0, 360]
    function ClampAxis(value: number): number
    -- Clamps an angle to the range of [-180, 180]
    function NormalizeAxis(value: number): number
    -- Calculates the location and rotation relative to an actor
    function RelativeTo(location: Vector, rotation: Rotator, actor: Actor): (Vector, Rotator)
    -- Converts a local location and rotation to world coordinates based on an actor's transform
    function LocalToWorld(local_location: Vector, local_rotation: Rotator, actor: Actor): (Vector, Rotator)
    -- Returns a random float value
    function RandomFloat(min: number, max: number): number
    -- Interpolate number from Current to Target
    function FInterpTo(current: number, target: number, delta_time: number, interp_speed: number): number
    -- Interpolate Rotator from Current to Target
    function RInterpTo(current: Rotator, target: Rotator, delta_time: number, interp_speed: number): Rotator
    -- Interpolate Rotator from Current to Target with a constant step
    function RInterpConstantTo(current: Rotator, target: Rotator, delta_time: number, interp_speed: number): Rotator
    -- Interpolate Vector from Current to Target
    function VInterpTo(current: Vector, target: Vector, delta_time: number, interp_speed: number): Vector
    -- Interpolate Vector from Current to Target with a constant step
    function VInterpConstantTo(current: Vector, target: Vector, delta_time: number, interp_speed: number): Vector
end
declare NanosMath: NanosMath__Static

-- A table containing useful and aux functions.
declare interface NanosUtils__Static
    -- Returns if an entity is valid
    function IsEntityValid(entity: any): boolean
    -- Benchmarks a function performance
    function Benchmark(name: string, amount: number, func: any, ...: any): number
end
declare NanosUtils: NanosUtils__Static

-- A table containing useful and aux table functions.
declare interface NanosTable__Static
    -- Dumps a table into a readable text
    function Dump(table: any): string
    -- Performs a shallow copy of a table
    function ShallowCopy(table: any): any
end
declare NanosTable: NanosTable__Static

-- TOML library.
declare interface TOML__Static
    -- Returns a string representing value encoded in TOML
    function Dump(value: any): string
    -- Returns a value representing the decoded TOML string
    function Parse(value: string): any
end
declare TOML: TOML__Static

-- ========================================================================
-- Static classes
-- ========================================================================

-- Retrieve Assets Data from Asset Packs.
@side(shared)
declare interface Assets__Static
    -- Gets a list containing information about all loaded Asset Packs
    function GetAssetPacks(): any[]
    -- Gets the file path of an asset
    function GetAssetPath(asset: string, asset_type: AssetType): string
    -- Gets a list containing all Animation Assets Keys from an AssetPack
    function GetAnimations(asset_pack_path: string): any[]
    -- Gets a list containing all Blueprints Assets Keys from an AssetPack
    function GetBlueprints(asset_pack_path: string): any[]
    -- Gets a list containing all Map Asset Keys from an AssetPack
    function GetMaps(asset_pack_path: string): any[]
    -- Gets a list containing all Materials Asset Keys from an AssetPack
    function GetMaterials(asset_pack_path: string): any[]
    -- Gets a list containing all Particle Assets Keys from an AssetPack
    function GetParticles(asset_pack_path: string): any[]
    -- Gets a list containing all Sound Assets Keys from an AssetPack
    function GetSounds(asset_pack_path: string): any[]
    -- Gets a list containing all Skeletal Mesh Asset Keys from an AssetPack
    function GetSkeletalMeshes(asset_pack_path: string): any[]
    -- Gets a list containing all Static Mesh Assets Keys from an AssetPack
    function GetStaticMeshes(asset_pack_path: string): any[]
    -- Gets a list containing all Other Assets Keys from an AssetPack
    function GetOthers(asset_pack_path: string): any[]
    -- Manually adds an Asset to be loaded during the Player's loading screen
    @side(server)
    function Precache(asset_path: string, asset_type: AssetType): nil
end
@side(shared)
declare Assets: Assets__Static

