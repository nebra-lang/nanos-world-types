--- Server represents all Server controls in the Server side.
@side(server)
declare interface Server__Static
    --- Restarts the server in a new Map, restarts all packages and reconnects all players
    --- @param map_path string The new map to load
    function ChangeMap(map_path: string): nil
    --- Loads a Package
    --- @param package_folder_name string The package to load
    --- @return boolean if the Package was loaded
    function LoadPackage(package_folder_name: string): boolean
    --- Reloads a Package on the next server tick
    --- @param package_folder_name string The package to reload
    --- @return boolean if the Package was found
    function ReloadPackage(package_folder_name: string): boolean
    --- Unloads a Package
    --- @param package_folder_name string The package you want unload
    --- @return boolean if the Package was found
    function UnloadPackage(package_folder_name: string): boolean
    --- Sets the description of the server, optionally overrides Config.toml
    --- @param description string The new description
    --- @param persist_to_config_file boolean Persist to config file
    function SetDescription(description: string, persist_to_config_file: boolean?): nil
    --- Sets the logo of the server, optionally overrides Config.toml
    --- @param logo_url string The new logo
    --- @param persist_to_config_file boolean Persist to config file
    function SetLogo(logo_url: string, persist_to_config_file: boolean?): nil
    --- Sets the maximum player slots of the server, optionally overrides Config.toml
    --- @param max_players number The maximum players
    --- @param persist_to_config_file boolean Persist to config file
    function SetMaxPlayers(max_players: number, persist_to_config_file: boolean?): nil
    --- Sets the name of the server, optionally overrides Config.toml
    --- @param name string The new name
    --- @param persist_to_config_file boolean Persist to config file
    function SetName(name: string, persist_to_config_file: boolean?): nil
    --- Sets the password of the server, optionally overrides Config.toml
    --- @param password string The new password
    --- @param persist_to_config_file boolean Persist to config file
    function SetPassword(password: string, persist_to_config_file: boolean?): nil
    --- Sets the default server dimension that players will spawn in
    --- @param default_dimension number The new default server dimension that players will spawn in
    function SetDefaultPlayerDimension(default_dimension: number): nil
    --- Sets the default server dimension that entities will spawn in
    --- @param default_dimension number The new default server dimension that entities will spawn in
    function SetDefaultEntityDimension(default_dimension: number): nil
    --- Returns the default player dimension
    --- @return number Default player dimension
    function GetDefaultPlayerDimension(): number
    --- Returns the default entity dimension
    --- @return number Default entity dimension
    function GetDefaultEntityDimension(): number
    --- Returns if the server was started with --enable_unsafe_libs
    --- @return boolean Whether the server was started with --enable_unsafe_libs
    function IsUnsafeLibsEnabled(): boolean
    --- Returns the number of connected players (including players in the process of connecting)
    --- @return number Number of connected players
    function GetConnectionCount(): number
    --- Returns the players within the specified radius
    --- @param location Vector The center location of the search
    --- @param radius number The search radius
    --- @param dimension number The dimension to search in
    --- @return Player[] The players found in radius
    function GetPlayersInRadius(location: Vector, radius: number, dimension: number?): Player[]
    --- Returns the actors within the specified radius
    --- @param location Vector The center location of the search
    --- @param radius number The search radius
    --- @param only_classes string[] Only actors of these classes will be returned (pass empty for all classes)
    --- @param dimension number The dimension to search in (pass 0 for all dimensions)
    --- @return Actor[] The actors found in radius
    function GetActorsInRadius(location: Vector, radius: number, only_classes: string[]?, dimension: number?): Actor[]
    --- Sets a global value in the Server, which can be accessed from anywhere (server side)
    --- @param key string Key
    --- @param value any Value
    --- @param sync_on_client boolean If enabled will sync this value through all clients, accessible through `Client.GetValue()` static class
    function SetValue(key: string, value: any, sync_on_client: boolean?): nil
    --- Gets a value given a key
    --- @param key string Key
    --- @param fallback any Fallback Value if key doesn't exist
    --- @return any Value at key or fallback if key doesn't exist
    function GetValue(key: string, fallback: any): any
    --- Gets a list of all values keys
    --- @return string[] a list with all values keys
    function GetAllValuesKeys(): string[]
    --- Kicks the player from the server by its Account ID, ideal for kicking from inside PlayerConnect event
    --- @param player_account_id string The Player's nanos world account ID
    --- @param reason string The reason shown to the Player
    function KickByAccountID(player_account_id: string, reason: string): nil
    --- Ban the player from the server by its Account ID, ideal for banning from inside PlayerConnect event
    --- @param player_account_id string The Player's nanos world account ID
    --- @param reason string The reason shown to the Player
    function BanByAccountID(player_account_id: string, reason: string): nil
    --- Unbans a Player by its account ID
    --- @param account_id string nanos account ID
    function Unban(account_id: string): nil
    --- Stops the server
    function Stop(): nil
    --- Restarts the server, reloading all Packages and reconnecting all Players
    function Restart(): nil
    --- Subscribes for an Event
    --- @param event_name string The name of the Event
    --- @param callback any Callback function
    --- @return any the function callback itself
    function Subscribe(event_name: string, callback: any): any
    --- Unsubscribes from all subscribed Events in this Class and in this Package, optionally passing the function to unsubscribe only that callback
    --- @param event_name string The name of the Events
    --- @param callback any Callback function
    function Unsubscribe(event_name: string, callback: any?): nil
    --- Returns the current Map Package name
    --- @return string the current map package
    function GetMap(): string
    --- Returns the current Map Asset reference
    --- @return string the current map asset
    function GetMapAsset(): string
    --- Returns a list of the Custom Config of the current map (defined in the map package's Package.toml)
    --- @return any a list of the Custom Config of the current map
    function GetMapConfig(): any
    --- Returns a list of the Spawn Points of the current map (defined in the map package's Package.toml)
    --- @return any[] a list of the Spawn Points of the current map
    function GetMapSpawnPoints(): any[]
    --- Adds a spawn point to the current map's spawn points list
    --- @param location Vector Spawn location
    --- @param rotation Rotator Spawn rotation
    function AddMapSpawnPoint(location: Vector, rotation: Rotator?): nil
    --- Returns if a Package is currently loaded
    --- @param package_name string The package folder name
    --- @return boolean If the package is loaded
    function IsPackageLoaded(package_name: string): boolean
    --- Returns a list of Packages running, optionally returns all Packages installed in the server
    --- @param only_loaded boolean Set to true the function return only loaded and running packages. Caution: setting to false will retrieve Packages list from disk, which is a slow operation!
    --- @param package_type_filter PackageType Which Package type to return. Leave it default to return all types.
    --- @return any[] a list of Packages data
    function GetPackages(only_loaded: boolean?, package_type_filter: PackageType?): any[]
    --- Returns the server version
    --- @return string the server version
    function GetVersion(): string
    --- Returns the server Public IP
    --- @return string the server Public IP
    function GetIP(): string
    --- Returns the server Port
    --- @return number the server Port
    function GetPort(): number
    --- Returns the current log level
    --- @return number the log level
    function GetLogLevel(): number
    --- Returns the entity with the specified ID
    --- @param entity_id number The entity ID
    --- @return Entity? the entity
    function GetEntityByID(entity_id: number): Entity?
    --- Returns the server QueryPort
    --- @return number the server QueryPort
    function GetQueryPort(): number
    --- Returns the Max Players configured
    --- @return number the max players configured
    function GetMaxPlayers(): number
    --- Returns the Server Description
    --- @return string the Server Description
    function GetDescription(): string
    --- Returns the Server Name
    --- @return string The Server Name
    function GetName(): string
    --- Returns the Server Custom Settings passed as parameter or New Game screen
    --- @return any[] a list of the Custom Settings
    function GetCustomSettings(): any[]
    --- Returns the Configured Tick Rate
    --- @return number the server Tick Rate
    function GetTickRate(): number
    --- Gets the Unix Epoch Time in milliseconds
    --- @return number the unix timestamp
    function GetTime(): number
    --- Returns if the Server is announced in the Master List
    --- @return boolean if the Server is announced in the Master List
    function IsAnnounced(): boolean
end
@side(server)
declare Server: Server__Static

--- Interact with built-in Sky & Weather system.
@side(client)
declare interface Sky__Static
    --- Replaces all Sky/Sun actors with the Ultra Dynamic Sky Actor, to be able to use the functions from this page
    --- @param spawn_weather boolean Whether or not to spawn the Weather Actor (to be able to use Weather related methods)
    --- @param find_existing boolean Whether or not to try to find existing Sky & Weather Actors spawned in the map, using their references instead
    --- @return boolean true if an existing Ultra Dynamic Sky Actor was found in the map and its reference was used, false if a new one was spawned
    function Spawn(spawn_weather: boolean?, find_existing: boolean?): boolean
    --- Destroys all Directional Lights, Sky Lights, Exponential Height Fogs, Volumetric Clouds, Sky Atmosphere, Ultra Dynamic Sky Actors and all Actors with the `Sun` Actor Tag from the Level
    function DestroyAllSky(): nil
    --- Reconstruct the Ultra Dynamic Sky Actor, forces most of the changes to be applied
    function Reconstruct(): nil
    --- Sets the Moon Texture
    --- @param texture string The new Moon Texture
    function SetMoonTexture(texture: string): nil
    --- Sets the Moon Texture Rotation
    --- @param rotation number The new Moon Texture Rotation
    function SetMoonTextureRotation(rotation: number): nil
    --- Sets the Moon Vertical Offset
    --- @param offset number The new Moon Vertical Offset
    function SetMoonVerticalOffset(offset: number): nil
    --- Sets the Moon Scale
    --- @param scale number The new Moon Scale
    function SetMoonScale(scale: number): nil
    --- Sets the Moon Angle
    --- @param yaw number Yaw angle, in degrees
    --- @param pitch number Pitch angle, in degrees
    function SetMoonAngle(yaw: number, pitch: number): nil
    --- Sets the Moon Phase, from new moon to full moon and back
    --- @param phase number Ranges from 0-30
    function SetMoonPhase(phase: number): nil
    --- Sets the Moon Glow Intensity
    --- @param glow_intensity number The new Moon Glow Intensity
    function SetMoonGlowIntensity(glow_intensity: number): nil
    --- Sets the Moon Light Intensity
    --- @param intensity number The new Moon Light Intensity
    function SetMoonLightIntensity(intensity: number): nil
    --- Sets the Sun Angle
    --- @param yaw number Yaw angle, in degrees
    --- @param pitch number Pitch angle, in degrees
    function SetSunAngle(yaw: number, pitch: number): nil
    --- Sets the Sun Scale
    --- @param radius number The new Sun Scale
    function SetSunScale(radius: number): nil
    --- Sets the Sun Light Intensity
    --- @param intensity number The new Sun Light Intensity
    function SetSunLightIntensity(intensity: number): nil
    --- Sets the Sky Mode
    --- @param sky_mode SkyMode The new Sky Mode
    function SetSkyMode(sky_mode: SkyMode): nil
    --- Sets the Volumetric Cloud Color
    --- @param color Color The new Volumetric Cloud Color
    function SetVolumetricCloudColor(color: Color): nil
    --- The amount of coverage for the cloud layer, from a clear sky to overcast
    --- @param cloud_coverage number From 0 (clear sky) to 10 (overcast)
    function SetCloudCoverage(cloud_coverage: number): nil
    --- The fogginess of the scene. The impact this has on fog density is scaled from the Fog Density category
    --- @param fog_percentage number Fog amount, from 0 to 100
    function SetFog(fog_percentage: number): nil
    --- A simple contrast boost for the sky material. Cannot affect volumetric clouds
    --- @param contrast number Contrast multiplier of the sky
    function SetContrast(contrast: number): nil
    --- The overall brightness of the shader
    --- @param intensity number Brightness multiplier of the sky
    function SetOverallIntensity(intensity: number): nil
    --- Can be used to scale the brightness of the sky and lighting, at night
    --- @param brightness number Brightness multiplier at night
    function SetNightBrightness(brightness: number): nil
    --- Sets whether or not to animate the time of day
    --- @param animate boolean Whether or not to animate the time of day
    --- @param day_length number? The time (in minutes) from sunrise to sunset
    --- @param night_length number? The time (in minutes) from sunset to sunrise
    function SetAnimateTimeOfDay(animate: boolean, day_length: number?, night_length: number?): nil
    --- Sets the current time
    --- @param hours number Hour of the day (0-23)
    --- @param minutes number Minutes (0-59)
    --- @param transition_time number? Seconds to smoothly transition to the new time, 0 to change immediately
    function SetTimeOfDay(hours: number, minutes: number, transition_time: number?): nil
    --- Gets the current time
    --- @return number Hour of the day (0-23)
    --- @return number Minutes (0-59)
    --- @return number Seconds (0-59)
    function GetTimeOfDay(): (number, number, number)
    --- Returns if the Ultra Dynamic Sky was spawned
    --- @param including_weather boolean if to check for Weather Actor too
    --- @return boolean Whether the Ultra Dynamic Sky was spawned
    function IsSpawned(including_weather: boolean): boolean
    --- Gets the current weather
    --- @return WeatherType Current weather
    function GetWeather(): WeatherType
    --- Changes the Weather
    --- @param weather WeatherType weather to change
    --- @param transition_time number fade time to completely change to new weather
    function ChangeWeather(weather: WeatherType, transition_time: number): nil
end
@side(client)
declare Sky: Sky__Static

--- Interact with Steam APIs.
@side(client)
declare interface Steam__Static
    --- Sets Steam Rich Presence text
    --- @param text string The new Steam Rich Presence text
    function SetRichPresence(text: string): nil
    --- Triggers a Steam screenshot
    function TriggerScreenshot(): nil
end
@side(client)
declare Steam: Steam__Static

--- Execute code at specified time intervals.
@side(shared)
declare interface Timer__Static
    --- Executes a function, after waiting a specified number of milliseconds
    --- @param callback any The callback that will be executed
    --- @param milliseconds number The time in milliseconds to wait before executing the function
    --- @param ... any Additional parameters to pass to the function
    --- @return number the timeout_id
    function SetTimeout(callback: any, milliseconds: number?, ...: any): number
    --- Same as SetTimeout(), but repeats the execution of the function continuously
    --- @param callback any The callback that will be executed. Return false to stop it from being called.
    --- @param milliseconds number The time in milliseconds the timer should delay in between executions of the specified function
    --- @param ... any Additional parameters to pass to the function
    --- @return number the interval_id
    function SetInterval(callback: any, milliseconds: number?, ...: any): number
    --- Stops the execution of the function specified in SetTimeout()
    --- @param timeout_id number The ID value returned by SetTimeout() is used as the parameter for this method
    function ClearTimeout(timeout_id: number): nil
    --- Stops the execution of the function specified in SetInterval()
    --- @param interval_id number The ID value returned by SetInterval() is used as the parameter for this method
    function ClearInterval(interval_id: number): nil
    --- Binds a Timer to any Actor. The timer will be automatically cleared when the Actor is destroyed
    --- @param timer_id number The Timer ID
    --- @param actor Actor Actor to be bound
    function Bind(timer_id: number, actor: Actor): nil
    --- Checks if a Timer is currently active or waiting to be triggered
    --- @param timer_id number The Timer ID
    --- @return boolean Whether a Timer is currently active or waiting to be triggered
    function IsValid(timer_id: number): boolean
    --- Returns the time elapsed since the last tick
    --- @param timer_id number The Timer ID
    --- @return number Time elapsed since the last tick
    function GetElapsedTime(timer_id: number): number
    --- Returns the time remaining to the next tick
    --- @param timer_id number The Timer ID
    --- @return number Time remaining to the next tick
    function GetRemainingTime(timer_id: number): number
    --- Sets the time remaining to the next tick
    --- @param timer_id number The Timer ID
    --- @param time number The time remaining in milliseconds
    function SetRemainingTime(timer_id: number, time: number): nil
    --- Pauses the Timer
    --- @param timer_id number The Timer ID
    function Pause(timer_id: number): nil
    --- Resumes the Timer
    --- @param timer_id number The Timer ID
    function Resume(timer_id: number): nil
    --- Resets a Timer to restart from beginning
    --- @param timer_id number The Timer ID
    function ResetElapsedTime(timer_id: number): nil
end
@side(shared)
declare Timer: Timer__Static

--- Trace a ray against the world and get collided objects information.
@side(client)
declare interface Trace__Static
    --- Trace a ray against the world and returns a table with the first blocking hit information
    --- @param start_location Vector Start location of the ray
    --- @param end_location Vector End location of the ray
    --- @param collision_channel CollisionChannel | number Supports several channels separating by `|` (using bit-wise operations)
    --- @param trace_mode TraceMode | number Trace Mode, pass all parameters separating by `|` (using bit-wise operations) You need to explicitly pass the modes to return the values you want
    --- @param ignored_actors Actor[] Array of actors to ignore during the trace
    --- @return any Table with the hit information
    function LineSingle(start_location: Vector, end_location: Vector, collision_channel: CollisionChannel | number?, trace_mode: TraceMode | number?, ignored_actors: Actor[]?): any
    --- Trace a ray against the world using object types and return overlapping hits and then first blocking hit
    --- @param start_location Vector Start location of the ray
    --- @param end_location Vector End location of the ray
    --- @param collision_channel CollisionChannel | number Supports several channels separating by `|` (using bit-wise operations)
    --- @param trace_mode TraceMode | number Trace Mode, pass all parameters separating by `|` (using bit-wise operations) You need to explicitly pass the modes to return the values you want
    --- @param ignored_actors Actor[] Array of actors to ignore during the trace
    --- @return any[] List of tables with the hit information of each hit
    function LineMulti(start_location: Vector, end_location: Vector, collision_channel: CollisionChannel | number?, trace_mode: TraceMode | number?, ignored_actors: Actor[]?): any[]
    --- Trace a sphere against the world and returns a table with the first blocking hit information
    --- @param start_location Vector Start location of the sphere
    --- @param end_location Vector End location of the sphere
    --- @param radius number Radius of the sphere
    --- @param collision_channel CollisionChannel | number Supports several channels separating by `|` (using bit-wise operations)
    --- @param trace_mode TraceMode | number Trace Mode, pass all parameters separating by `|` (using bit-wise operations) You need to explicitly pass the modes to return the values you want
    --- @param ignored_actors Actor[] Array of actors to ignore during the trace
    --- @return any Table with the hit information
    function SphereSingle(start_location: Vector, end_location: Vector, radius: number, collision_channel: CollisionChannel | number?, trace_mode: TraceMode | number?, ignored_actors: Actor[]?): any
    --- Trace a sphere against the world using object types and return overlapping hits and then first blocking hit
    --- @param start_location Vector Start location of the sphere
    --- @param end_location Vector End location of the sphere
    --- @param radius number Radius of the sphere
    --- @param collision_channel CollisionChannel | number Supports several channels separating by `|` (using bit-wise operations)
    --- @param trace_mode TraceMode | number Trace Mode, pass all parameters separating by `|` (using bit-wise operations) You need to explicitly pass the modes to return the values you want
    --- @param ignored_actors Actor[] Array of actors to ignore during the trace
    --- @return any[] List of tables with the hit information of each hit
    function SphereMulti(start_location: Vector, end_location: Vector, radius: number, collision_channel: CollisionChannel | number?, trace_mode: TraceMode | number?, ignored_actors: Actor[]?): any[]
    --- Trace a box against the world and returns a table with the first blocking hit information
    --- @param start_location Vector Start location of the box
    --- @param end_location Vector End location of the box
    --- @param half_size Vector Distance from the center of box along each axis
    --- @param orientation Rotator Orientation of the box
    --- @param collision_channel CollisionChannel | number Supports several channels separating by `|` (using bit-wise operations)
    --- @param trace_mode TraceMode | number Trace Mode, pass all parameters separating by `|` (using bit-wise operations) You need to explicitly pass the modes to return the values you want
    --- @param ignored_actors Actor[] Array of actors to ignore during the trace
    --- @return any Table with the hit information
    function BoxSingle(start_location: Vector, end_location: Vector, half_size: Vector, orientation: Rotator, collision_channel: CollisionChannel | number?, trace_mode: TraceMode | number?, ignored_actors: Actor[]?): any
    --- Trace a box against the world using object types and return overlapping hits and then first blocking hit
    --- @param start_location Vector Start location of the box
    --- @param end_location Vector End location of the box
    --- @param half_size Vector Distance from the center of box along each axis
    --- @param orientation Rotator Orientation of the box
    --- @param collision_channel CollisionChannel | number Supports several channels separating by `|` (using bit-wise operations)
    --- @param trace_mode TraceMode | number Trace Mode, pass all parameters separating by `|` (using bit-wise operations) You need to explicitly pass the modes to return the values you want
    --- @param ignored_actors Actor[] Array of actors to ignore during the trace
    --- @return any[] List of tables with the hit information of each hit
    function BoxMulti(start_location: Vector, end_location: Vector, half_size: Vector, orientation: Rotator, collision_channel: CollisionChannel | number?, trace_mode: TraceMode | number?, ignored_actors: Actor[]?): any[]
    --- Trace a capsule against the world and returns a table with the first blocking hit information
    --- @param start_location Vector Start location of the capsule
    --- @param end_location Vector End location of the capsule
    --- @param radius number Radius of the capsule to sweep
    --- @param half_height number Distance from center of capsule to tip of hemisphere endcap.
    --- @param collision_channel CollisionChannel | number Supports several channels separating by `|` (using bit-wise operations)
    --- @param trace_mode TraceMode | number Trace Mode, pass all parameters separating by `|` (using bit-wise operations) You need to explicitly pass the modes to return the values you want
    --- @param ignored_actors Actor[] Array of actors to ignore during the trace
    --- @return any Table with the hit information
    function CapsuleSingle(start_location: Vector, end_location: Vector, radius: number, half_height: number, collision_channel: CollisionChannel | number?, trace_mode: TraceMode | number?, ignored_actors: Actor[]?): any
    --- Trace a capsule against the world using object types and return overlapping hits and then first blocking hit
    --- @param start_location Vector Start location of the capsule
    --- @param end_location Vector End location of the capsule
    --- @param radius number Radius of the capsule to sweep
    --- @param half_height number Distance from center of capsule to tip of hemisphere endcap.
    --- @param collision_channel CollisionChannel | number Supports several channels separating by `|` (using bit-wise operations)
    --- @param trace_mode TraceMode | number Trace Mode, pass all parameters separating by `|` (using bit-wise operations) You need to explicitly pass the modes to return the values you want
    --- @param ignored_actors Actor[] Array of actors to ignore during the trace
    --- @return any[] List of tables with the hit information of each hit
    function CapsuleMulti(start_location: Vector, end_location: Vector, radius: number, half_height: number, collision_channel: CollisionChannel | number?, trace_mode: TraceMode | number?, ignored_actors: Actor[]?): any[]
end
@side(client)
declare Trace: Trace__Static

--- Work with screen properties and effects.
@side(client)
declare interface Viewport__Static
    --- Transforms a 3D world-space vector into 2D screen coordinates
    --- @param world_position Vector World 3D position
    --- @return Vector2D The screen position, in pixels
    function ProjectWorldToScreen(world_position: Vector): Vector2D
    --- Transforms a 2D screen coordinates into 3D world-space location
    --- @param screen_position Vector2D Screen position
    --- @return any Table with the world `Position` and the `Direction` the screen point looks at
    function DeprojectScreenToWorld(screen_position: Vector2D): any
    --- Loads and sets a hardware cursor in the game from a PNG image
    --- @param cursor_shape CursorType Which cursor shape to replace
    --- @param cursor_path string a PNG image relative to Assets/
    --- @param hotspot Vector2D Click point of the cursor image, in pixels
    function SetHardwareCursor(cursor_shape: CursorType, cursor_path: string, hotspot: Vector2D?): nil
    --- Gets the size of viewport
    --- @return Vector2D The size of viewport
    function GetViewportSize(): Vector2D
    --- Gets the scale of viewport
    --- @return number The scale of viewport
    function GetViewportScale(): number
    --- Sets the mouse position
    --- @param new_position Vector2D The new mouse position
    function SetMousePosition(new_position: Vector2D): nil
    --- Gets the current mouse screen location
    --- @return Vector2D The current mouse screen location
    function GetMousePosition(): Vector2D
    --- Enables/Disables the Crosshair
    --- @param is_enabled boolean Whether to enable the Crosshair
    function SetCrosshairEnabled(is_enabled: boolean): nil
    --- Enables/Disables the Interaction ToolTip
    --- @param is_enabled boolean Whether to enable the Interaction ToolTip
    function SetInteractionToolTipEnabled(is_enabled: boolean): nil
    --- Enables/Disables the Blood Screen effect
    --- @param is_enabled boolean Whether to enable the Blood Screen effect
    function SetBloodScreenEnabled(is_enabled: boolean): nil
    --- Manually sets the Blood Screen intensity
    --- @param intensity number From 0.0 to 1.0
    function SetBloodScreenIntensity(intensity: number): nil
    --- Sets the Branding Bar settings (the bar with 'nanos world - closed alpha ver...')
    --- @param horizontal_alignment WidgetHorizontalAlignment Left, Center and Right supported
    --- @param vertical_alignment WidgetVerticalAlignment Bottom and Top supported
    --- @param is_lean boolean Whether to show less information
    function SetBrandingBarSettings(horizontal_alignment: WidgetHorizontalAlignment, vertical_alignment: WidgetVerticalAlignment, is_lean: boolean?): nil
    --- Subscribes to an Event
    --- @param event_name string Event to subscribe to
    --- @param callback any Callback to run on the event occurring
    --- @return any The function callback
    function Subscribe(event_name: string, callback: any): any
    --- Unsubscribes from all subscribed Events in this Class and in this Package, optionally passing the function to unsubscribe only that callback
    --- @param event_name string Event to unsubscribe to
    --- @param callback any Optional callback to specifically unsubscribe to
    function Unsubscribe(event_name: string, callback: any?): nil
end
@side(client)
declare Viewport: Viewport__Static
