end

-- Players are Entities that represents the individual behind the mouse and keyboard. Players are spawned automatically when connected to the server.
declare class Player extends Entity
    -- Bans the player from the server
    @side(server)
    function Ban(reason: string): nil
    -- Redirects the player to another server
    @side(server)
    function Connect(ip: string, password: string?): nil
    -- Kicks the player from the server
    @side(server)
    function Kick(reason: string): nil
    -- Makes this Player possess and control a Pawn (Character)
    @side(server)
    function Possess(new_pawn: Pawn, blend_time: number?, exp: number?): nil
    -- Does a camera fade to/from a solid color
    @side(shared)
    function StartCameraFade(from_alpha: number, to_alpha: number, duration: number, to_color: Color, should_fade_audio: boolean?, hold_when_finished: boolean?): nil
    -- Turns on camera fading at the given opacity
    @side(shared)
    function SetManualCameraFade(in_fade_amount: number, color: Color, in_fade_audio: boolean): nil
    -- Stops camera fading.
    @side(shared)
    function StopCameraFade(): nil
    -- Sets the Player's Camera Location (only works if not possessing any Character)
    @side(shared)
    function SetCameraLocation(location: Vector): nil
    -- Sets the Player's Camera Rotation
    @side(shared)
    function SetCameraRotation(rotation: Rotator): nil
    -- Smoothly moves the Player's Camera Location (only works if not possessing any Character)
    @side(shared)
    function TranslateCameraTo(location: Vector, time: number, exp: number?): nil
    -- Smoothly moves the Player's Camera Rotation
    @side(shared)
    function RotateCameraTo(rotation: Rotator, time: number, exp: number?): nil
    -- Sets the Player's Camera Socket Offset (Spring Arm Offset)
    @side(shared)
    function SetCameraSocketOffset(socket_offset: Vector): nil
    -- Sets the Player's Camera Arm Length (Spring Arm length)
    @side(shared)
    function SetCameraArmLength(length: number, force: boolean?): nil
    -- Sets the Player's Camera FOV (if not possessing a Character)
    @side(shared)
    function SetCameraFOV(fov: number?): nil
    -- Sets the Player's Camera Speed Settings (if not possessing a Character)
    @side(shared)
    function SetCameraSpeedSettings(max_speed: number?, acceleration: number?, deceleration: number?, turning_boost: number?): nil
    -- Attaches the Player's Camera to an Actor
    @side(shared)
    function AttachCameraTo(actor: Actor, socket_offset: Vector?, blend_speed: number?): nil
    -- Resets the Camera to default state (Unspectate and Detaches)
    @side(shared)
    function ResetCamera(): nil
    -- Makes this Player spectate another Player
    @side(shared)
    function Spectate(player: Player, blend_speed: number?): nil
    -- Sets the player's name
    @side(server)
    function SetName(player_name: string): nil
    -- Sets the VOIP setting for a specific global channel
    @side(server)
    function SetVOIPGlobalChannelSetting(channel: number, setting: VOIPSetting): nil
    -- Sets the VOIP setting for all global channels
    @side(server)
    function SetVOIPGlobalAllChannelsSetting(setting: VOIPSetting): nil
    -- Sets the VOIP setting for the local/proximity
    @side(server)
    function SetVOIPLocalSetting(setting: VOIPSetting): nil
    -- Sets the local/proximity VOIP max distance. This also affects networking usage
    @side(shared)
    function SetVOIPLocalMaxDistance(max_distance: number): nil
    -- Sets the local/proximity VOIP input/output volume. It only affects the local/proximity channel
    @side(shared)
    function SetVOIPLocalVolume(volume: number): nil
    -- Sets the global VOIP volume. It only affects the global channels
    @side(shared)
    function SetVOIPGlobalVolume(volume: number): nil
    -- Sets the global VOIP high-pass filter threshold frequency
    @side(shared)
    function SetVOIPGlobalHighPassFilter(threshold: number): nil
    -- Sets the global VOIP low-pass filter threshold frequency
    @side(shared)
    function SetVOIPGlobalLowPassFilter(threshold: number): nil
    -- Mutes or unmutes VOIP for this player
    @side(shared)
    function SetVOIPMuted(is_muted: boolean): nil
    -- Returns whether VOIP is muted for this player
    @side(shared)
    function IsVOIPMuted(): boolean
    -- Release the Player from the Character
    @side(server)
    function UnPossess(): nil
    -- Gets the Player's Steam ID
    @side(shared)
    function GetSteamID(): string
    -- Gets the Player's nanos world account ID
    @side(shared)
    function GetAccountID(): string
    -- Gets the Player's nanos world account name
    @side(shared)
    function GetAccountName(): string
    -- Return a URL which can be used through WebUI and Widgets to display the Player's Steam Avatar (64x64)
    @side(shared)
    function GetAccountIconURL(): string
    -- Gets the location of the Player's camera
    @side(client)
    function GetCameraLocation(): Vector
    -- Gets the Player's camera arm (spring arm) length
    @side(client)
    function GetCameraArmLength(return_base: boolean?): number
    -- Gets the rotation of the Player's camera
    @side(client)
    function GetCameraRotation(): Rotator
    -- Gets the Pawn (Character) this Player is currently possessing
    @side(shared)
    function GetControlledCharacter(): Pawn?
    -- Gets the Player's IP address
    @side(server)
    function GetIP(): string
    -- Gets this Player's dimension
    @side(shared)
    function GetDimension(): number
    -- Sets the multiplier for how much this Player's is affected by distance optimization from other actors
    @side(server)
    function SetDistanceOptimizationMultiplier(multiplier: number): nil
    -- Sets this Player's dimension
    @side(server)
    function SetDimension(dimension: number): nil
    -- Gets the Player's name
    @side(shared)
    function GetName(): string
    -- Gets the Player's ping
    @side(shared)
    function GetPing(): number
    -- Returns a list of VOIP channels this player is listening to
    @side(shared)
    function GetVOIPListeningChannels(): number[]
    -- Returns a list of VOIP channels this player is currently speaking to
    @side(shared)
    function GetVOIPSpeakingChannels(): number[]
    -- Gets if this Player is the host of a P2P (listen) server
    @side(client)
    function IsHost(): boolean
    -- Gets if this Player is the local Player (the one running this client)
    @side(client)
    function IsLocalPlayer(): boolean
    -- Retrieves a player by their Steam ID
    @side(server)
    static function GetBySteamID(steam_id: string): Player?
end

-- A Prop represents a Dynamic Mesh which can be spawned in the world, can be grabbed around by characters and have physics.
@overrideCtor("$class($args)")
declare class Prop extends Entity implements Actor, Paintable
    constructor(location: Vector, rotation: Rotator, asset: string, collision_type: CollisionType?, gravity_enabled: boolean?, grab_mode: GrabMode?, ccd_mode: CCDMode?, spawn_mode: SpawnMode?)
    -- Sets ability to Characters to Grab this Prop
    @side(server)
    function SetGrabMode(grab_mode: GrabMode): nil
    -- Sets the interaction tooltip text shown when a Character interacts with this Prop
    @side(client)
    function SetInteractionToolTipText(tool_tip_text: string): nil
    -- Sets the Physics damping of this Prop
    function SetPhysicsDamping(linear_damping: number, angular_damping: number): nil
    -- Changes the mesh in runtime
    function SetMesh(asset: string): nil
    -- Gets the Asset name
    @side(shared)
    function GetMesh(): string
    -- Gets the Character (if existing) which is holding this
    @side(shared)
    function GetHandler(): Character?
    -- Gets ability to Grab this Prop
    @side(shared)
    function GetGrabMode(): GrabMode
    -- Override the mass (in Kg) of this Prop
    function SetMassOverride(mass: number): nil
    -- Gets the overridden mass
    @side(shared)
    function GetMassOverride(): number
    -- Change the mass scale used to calculate the mass of this Prop
    function SetMassScale(scale: number): nil
    -- Gets the mass scale
    @side(shared)
    function GetMassScale(): number
    -- Sets the Buoyancy Pontoons used by the Water simulation
    function SetBuoyancyPontoons(pontoons: any?): nil
    -- Sets how this entity behaves on Water
    function SetBuoyancySettings(enabled: boolean?, buoyancy_coefficient: number?, buoyancy_damp: number?, max_buoyant_force: number?): nil
end

-- Scene Capture is an Actor which captures a fully dynamic image of the scene into a Texture. It captures the scene from its view frustum, stores that view as an image, which is then used within a Material.
@overrideCtor("$class($args)")
@side(client)
declare class SceneCapture extends Entity implements Actor
    constructor(location: Vector?, rotation: Rotator?, width: number?, height: number?, render_rate: number?, view_distance: number?, fov_angle: number?, enable_distance_optimization: boolean?)
    -- Adds an Actor to the Render Only list
    @side(client)
    function AddRenderActor(actor: Actor): nil
    -- Removes an Actor from the Render Only list
    @side(client)
    function RemoveRenderActor(actor: Actor): nil
    -- Clears the Render Only list
    @side(client)
    function ClearRenderActors(): nil
    -- Stops or resumes capturing
    @side(client)
    function SetFreeze(freeze: boolean): nil
    -- Takes a snapshot of the SceneCapture and returns a Base64 of it
    @side(client)
    function EncodeToBase64(image_format: ImageFormat?): string
    -- Takes a snapshot of the SceneCapture and returns a Base64 of it (asynchronously)
    @side(client)
    function EncodeToBase64Async(image_format: ImageFormat?, callback: any): nil
    -- Sets the FOV
    @side(client)
    function SetFOVAngle(angle: number): nil
    -- Enables/Disables rendering features from being captured
    @side(client)
    function SetShowFlag(flag: string, enable: boolean): nil
    -- Change the output Texture size
    -- Note: too high texture will make the capture slower and will affect game performance
    @side(client)
    function Resize(width: number, height: number): nil
    -- Set how frequent is the capture
    -- Note: Set to 0 to capture every frame, or -1 to disable auto-capturing
    @side(client)
    function SetRenderRate(render_rate: number): nil
    -- Enables or not the rendering frequency optimization if the entities with this Material are too far
    @side(client)
    function SetDistanceOptimizationEnabled(enabled: boolean): nil
    -- Captures the scene. If deferred is true, performs deferred capture and records the frame; otherwise captures immediately and triggers Capture event
    @side(client)
    function CaptureScene(deferred: boolean?): nil
end

-- A StaticMesh entity represents a Mesh which can be spawned in the world, can't move and is more optimized for using in decorating the world.
@overrideCtor("$class($args)")
declare class StaticMesh extends Entity implements Actor, Paintable
    constructor(location: Vector, rotation: Rotator, static_mesh_asset: string, collision_type: CollisionType?, spawn_mode: SpawnMode?)
    -- Changes the mesh in runtime
    function SetMesh(static_mesh_asset: string): nil
    -- Gets the Asset path mesh used
    @side(shared)
    function GetMesh(): string
    -- Gets if this StaticMesh is from the Level
    @side(client)
    function IsFromLevel(): boolean
end

-- Class for playing in-game 2D and 3D sounds.
@overrideCtor("$class($args)")
@side(client)
declare class Sound extends Entity implements Actor
    constructor(location: Vector, asset: string, is_2d_sound: boolean?, auto_destroy: boolean?, sound_type: SoundType?, volume: number?, pitch: number?, inner_radius: number?, falloff_distance: number?, attenuation_function: AttenuationFunction?, keep_playing_when_silent: boolean?, loop_mode: SoundLoopMode?, auto_play: boolean?)
    -- Plays the sound with a fade effect
    @side(client)
    function FadeIn(fade_in_duration: number, fade_volume_level: number?, start_time: number?): nil
    -- Stops the sound with a fade effect
    @side(client)
    function FadeOut(fade_out_duration: number, fade_volume_level: number?, destroy_after_fadeout: boolean?): nil
    -- Starts the sound
    @side(client)
    function Play(start_time: number?): nil
    -- If a 3D Sound, sets the distance which the sound is inaudible
    @side(client)
    function SetFalloffDistance(falloff_distance: number): nil
    -- If a 3D Sound, sets the radius within which the volume is 100%
    @side(client)
    function SetInnerRadius(inner_radius: number): nil
    -- Sets low-pass filter frequency. Sets 0 to disable it.
    @side(client)
    function SetLowPassFilter(frequency: number): nil
    -- Pauses or resumes the sound
    @side(client)
    function SetPaused(pause: boolean?): nil
    -- Sets the Sound's pitch
    @side(client)
    function SetPitch(new_pitch: number): nil
    -- Sets the Sound's volume
    @side(client)
    function SetVolume(new_volume: number): nil
    -- Stops the sound
    @side(client)
    function Stop(): nil
    -- Stops the sound after the provided delay
    @side(client)
    function StopDelayed(delay: number): nil
    -- Gets if the sound is 2D
    @side(client)
    function Is2D(): boolean
    -- Gets if the sound is playing
    @side(client)
    function IsPlaying(): boolean
    -- Gets the duration of the Sound
    @side(client)
    function GetDuration(): number
    -- Gets the pitch multiplier
    @side(client)
    function GetPitch(): number
    -- Gets the volume multiplier
    @side(client)
    function GetVolume(): number
    -- Gets the low pass filter frequency
    @side(client)
    function GetLowPassFilter(): number
    -- Gets the radius within which the volume is 100%
    @side(client)
    function GetInnerRadius(): number
    -- Gets the distance at which the sound becomes inaudible
    @side(client)
    function GetFalloffDistance(): number
    -- Gets the Sound Type, used to apply the user's volume settings
    @side(client)
    function GetSoundType(): SoundType
    -- Gets the asset path of this Sound
    @side(client)
    function GetPath(): string
end

-- A Text Render class is useful for spawning Texts in 3D world.
@overrideCtor("$class($args)")
@side(shared)
declare class TextRender extends Entity implements Actor
    constructor(location: Vector, rotation: Rotator, text: string, word_size: number?, color: Color?, rendering_type: TextRenderRenderingType?, horizontal_alignment: TextRenderHorizontalAlignment?, vertical_alignment: TextRenderVerticalAlignment?, font_asset: string?, cast_shadow: boolean?)
    -- Gets the current Text
    @side(shared)
    function GetText(): string
    -- Gets the current Text Color
    @side(shared)
    function GetColor(): Color
    -- Gets the current Word Size
