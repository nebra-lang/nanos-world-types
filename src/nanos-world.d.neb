-- The Database entity provides programmers a way to access SQL databases easily through scripting.
@overrideCtor("$class($args)")
@side(server)
declare class Database
    constructor(database_engine: DatabaseEngine, connection_string: string, pool_size: number?)
    -- Closes the Database
    @side(server)
    function Close(): nil
    -- Execute a query asynchronously
    @side(server)
    function ExecuteAsync(query: string, callback: any?, ...: any): nil
    -- Executes a query synchronously, blocking until it finishes. Prefer `ExecuteAsync` to avoid freezing the server
    @side(server)
    function Execute(query: string, ...: any): (number, string)
    -- Execute a select query asynchronously
    @side(server)
    function SelectAsync(query: string, callback: any?, ...: any): nil
    -- Runs a SELECT query synchronously, blocking until it finishes. Prefer `SelectAsync` to avoid freezing the server
    @side(server)
    function Select(query: string, ...: any): (any[], string)
end

-- Decals are Materials that are projected onto meshes in your level, including Static Meshes and Skeletal Meshes.
