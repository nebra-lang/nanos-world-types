--- How an Actor transform is handled when attaching it to another Actor
declare enum AttachmentRule
    --- Will keep the current relative position/rotation if already attached.
    KeepRelative
    --- Will calculate the new relative position/rotation so the Actor stays at the same position after being attached.
    KeepWorld
    --- Will set the Actor to the same position/rotation as the parent actor (or at the bone location) and reset its relative position/rotation to zero.
    SnapToTarget
end

--- How a 3D Sound volume fades with distance
declare enum AttenuationFunction
    --- Fades evenly with distance
    Linear
    --- Fades quickly when close and slowly when far
    Logarithmic
    --- Fades very quickly near the source
    Inverse
    --- Fades slowly when close and quickly when far
    LogReverse
    --- Physically based falloff, the most realistic
    NaturalSound
end

--- How a drawing blends with what is already drawn
declare enum BlendMode
    --- Fully replaces the pixels, ignoring alpha
    Opaque
    --- Pixels are either fully visible or fully hidden
    Masked
    --- Blends using the alpha
    Translucent
    --- Adds its color to the existing pixels
    Additive
    --- Multiplies its color with the existing pixels
    Modulate
    MaskedDistanceField
    MaskedDistanceFieldShadowed
    TranslucentDistanceField
    TranslucentDistanceFieldShadowed
    AlphaComposite
    AlphaHoldout
    --- Standard alpha blending, recommended for images with transparency
    AlphaBlend
    TranslucentAlphaOnly
    TranslucentAlphaOnlyWriteAlpha
end

