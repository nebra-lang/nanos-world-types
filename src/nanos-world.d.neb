    function SetCastShadows(is_shadows_enabled: boolean): nil
    -- Sets the brightness of this Light
    @side(shared)
    function SetIntensity(intensity: number): nil
    -- Sets the distance this Light reaches
    @side(shared)
    function SetAttenuationRadius(attenuation_radius: number): nil
    -- Gets if this Light casts shadows
    @side(shared)
    function GetCastShadows(): boolean
    -- Gets the brightness of this Light
    @side(shared)
    function GetIntensity(): number
    -- Gets the distance this Light reaches
    @side(shared)
    function GetAttenuationRadius(): number
    -- Gets the color of this Light
    @side(shared)
    function GetColor(): Color
end

-- A Melee represents an Entity which can be Pickable by a Character and can be used to melee attack, Characters can hold it with hands with pre-defined handling modes.
@overrideCtor("$class($args)")
declare class Melee extends Entity implements Actor, Paintable, Pickable
    constructor(location: Vector, rotation: Rotator, asset: string, collision_type: CollisionType?, gravity_enabled: boolean?, handling_mode: HandlingMode?, crosshair_material: string?, can_use: boolean?, spawn_mode: SpawnMode?)
    -- Sets an Animation when attacking
    @side(server)
    function AddAnimationCharacterUse(asset_path: string, play_rate: number?, slot_type: AnimationSlotType?): nil
    -- Clears the Character Attack Animation list
    @side(server)
    function ClearAnimationsCharacterUse(): nil
    -- Sets the Sound when hitting something
    @side(shared)
    function SetImpactSound(surface_type: SurfaceType, asset_path: string, volume: number?, pitch: number?): nil
    -- Sets the Sound when attacking
    @side(shared)
    function SetSoundUse(asset_path: string): nil
    -- Sets the Base Damage
    @side(server)
    function SetBaseDamage(damage: number): nil
    -- Sets the times when to start applying damage and when to end
    @side(server)
    function SetDamageSettings(damage_start_time: number, damage_duration_time: number): nil
    -- Sets the cooldown between attacking
    @side(shared)
    function SetCooldown(cooldown: number): nil
    -- Gets the Animations when Character uses it
    @side(shared)
    function GetAnimationsCharacterUse(): string[]
    -- Gets the Sound when Character uses it
    @side(shared)
    function GetSoundUse(): string
    -- Gets the Base Damage
    @side(shared)
    function GetBaseDamage(): number
    -- Gets the Cooldown between usages
    @side(shared)
    function GetCooldown(): number
end

-- Class to spawn Particle Systems used to create effects in the world.
@overrideCtor("$class($args)")
declare class Particle extends Entity implements Actor
    constructor(location: Vector, rotation: Rotator, asset: string, auto_destroy: boolean?, auto_activate: boolean?, spawn_mode: SpawnMode?)
    -- Activates the Emitter
